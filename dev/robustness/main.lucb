## The heavy robustness sweep (KERNEL-ROBUSTNESS.md, stage 7): random and
## near-degenerate booleans of boxes, cylinders, spheres and rounded boxes
## (cases.lucb), each checked for success, validity, a watertight mesh,
## volume identities, invariance under a move and determinism (checks.lucb);
## a failing case is shrunk and printed as a regression (shrink.lucb). Run
## on demand, not by luc test:
##     luce-base build dev/robustness --native -o build/sweep
##     build/sweep [COUNT [SEED [FIRST]]]
## COUNT cases (default 100) of seed SEED (default 1) from case FIRST.

pub func main(arguments: str[]) -> i32!:
    let count = (strings.parse_u64(arguments[1]) else 100) if arguments.length > 1 else 100
    let seed = (strings.parse_u64(arguments[2]) else 1) if arguments.length > 2 else 1
    let first = (strings.parse_u64(arguments[3]) else 0) if arguments.length > 3 else 0
    var failures: u64[7] = [0, 0, 0, 0, 0, 0, 0]
    var buffer: u8[1024]
    var kept: u8[1024]
    for index in first..<first + count:
        var c = make_case(seed, index)
        let verdict = check_case(c, buffer[..<1024]) catch failure:
            print(f"case {index}: the check itself failed: {failure.message}")
            continue
        if verdict.check == check_count: continue
        failures[(usize)verdict.check] += 1
        let detail = strings.copy_into(kept[..<1024], verdict.detail)
        print(f"case {index} (seed {seed}): {check_name(verdict.check)}, operation {verdict.operation}: {detail}")
        if verdict.check == check_refused: continue
        c.operation = verdict.operation
        let small = shrink(c, verdict.check, buffer[..<1024]) catch failure:
            print(f"  shrinking failed: {failure.message}")
            continue
        print_regression(small, verdict.check)
    print(f"sweep of {count} cases, seed {seed}:")
    for check in 0..<check_count:
        print(f"  {check_name(check)}: {failures[(usize)check]}")
    return 0
