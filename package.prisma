#prisma 4.0
def package "luce-cad" {
    str owner = "dymokomi"
    str version = "0.4.4"
    str kind = "package"
    str language = "luce-base"
    str readme = "README.md"
    str description = "Format-independent analytic CAD surface and face model, with rational B-spline evaluation and trimmed-surface tessellation."
    def export "cad" {
        str module = "luce_cad.model"
    }
    def export "cad_geometry" {
        str module = "luce_cad.cad_geometry"
    }
    def export "cad_edits" {
        str module = "luce_cad.cad_edits"
    }
    def export "cad_solids" {
        str module = "luce_cad.solids"
    }
    def export "tessellation" {
        str module = "luce_cad.tessellation.surface"
    }
    def export "cad_exact" {
        str module = "luce_cad.exact"
    }
    def dependency "luce-geocore" {
        str owner = "dymokomi"
        str version = "^0.2.3"
        str path = "../luce-geocore"
    }
    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-std"
    }
}
