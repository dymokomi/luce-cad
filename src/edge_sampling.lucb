## Geometric edge counts and guarded physical-spacing selection.
from luce_std import math
import memory
from luce_geocore.geocore import Vector3
from brep_types import Curve, BrepFace
from curve_spacing import ArcMetric
from patch_sides import edge_index
from layout_cell_error import turn_sag

## A four-coedge band's opposite repeated seam does not transport its interval
## family into a neighboring chart. Irregular trims and externally shared edges
## still need a global phase/quality decision before changing that family.
## Returns an owned heap mask; the caller releases it after choosing counts.
pub func compact_seams(faces: const BrepFace[], edge_count: usize) -> bool[]!:
    let result = try new bool[edge_count] --- in memory.heap
    errdefer free(result) in memory.heap
    let owners = try new i64[edge_count] --- in memory.heap
    defer free(owners) in memory.heap
    let uses = try new usize[edge_count] --- in memory.heap
    defer free(uses) in memory.heap
    for edge in 0..<edge_count:
        owners[edge] = -1
        uses[edge] = 0
    for face in 0..<faces.length:
        for use in faces[face].uses:
            let edge = edge_index(use)
            if owners[edge] == -1: owners[edge] = (i64)face
            elif owners[edge] != (i64)face: owners[edge] = -2
            uses[edge] += 1
    for edge in 0..<edge_count:
        result[edge] = false
        if owners[edge] < 0 or uses[edge] != 2: continue
        let face = faces[(usize)owners[edge]]
        if face.sizes.length != 1 or face.uses.length != 4: continue
        for at in 0..<(usize)4:
            if edge_index(face.uses[at]) == edge and face.uses[(at + 2) % 4] == -face.uses[at]: result[edge] = true
    return result

## Reduce straight/simple spline sampling within the requested quality budget.
## This sampled criterion is not a certified deflection bound. Complex/C0 edges
## retain the full divisions*4 budget; opposite-side agreement may increase it.
pub func curve_intervals(edge: Curve, divisions: i64, tolerance: f64, metric: ArcMetric*, compact: bool = false) -> usize!:
    if edge.kind == 0: return 1
    if edge.kind == 1:
        return (usize)math.max(2.0, math.ceil((f64)(divisions * 4) * math.abs(edge.sweep) / (2.0 * math.pi) - 0.000000001))
    var length: f64 = 0.0
    var previous = try edge.at(0.0)
    for at in 1..<33:
        let p = try edge.at((f64)at / 32.0)
        length += p.subtract(previous).length()
        previous = p
    let chord = math.max(tolerance, length / ((f64)divisions * (f64)divisions * 16.0))
    let cosine = math.cos(0.75 * 2.0 * math.pi / (4.0 * (f64)divisions))
    # An interval may also sag as an arc turning a quarter turn's
    # 1/divisions does (as arcs are sampled), so a short curve is no finer
    # than an arc of its curvature.
    let sag = turn_sag(divisions)
    var count: usize = 1
    var lower: usize = 0
    # A B-spline: at least an interval per knot span, so five probes never
    # alias across many polynomial pieces (the sag allowance trusts the
    # turn the probes see).
    if edge.kind == 2:
        let least = math.min((f64)knot_spans(edge.knots, edge.degree), (f64)(divisions * 4))
        while (f64)count < least: count *= 2
        if count > (usize)(divisions * 4): count = (usize)(divisions * 4)
        lower = (usize)math.max(0.0, least - 1.0)
        if lower >= count: lower = count - 1
    while true:
        if try acceptable(edge, metric, count, chord, cosine, tolerance, sag):
            if not compact: return count
            # Doubling brackets a passing density; it does not mean the upper
            # power of two is required. Keep a passing upper bound while
            # searching that bracket. Each returned count is checked in its own
            # sample phase; no monotonicity or certified global minimum is claimed.
            while count > lower + 1:
                let middle = (lower + count) // 2
                if try acceptable(edge, metric, middle, chord, cosine, tolerance, sag): count = middle
                else: lower = middle
            return count
        # Sharp knots cannot meet an angular target under uniform refinement.
        # Never turn the heuristic into a new import failure or runaway budget.
        if count >= (usize)(divisions * 4):
            if metric.uniform:
                metric.uniform = false
                let parameter_count = try curve_intervals(edge, divisions, tolerance, metric, compact)
                # C0 knots can prevent either distribution from satisfying the
                # angular target at the cap. Prefer even spacing only when its
                # sampled chord error and turn are no worse than the retained
                # parameter grid; do not reject it solely for the same kink.
                if parameter_count == count:
                    let original = try measure_error(edge, metric, count, tolerance)
                    metric.uniform = true
                    let even = try measure_error(edge, metric, count, tolerance)
                    metric.uniform = even.x <= original.x + 1e-12 and even.y <= original.y + 1e-8
                return parameter_count
            return count
        lower = count
        count = (usize)math.min((f64)(count * 2), (f64)(divisions * 4))

## How many knot spans of nonzero length a B-spline's domain has.
func knot_spans(knots: const f64[], degree: i64) -> usize:
    var spans: usize = 0
    let last = knots.length - (usize)degree - 1
    for at in (usize)degree..<last:
        if knots[at + 1] > knots[at]: spans += 1
    return spans

func acceptable(edge: Curve, metric: ArcMetric*, count: usize, chord: f64, cosine: f64, tolerance: f64, sag: f64) -> bool!:
    for interval in 0..<count:
        var p = [Vector3(), Vector3(), Vector3(), Vector3(), Vector3()]
        let ta = metric.station((f64)interval / (f64)count)
        let tb = metric.station((f64)(interval + 1) / (f64)count)
        for at in 0..<(usize)5: p[at] = try edge.at(ta + (tb - ta) * (f64)at / 4.0)
        let span = p[4].subtract(p[0])
        for at in 1..<(usize)4:
            let t = math.clamp(p[at].subtract(p[0]).dot(span) / span.dot(span), 0.0, 1.0) if span.dot(span) > 1e-30 else 0.0
            if p[at].subtract(p[0].add(span.multiply_scalar(t))).length() > math.max(chord, span.length() * sag): return false
        for a in 0..<(usize)4:
            for b in a + 1..<(usize)4:
                let da = p[a + 1].subtract(p[a])
                let db = p[b + 1].subtract(p[b])
                if da.length() > tolerance * 0.001 and db.length() > tolerance * 0.001 and da.dot(db) < cosine * da.length() * db.length(): return false
    return true

func measure_error(edge: Curve, metric: ArcMetric*, count: usize, tolerance: f64) -> Vector3!:
    var result = Vector3()
    for interval in 0..<count:
        var p = [Vector3(), Vector3(), Vector3(), Vector3(), Vector3()]
        let a = metric.station((f64)interval / (f64)count)
        let b = metric.station((f64)(interval + 1) / (f64)count)
        for at in 0..<(usize)5: p[at] = try edge.at(a + (b - a) * (f64)at / 4.0)
        let span = p[4].subtract(p[0])
        for at in 1..<(usize)4:
            let t = math.clamp(p[at].subtract(p[0]).dot(span) / span.dot(span), 0.0, 1.0) if span.dot(span) > 1e-30 else 0.0
            result.x = math.max(result.x, p[at].subtract(p[0].add(span.multiply_scalar(t))).length())
        for first in 0..<(usize)4:
            for second in first + 1..<(usize)4:
                let da = p[first + 1].subtract(p[first])
                let db = p[second + 1].subtract(p[second])
                if da.length() > tolerance * 0.001 and db.length() > tolerance * 0.001:
                    result.y = math.max(result.y, 1.0 - da.dot(db) / (da.length() * db.length()))
    return result
