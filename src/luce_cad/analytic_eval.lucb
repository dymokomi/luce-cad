## Exact analytic support evaluation shared by trimming and deviation checks.
import math
from three import Vector3
from luce_cad.brep_types import Surface

## Native angular U/V for spheres/tori, angular U and axial V for cylinders/cones.
## The caller validates the surface kind and parameter domain.
pub func evaluate(s: Surface, u: f64, v: f64) -> Vector3:
    let radial = s.x.multiply_scalar(math.cos(u)).add(s.y.multiply_scalar(math.sin(u)))
    if s.kind == 4:
        return s.origin.add(radial.multiply_scalar(s.radius*math.cos(v))).add(s.z.multiply_scalar(s.radius*math.sin(v)))
    if s.kind == 5:
        return s.origin.add(radial.multiply_scalar(s.radius+s.angle*math.cos(v))).add(s.z.multiply_scalar(s.angle*math.sin(v)))
    return s.origin.add(radial.multiply_scalar(s.radius+v*math.tan(s.angle) if s.kind == 2 else s.radius)).add(s.z.multiply_scalar(v))
