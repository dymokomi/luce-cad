## B-rep ownership and validation. Edge IDs are shared across incident faces.
import interop
import memory
import math
from geocore import Vector3, Matrix4, Mesh, MeshOps, invalid
from luce_cad.tessellation.surface import NurbsSurface, NurbsCurve
from luce_cad.brep_types import Curve, Surface, BrepFace
from luce_cad.brep_mesh import tessellate
from luce_cad.face_mesh import face_mesh
from luce_cad.curve_trim import parameter

pub struct BrepModel:
    let vertices: Vector3[]
    let edges: Curve[]
    let surfaces: Surface[]
    let faces: BrepFace[]
    let tolerance: f64
    var nv: usize
    var ne: usize
    var ns: usize
    var nf: usize

    pub func init(tolerance: f64 = 0.000001) -> !:
        if not math.is_finite(tolerance) or tolerance < 0.000000001 or tolerance > 1.0:
            error(invalid, "CAD tolerance must be finite and between 1e-9 and 1 source unit")
        self.tolerance = tolerance
        let v = try alloc Vector3[32768] in memory.heap
        errdefer free(v) in memory.heap
        let e = try alloc Curve[32768] in memory.heap
        errdefer free(e) in memory.heap
        let s = try alloc Surface[8192] in memory.heap
        errdefer free(s) in memory.heap
        let f = try alloc BrepFace[8192] in memory.heap
        self.vertices = v
        self.edges = e
        self.surfaces = s
        self.faces = f
        self.nv = 0
        self.ne = 0
        self.ns = 0
        self.nf = 0

    pub func face_count() -> i64:
        return (i64)self.nf
    pub func edge_count() -> i64:
        return (i64)self.ne

    ## Support type: plane=0, cylinder=1, cone=2, NURBS=3, sphere=4, torus=5.
    pub func face_surface_kind(face: i64) -> i64!:
        if face < 0 or (usize)face >= self.nf:
            error(invalid, "CAD face index out of range")
        return self.surfaces[(usize)self.faces[(usize)face].surface].kind

    ## A format-independent object path attached to an analytic face.
    pub func face_path(face: i64) -> str!:
        if face < 0 or (usize)face >= self.nf:
            error(invalid, "CAD face index out of range")
        return (self.faces[(usize)face].path else interop.Packet[str]("")).value

    pub mutating func set_face_path(face: i64, path: str) -> !:
        discard(try self.face_path(face))
        let copy = try interop.text_transfer.copy(path)
        if let previous = self.faces[(usize)face].path: previous.release()
        self.faces[(usize)face].path = copy

    ## Extract faces with compact shared topology; unrelated points and curves
    ## are not copied into the result. Face paths/colors/placements survive.
    pub func subset(selection: const i64[]) -> interop.Reference[BrepModel]!:
        let output = try interop.Reference[BrepModel].adopt(new BrepModel(self.tolerance) in memory.heap, brep_model_type, memory.heap)
        errdefer output.release()
        let target = output.value()
        let vertices = try alloc i64[self.nv] in memory.heap
        defer free(vertices) in memory.heap
        let edges = try alloc i64[self.ne] in memory.heap
        defer free(edges) in memory.heap
        let surfaces = try alloc i64[self.ns] in memory.heap
        defer free(surfaces) in memory.heap
        for index in 0..<vertices.length: vertices[index] = -1
        for index in 0..<edges.length: edges[index] = -1
        for index in 0..<surfaces.length: surfaces[index] = -1
        for id in selection:
            discard(try self.face_path(id))
            let face = self.faces[(usize)id]
            let uses = try alloc i64[face.uses.length] in memory.heap
            defer free(uses) in memory.heap
            for at in 0..<face.uses.length:
                let use = face.uses[at]
                let index = (usize)(use - 1 if use > 0 else -use - 1)
                if edges[index] < 0:
                    let curve = self.edges[index]
                    for point in [curve.start, curve.end]:
                        if vertices[(usize)point] < 0:
                            vertices[(usize)point] = try target.add_vertex(self.vertices[(usize)point])
                    let copied = try Curve(curve.kind, vertices[(usize)curve.start], vertices[(usize)curve.end], curve.origin, curve.x, curve.y, curve.radius, curve.points, curve.weights, curve.knots, curve.degree, curve.sense, curve.angle, curve.sweep)
                    edges[index] = (i64)target.ne
                    target.edges[target.ne] = copied
                    target.ne += 1
                uses[at] = (edges[index] + 1) * (1 if use > 0 else -1)
            let sid = (usize)face.surface
            if surfaces[sid] < 0:
                let s = self.surfaces[sid]
                target.surfaces[target.ns] = try Surface(s.kind, s.origin, s.x, s.z, s.radius, s.angle, s.points, s.weights, s.ku, s.kv, s.nu, s.nv, s.du, s.dv)
                surfaces[sid] = (i64)target.ns
                target.ns += 1
            let copied = try target.add_face(surfaces[sid], uses, face.sizes, face.sense)
            target.faces[(usize)copied].placement = face.placement
            target.faces[(usize)copied].color = face.color
            target.faces[(usize)copied].colored = face.colored
            try target.set_face_path(copied, try self.face_path(id))
        return output

    pub func face_edge_count(face: i64) -> i64!:
        if face < 0 or (usize)face >= self.nf:
            error(invalid, "CAD face index out of range")
        return (i64)self.faces[(usize)face].uses.length

    pub func face_edge_point(face: i64, use_index: i64, fraction: f64) -> Vector3!:
        let count = try self.face_edge_count(face)
        if use_index < 0 or use_index >= count:
            error(invalid, "CAD edge use index out of range")
        let entry = self.faces[(usize)face]
        let use = entry.uses[(usize)use_index]
        let edge = self.edges[(usize)(use - 1 if use > 0 else -use - 1)]
        return entry.placement.transform_point(try edge.at(fraction if use > 0 else 1.0 - fraction))

    pub func face_edge_linear(face: i64, use_index: i64) -> bool!:
        let count = try self.face_edge_count(face)
        if use_index < 0 or use_index >= count:
            error(invalid, "CAD edge use index out of range")
        let use = self.faces[(usize)face].uses[(usize)use_index]
        return self.edges[(usize)(use - 1 if use > 0 else -use - 1)].kind == 0

    pub func face_edge_id(face: i64, use_index: i64) -> i64!:
        let count = try self.face_edge_count(face)
        if use_index < 0 or use_index >= count:
            error(invalid, "CAD edge use index out of range")
        let use = self.faces[(usize)face].uses[(usize)use_index]
        return use - 1 if use > 0 else -use - 1

    pub mutating func set_face_color(face: i64, color: Vector3) -> !:
        if face < 0 or (usize)face >= self.nf or not color.is_finite() or color.x < 0.0 or color.x > 1.0 or color.y < 0.0 or color.y > 1.0 or color.z < 0.0 or color.z > 1.0:
            error(invalid, "invalid CAD face color")
        self.faces[(usize)face].color = color
        self.faces[(usize)face].colored = true

    ## Preserve rigid assembly placement without changing support geometry.
    pub mutating func set_face_placement(face: i64, matrix: Matrix4) -> !:
        if face < 0 or (usize)face >= self.nf or not matrix.is_finite() or math.abs(matrix.determinant() - 1.0) > 0.000001:
            error(invalid, "invalid rigid CAD face placement")
        self.faces[(usize)face].placement = matrix

    pub mutating func add_vertex(point: Vector3) -> i64!:
        if self.nv == self.vertices.length or not point.is_finite():
            error(invalid, "invalid B-rep vertex or vertex budget exceeded")
        let id = self.nv
        self.vertices[id] = point
        self.nv += 1
        return (i64)id

    func check_edge(start: i64, end: i64) -> !:
        if start < 0 or end < 0 or (usize)start >= self.nv or (usize)end >= self.nv or self.ne == self.edges.length:
            error(invalid, "invalid B-rep edge endpoints or edge budget exceeded")

    pub mutating func add_line(start: i64, end: i64) -> i64!:
        try self.check_edge(start, end)
        if start == end:
            error(invalid, "collapsed B-rep line")
        var empty: f64[1]
        self.edges[self.ne] = try Curve(0, start, end, Vector3(), Vector3(), Vector3(), 0.0,
                                       [self.vertices[(usize)start], self.vertices[(usize)end]], empty[..<0], empty[..<0], 0, true)
        self.ne += 1
        return (i64)self.ne - 1

    pub mutating func add_circle(start: i64, end: i64, origin: Vector3, axis: Vector3, reference: Vector3, radius: f64, sense: bool = true) -> i64!:
        try self.check_edge(start, end)
        let z = try axis.normalized()
        let x = try reference.subtract(z.multiply_scalar(reference.dot(z))).normalized()
        let y = z.cross(x)
        if not origin.is_finite() or not math.is_finite(radius) or radius <= 0.0:
            error(invalid, "invalid B-rep circle")
        let a = self.vertices[(usize)start].subtract(origin)
        let b = self.vertices[(usize)end].subtract(origin)
        if math.abs(a.dot(z)) > self.tolerance or math.abs(b.dot(z)) > self.tolerance or math.abs(a.length() - radius) > self.tolerance or math.abs(b.length() - radius) > self.tolerance:
            error(invalid, "circle endpoints are not on the curve")
        let angle = math.atan2(a.dot(y), a.dot(x))
        var sweep = math.atan2(b.dot(y), b.dot(x)) - angle
        if sense:
            while sweep <= 0.000000000001:
                sweep += 6.283185307179586
        else:
            while sweep >= -0.000000000001:
                sweep -= 6.283185307179586
        var empty: f64[1]
        self.edges[self.ne] = try Curve(1, start, end, origin, x, y, radius, self.vertices[..<0], empty[..<0], empty[..<0], 0, sense, angle, sweep)
        self.ne += 1
        return (i64)self.ne - 1

    ## Retain an exact elliptical arc, with angles recovered from its endpoints.
    pub mutating func add_ellipse(start: i64, end: i64, origin: Vector3, axis: Vector3, reference: Vector3, major: f64, minor: f64, sense: bool = true) -> i64!:
        try self.check_edge(start, end)
        if not origin.is_finite() or not math.is_finite(major) or not math.is_finite(minor) or major <= 0.0 or minor <= 0.0:
            error(invalid, "invalid B-rep ellipse")
        let z = try axis.normalized()
        let x = try reference.subtract(z.multiply_scalar(reference.dot(z))).normalized()
        let y = z.cross(x)
        let a = self.vertices[(usize)start].subtract(origin)
        let b = self.vertices[(usize)end].subtract(origin)
        let angle = math.atan2(a.dot(y) / minor, a.dot(x) / major)
        let end_angle = math.atan2(b.dot(y) / minor, b.dot(x) / major)
        if a.subtract(x.multiply_scalar(major * math.cos(angle)).add(y.multiply_scalar(minor * math.sin(angle)))).length() > self.tolerance or b.subtract(x.multiply_scalar(major * math.cos(end_angle)).add(y.multiply_scalar(minor * math.sin(end_angle)))).length() > self.tolerance:
            error(invalid, "ellipse endpoints are not on the curve")
        var sweep = end_angle - angle
        if sense:
            while sweep <= 0.000000000001:
                sweep += 6.283185307179586
        else:
            while sweep >= -0.000000000001:
                sweep -= 6.283185307179586
        var empty: f64[1]
        self.edges[self.ne] = try Curve(3, start, end, origin, x, y, major, self.vertices[..<0], [minor], empty[..<0], 0, sense, angle, sweep)
        self.ne += 1
        return (i64)self.ne - 1

    pub mutating func add_spline_edge(start: i64, end: i64, points: const Vector3[], weights: const f64[], degree: i64, knots: const f64[], sense: bool) -> i64!:
        try self.check_edge(start, end)
        if degree < 1 or (usize)degree >= knots.length or points.length >= knots.length:
            error(invalid, "invalid B-spline edge")
        let low = knots[(usize)degree]
        let high = knots[points.length]
        let a = try parameter(points, weights, degree, knots, self.vertices[(usize)start], low if sense else high, self.tolerance)
        let b = try parameter(points, weights, degree, knots, self.vertices[(usize)end], high if sense else low, self.tolerance)
        var sweep = b - a
        if (sense and sweep <= 0.0) or (not sense and sweep >= 0.0):
            let first = try NurbsCurve.at(points, weights, degree, knots, low)
            let last = try NurbsCurve.at(points, weights, degree, knots, high)
            if first.subtract(last).length() > self.tolerance:
                error(invalid, "B-spline trim orientation contradicts the edge sense")
            sweep += (high - low) * (1.0 if sense else -1.0)
        self.edges[self.ne] = try Curve(2, start, end, Vector3(), Vector3(), Vector3(), 0.0, points, weights, knots, degree, sense, a, sweep)
        self.ne += 1
        return (i64)self.ne - 1

    ## kind 0 plane, 1 cylinder, 2 cone, 4 sphere, 5 torus.
    ## For a torus radius/angle are major/minor radii. Placements stay exact.
    pub mutating func add_surface(kind: i64, origin: Vector3, axis: Vector3, reference: Vector3, radius: f64 = 0.0, angle: f64 = 0.0) -> i64!:
        if kind < 0 or kind == 3 or kind > 5 or self.ns == self.surfaces.length or not origin.is_finite() or not math.is_finite(radius) or not math.is_finite(angle) or (kind > 0 and radius <= 0.0) or (kind == 2 and math.abs(angle) >= 1.5707963267948966) or (kind == 5 and angle <= 0.0):
            error(invalid, "invalid analytic B-rep surface")
        let z = try axis.normalized()
        let x = try reference.subtract(z.multiply_scalar(reference.dot(z))).normalized()
        var empty: f64[1]
        self.surfaces[self.ns] = try Surface(kind, origin, x, z, radius, angle, self.vertices[..<0], empty[..<0], empty[..<0], empty[..<0], 0, 0, 0, 0)
        self.ns += 1
        return (i64)self.ns - 1

    pub mutating func add_spline_surface(points: const Vector3[], weights: const f64[], nu: i64, nv: i64, du: i64, dv: i64, ku: const f64[], kv: const f64[]) -> i64!:
        if self.ns == self.surfaces.length:
            error(invalid, "B-rep surface budget exceeded")
        try NurbsSurface.check(points, weights, nu, nv, du, dv, ku, kv)
        self.surfaces[self.ns] = try Surface(3, Vector3(), Vector3(), Vector3(), 0.0, 0.0, points, weights, ku, kv, nu, nv, du, dv)
        self.ns += 1
        return (i64)self.ns - 1

    ## Signed edge uses: +(edge ID + 1) forward, -(edge ID + 1) reversed.
    ## Outer loop first, holes afterward. Reject disconnected topological loops.
    pub mutating func add_face(surface: i64, uses: const i64[], sizes: const i64[], sense: bool = true) -> i64!:
        if surface < 0 or (usize)surface >= self.ns or self.nf == self.faces.length or sizes.length == 0 or sizes.length > 64 or uses.length > 1024:
            error(invalid, "invalid B-rep face or face budget exceeded")
        for use in uses:
            if use == 0 or use < -(i64)self.ne or use > (i64)self.ne:
                error(invalid, "B-rep face references a missing edge")
        var offset: usize = 0
        for size in sizes:
            if size < 1 or (usize)size > uses.length - offset:
                error(invalid, "invalid B-rep loop size")
            for at in 0..<(usize)size:
                let use = uses[offset + at]
                let next = uses[offset + (at + 1) % (usize)size]
                let edge = self.edges[(usize)(use - 1 if use > 0 else -use - 1)]
                let following = self.edges[(usize)(next - 1 if next > 0 else -next - 1)]
                if (edge.end if use > 0 else edge.start) != (following.start if next > 0 else following.end):
                    error(invalid, "disconnected B-rep loop")
            offset += (usize)size
        if offset != uses.length:
            error(invalid, "B-rep loop sizes do not describe every edge use")
        self.faces[self.nf] = try BrepFace(surface, uses, sizes, sense)
        self.nf += 1
        return (i64)self.nf - 1

    ## Disposable per-face display mesh; independent of the whole-model budget.
    pub func preview_face(face: i64, divisions: i64 = 8) -> interop.Reference[Mesh]!:
        if face < 0 or (usize)face >= self.nf:
            error(invalid, "CAD face index out of range")
        let entry = self.faces[(usize)face]
        return try published(try face_mesh(self.vertices[..<self.nv], self.edges[..<self.ne], self.surfaces[(usize)entry.surface], entry, divisions, self.tolerance))

    ## Boundary-conforming tessellation; each shared edge is sampled once.
    ## `curvature` adds corner attributes curvature.k1/k2 (principal
    ## curvatures, k1 >= k2, positive where convex); `directions` adds the unit
    ## principal directions curvature.d1/d2. Both are off by default.
    pub func mesh(divisions: i64 = 16, edge_size: f64 = 0.0, progress: interop.Callback[f64, unit]? = none, curvature: bool = false, directions: bool = false) -> interop.Reference[Mesh]!:
        if not math.is_finite(edge_size) or edge_size < 0.0:
            error(invalid, "edge size must be finite and nonnegative")
        return try published(try tessellate(self.vertices[..<self.nv], self.edges[..<self.ne], self.surfaces[..<self.ns], self.faces[..<self.nf], divisions, self.tolerance, edge_size, progress, -1, curvature, directions))

    ## Diagnostic face mesh using the complete model's shared edge/layout plan.
    ## Other face jobs are skipped; success does not establish whole-model validity.
    pub func planned_face(face: i64, divisions: i64 = 16, edge_size: f64 = 0.0) -> interop.Reference[Mesh]!:
        if face < 0 or (usize)face >= self.nf: error(invalid,"CAD face index out of range")
        if not math.is_finite(edge_size) or edge_size < 0.0: error(invalid,"edge size must be finite and nonnegative")
        let result = try tessellate(self.vertices[..<self.nv],self.edges[..<self.ne],self.surfaces[..<self.ns],self.faces[..<self.nf],divisions,self.tolerance,edge_size,none,face)
        defer result.release()
        return try published(try MeshOps.compact(result))

    pub mutating func close():
        for edge in self.edges[..<self.ne]:
            edge.close()
        for surface in self.surfaces[..<self.ns]:
            surface.close()
        for face in self.faces[..<self.nf]:
            face.close()
        free(self.vertices) in memory.heap
        free(self.edges) in memory.heap
        free(self.surfaces) in memory.heap
        free(self.faces) in memory.heap

pub let brep_model_type: interop.Type[BrepModel] = interop.Type[BrepModel]("BrepModel", BrepModel.close, closeable = true)

## Tessellation works on precise meshes (f64 points; see geocore's
## Mesh); what it hands out is an ordinary f32 mesh. Takes `mesh`.
pub func published(mesh: interop.Reference[Mesh]) -> interop.Reference[Mesh]!:
    defer mesh.release()
    return try mesh.value().without_precision()
