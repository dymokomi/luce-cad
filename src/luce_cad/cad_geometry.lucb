## CAD models as a family of geocore's geometry sets. A set's CAD component
## holds analytic models (shared, never copied); it places, joins and
## filters by object path like any family, and tessellation turns it into
## the set's mesh, each face carrying its B-rep path in the `path` text
## attribute. Luce reaches all of it through the static methods of
## `CadGeometry`.
import interop
import memory
import ownership
from geocore import Mesh, Vector3, Matrix4, Bounds, invalid, GeometrySet
from geocore_growing import Growing
from geocore_kernel import ComponentType, Placement, IdSet, TableBuilder, PathFilter, MeshPart, Domain, Attribute, Instances
from geocore_kernel import adopt_set, dispose_set, empty_set, set_mesh, append_text, append_number, mesh_component, instances_component, new_instances, set_find, set_put, set_remove, set_storage, concatenated, with_attribute_entry, text_attribute, mesh_share
from luce_cad.model import CadModel, cad_model_type

## The models of one set: immutable once published, shared by count.
pub struct CadParts:
    var users: @usize
    var models: Growing[interop.Reference[CadModel]]

    pub func count() -> usize:
        return self.models.count

    pub func faces() -> usize:
        var total: usize = 0
        for model in self.models.view(): total += (usize)model.value().face_count()
        return total

    ## Add another owner of `model`.
    pub mutating func add(model: interop.Reference[CadModel]) -> !:
        let owner = model.clone()
        self.models.push(owner) catch failure:
            owner.release()
            error(failure.code, failure.message)

func new_parts() -> CadParts*!:
    let storage = try alloc CadParts[1] in memory.heap
    storage[0].users.store(1, .relaxed)
    storage[0].models = Growing[interop.Reference[CadModel]]()
    return storage.data

pub let cad_component: ComponentType = ComponentType("cad", share_parts, close_parts, parts_size, parts_bytes, parts_bounds, place_parts, join_parts, parts_paths, filter_parts, describe_parts,
                                                     "This operation requires polygons; connect a Tessellate node first", trace_parts)

func share_parts(data: const void*) -> void*!:
    let parts = (CadParts*)data
    discard(parts.users.add(1, .relaxed))
    return (void*)parts

func close_parts(data: void*):
    let parts = (CadParts*)data
    if parts.users.sub(1, .acq_rel) != 1: return
    for model in parts.models.view(): model.release()
    parts.models.close()
    free(CadParts[](parts, 1)) in memory.heap

func parts_size(data: const void*) -> usize:
    return ((const CadParts*)data).faces()

## Analytic data is not columnar yet: a model is charged once, by identity,
## at a nominal 16 KiB a face.
func parts_bytes(data: const void*, ids: IdSet*) -> usize!:
    var total: usize = 64
    for model in ((const CadParts*)data).models.view():
        total += try ids.charge((u64)(usize)model.value(), (usize)model.value().face_count() * 16384)
    return total

## Analytic bounds need a preview; the viewport frames CAD by its preview.
func parts_bounds(data: const void*, matrix: Matrix4, out: Bounds*) -> bool!:
    discard(data)
    discard(matrix)
    discard(out)
    return false

func place_parts(data: const void*, placement: const Placement*) -> void*!:
    let placed = try new_parts()
    errdefer close_parts((void*)placed)
    for model in ((const CadParts*)data).models.view():
        let moved = try model.value().transformed(placement.translation, placement.rotation, placement.scale)
        defer moved.release()
        try placed.add(moved)
    return (void*)placed

func join_parts(first: const void*, second: const void*) -> void*!:
    let joined = try new_parts()
    errdefer close_parts((void*)joined)
    for model in ((const CadParts*)first).models.view(): try joined.add(model)
    for model in ((const CadParts*)second).models.view(): try joined.add(model)
    return (void*)joined

func parts_paths(data: const void*, out: TableBuilder*) -> !:
    for model in ((const CadParts*)data).models.view():
        let value = model.value()
        for face in 0..<value.face_count():
            let path = try value.face_path(face)
            if path != "": discard(try out.intern(path))

## Each model keeps the faces whose path the filter matches (or loses them);
## a model left with no faces is dropped, one left whole is shared.
func filter_parts(data: const void*, filter: const PathFilter*, keep: bool) -> void*!:
    let filtered = try new_parts()
    errdefer close_parts((void*)filtered)
    var retained = Growing[i64]()
    defer retained.close()
    for model in ((const CadParts*)data).models.view():
        let value = model.value()
        let count = value.face_count()
        retained.clear()
        for face in 0..<count:
            let selected = filter.matches(try value.face_path(face)) if not filter.is_empty() else true
            let path_known = filter.is_empty() or (try value.face_path(face)) != ""
            if (selected and path_known) == keep: try retained.push(face)
        if retained.count == 0: continue
        if (i64)retained.count == count:
            try filtered.add(model)
            continue
        let subset = try value.subset(retained.view())
        defer subset.release()
        try filtered.add(subset)
    return (void*)filtered

func describe_parts(data: const void*, out: Growing[u8]*) -> !:
    try append_number(out, ((const CadParts*)data).faces())
    try append_text(out, " CAD surfaces")

func trace_parts(data: const void*, visit: func(ownership.Object*, void*) -> unit, context: void*):
    for model in ((const CadParts*)data).models.view(): model.trace(visit, context)

## Luce's view of the CAD family of a geometry set.
pub struct CadGeometry:
    let reserved: u8 = 0

    ## A set holding `model`.
    pub static func of_model(model: interop.Reference[CadModel]) -> interop.Reference[GeometrySet]!:
        let parts = try new_parts()
        parts.add(model) catch failure:
            close_parts((void*)parts)
            error(failure.code, failure.message)
        let storage = empty_set() catch failure:
            close_parts((void*)parts)
            error(failure.code, failure.message)
        set_put(storage, &cad_component, (void*)parts) catch failure:
            dispose_set(storage)
            error(failure.code, failure.message)
        return try adopt_set(storage)

    ## The set's CAD models (not its instances').
    pub static func model_count(set: interop.Reference[GeometrySet]) -> i64!:
        let data = set_find(try set.get(), &cad_component) else return 0
        return (i64)((const CadParts*)data).count()

    pub static func model(set: interop.Reference[GeometrySet], index: i64) -> interop.Reference[CadModel]!:
        let data = set_find(try set.get(), &cad_component) else error(invalid, "the geometry has no CAD models")
        let parts = (const CadParts*)data
        if index < 0 or (usize)index >= parts.count(): error(invalid, "CAD model index out of range")
        return parts.models.items[(usize)index].clone()

    ## Analytic faces of the set's own CAD models.
    pub static func face_count(set: interop.Reference[GeometrySet]) -> i64!:
        let data = set_find(try set.get(), &cad_component) else return 0
        return (i64)((const CadParts*)data).faces()

    ## The set with its CAD models tessellated into its mesh, instances
    ## included. Each face's `path` text attribute names its B-rep face's
    ## path; principal curvatures ride along where the model supports them.
    pub static func tessellated(set: interop.Reference[GeometrySet], segments: i64, edge_size: f64, progress: interop.Callback[f64, unit]? = none) -> interop.Reference[GeometrySet]!:
        return try adopt_set(try tessellated_storage(try set.get(), segments, edge_size, progress, 0))

func tessellated_storage(set: const GeometrySet*, segments: i64, edge_size: f64, progress: interop.Callback[f64, unit]?, depth: usize) -> GeometrySet*!:
    if depth > 64: error(invalid, "instances nest more than 64 deep")
    let result = try set_storage(set)
    errdefer dispose_set(result)
    if let data = set_find(set, &cad_component):
        let parts = (const CadParts*)data
        var owners = Growing[interop.Reference[Mesh]]()
        defer:
            for owner in owners.view(): owner.release()
            owners.close()
        var pieces = Growing[MeshPart]()
        defer pieces.close()
        if let existing = set_mesh(set): try pieces.push(MeshPart(existing, Matrix4()))
        for model in parts.models.view():
            let owner = try tessellate_with_paths(model.value(), segments, edge_size, progress)
            owners.push(owner) catch failure:
                owner.release()
                error(failure.code, failure.message)
            try pieces.push(MeshPart(owner.value(), Matrix4()))
        let mesh = try concatenated(pieces.view())
        defer mesh.release()
        set_remove(result, &cad_component)
        try set_put(result, mesh_component(), (void*)(try mesh_share(mesh.value())))
    try tessellate_instances(result, segments, edge_size, progress, depth)
    return result

## One model's tessellation with its faces' B-rep paths as `path`.
func tessellate_with_paths(model: const CadModel*, segments: i64, edge_size: f64, progress: interop.Callback[f64, unit]?) -> interop.Reference[Mesh]!:
    let part = try model.tessellate(segments, edge_size, progress, model.supports_curvature())
    defer part.release()
    let mesh = part.value()
    let source = mesh.find_attribute("cad_face", 2)
    var strings = TableBuilder()
    defer strings.close()
    let face_count = model.face_count()
    let face_paths = try alloc i32[(usize)face_count] in memory.heap
    defer free(face_paths) in memory.heap
    var any = false
    for face in 0..<face_count:
        let path = try model.face_path(face)
        face_paths[(usize)face] = (try strings.intern(path)) if path != "" else -1
        any = any or path != ""
    if not any or source < 0: return part.clone()
    let faces = (usize)mesh.face_count()
    let values = try alloc i32[faces] in memory.heap
    defer free(values) in memory.heap
    for face in 0..<faces:
        let original = (i64)(try mesh.attribute_value(source, (i64)face))
        values[face] = face_paths[(usize)original] if original >= 0 and original < face_count else -1
    let attribute = try text_attribute("path", Domain.face, faces, &strings, values)
    return try with_attribute_entry(mesh, attribute)

## The set's instances with each child tessellated in turn.
func tessellate_instances(result: GeometrySet*, segments: i64, edge_size: f64, progress: interop.Callback[f64, unit]?, depth: usize) -> !:
    let data = set_find(result, instances_component()) else return
    let source = (const Instances*)data
    let rebuilt = try new_instances()
    for index in 0..<source.count():
        let item = source.item(index)
        let child = tessellated_storage(item.set, segments, edge_size, progress, depth + 1) catch failure:
            let close = instances_component().close
            close((void*)rebuilt)
            error(failure.code, failure.message)
        let placement = Placement(item.translation, item.rotation, item.scale, item.matrix())
        rebuilt.add(child, &placement, item.visible) catch failure:
            let close = instances_component().close
            close((void*)rebuilt)
            error(failure.code, failure.message)
    try set_put(result, instances_component(), (void*)rebuilt)
