## Local display fallback for warped cut cells, never the surrounding patch.
from three import PolygonMesh, MeshBuilder, invalid

## Retain regular quads and valid cut n-gons. If a cut cell cannot be projected
## as a single 3D polygon, use its already validated parameter-space triangles.
## All boundary IDs survive; only this cell gains internal polygon edges.
pub func append_cells(lifted: MeshBuilder*, part: PolygonMesh*, forward: bool) -> !:
    var scratch = try MeshBuilder()
    defer scratch.close()
    var triangle: i64 = 0
    for face in 0..<part.face_count():
        let count = try part.face_size(face)
        var polygon = true
        if count > 4:
            scratch.np = 0
            scratch.nf = 0
            scratch.nc = 0
            try scratch.face(count)
            for at in 0..<count:
                let id = try part.face_point(face,at if forward else count-1-at)
                try scratch.corner(try scratch.point(lifted.points[(usize)id]))
            check(&scratch) catch failure:
                if failure.code != invalid: error(failure.code,failure.message)
                polygon = false
                recover ()
        if polygon:
            try lifted.face(count)
            for at in 0..<count: try lifted.corner(try part.face_point(face,at if forward else count-1-at))
        else:
            let offset = try part.face_offset(face)
            for t in 0..<count-2:
                try lifted.face(3)
                for at in 0..<3:
                    let reference = part.index(triangle+t*3+(at if forward else 2-at))
                    defer reference.release()
                    try lifted.corner(try part.face_point(face,(try reference.get())-offset))
        triangle += (count-2)*3

func check(scratch: MeshBuilder*) -> !:
    let result = try scratch.finish()
    result.release()
