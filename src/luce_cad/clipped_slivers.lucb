## Optional cut-cell cleanup. An almost coincident grid/trim line can leave a
## sub-tolerance ribbon. Merge the interior side, never the canonical CAD trim.
import interop
from three import Vector3, PolygonMesh, TopologyTools, invalid
from luce_cad.clipped_merge import merge_edge

## Coalesce only sub-tolerance, boundary-adjacent slivers with a safe larger
## neighbor. Original point IDs/positions survive; the caller still validates
## lifted display triangles. Work stops after 128 optional dissolves.
## Curved charts provide lifted positions: UV width is not a physical length.
pub func coalesce(source: interop.Reference[PolygonMesh], boundary: usize, tolerance: f64, positions: const Vector3[]? = none) -> interop.Reference[PolygonMesh]!:
    if let points = positions:
        if points.length != (usize)source.value().point_count(): error(invalid,"cut-cell metric must cover every chart point")
    var current = source.clone()
    errdefer current.release()
    for pass in 0..<128:
        var edge: i64 = -1
        let mesh = current.value()
        for face in 0..<mesh.face_count():
            if not (try sliver(mesh,face,boundary,tolerance*0.05,positions)): continue
            edge = try merge_edge(mesh,face,positions)
            if edge >= 0: break
        if edge < 0: break
        let next = try TopologyTools.dissolve(current,edge)
        current.release()
        current = next
    return current

func sliver(mesh: const PolygonMesh*, face: i64, boundary: usize, width: f64, positions: const Vector3[]?) -> bool!:
    let count = try mesh.face_size(face)
    let origin = try position(mesh,try mesh.face_point(face,0),positions)
    var area = Vector3()
    var longest: f64 = 0.0
    var boundary_points: usize = 0
    for at in 0..<count:
        let id = try mesh.face_point(face,at)
        if (usize)id < boundary: boundary_points += 1
        let a = (try position(mesh,id,positions)).subtract(origin)
        let b = (try position(mesh,try mesh.face_point(face,(at+1)%count),positions)).subtract(origin)
        area = area.add(a.cross(b))
        let length = b.subtract(a).length()
        if length > longest: longest = length
    if boundary_points < 2 or longest <= 0.0: return false
    return area.length()*0.5 <= longest*width

func position(mesh: const PolygonMesh*, id: i64, positions: const Vector3[]?) -> Vector3!:
    if let points = positions: return points[(usize)id]
    return try mesh.point(id)
