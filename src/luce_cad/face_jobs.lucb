## Bounded native face jobs on the CAD worker pool. Workers borrow immutable
## CAD/edge data; each owns its native scratch and ARC temporaries. Only copied
## raw arrays cross back.
import memory
import thread
import ownership
import interop
import sync
import geocore_parallel as parallel
from geocore import Vector3, MeshBuilder, invalid
from luce_cad.brep_types import Surface, Curve, BrepFace, Samples
from luce_cad.surface_normals import face_normals
from luce_cad.layout_types import GridLayout

pub type FaceMesher = func(MeshBuilder*, BrepFace, Surface, const Curve[], const Samples[], GridLayout, i64, f64, f64) -> unit!

struct Product:
    var points: Vector3[]
    var sizes: i64[]
    var corners: i64[]
    var display: i64[]
    var normals: f64[]
    var owns_normals: bool = true
    var failure: interop.Packet[str]? = none
    func close():
        if self.points.length > 0: free(self.points) in memory.heap
        if self.sizes.length > 0: free(self.sizes) in memory.heap
        if self.corners.length > 0: free(self.corners) in memory.heap
        if self.display.length > 0: free(self.display) in memory.heap
        if self.owns_normals and self.normals.length > 0: free(self.normals) in memory.heap
        if let failure = self.failure: failure.release()

struct Jobs:
    var lock: sync.Mutex
    var next: usize = 0
    var completed: usize = 0
    var stop: bool = false
    var failure: interop.Packet[str]? = none
    let points: const Vector3[]
    let edges: const Curve[]
    let surfaces: const Surface[]
    let faces: const BrepFace[]
    let samples: const Samples[]
    let plans: const GridLayout[]
    let divisions: i64
    let tolerance: f64
    let edge_size: f64
    let products: Product[]
    let mesher: FaceMesher

## One pool item per worker: each keeps one scratch builder for all its faces.
func run(raw: void*?, slot: usize):
    discard(slot)
    let jobs = (Jobs*)(raw else return)
    work(jobs) catch failure:
        jobs.lock.lock()
        defer jobs.lock.unlock()
        if jobs.failure == none:
            jobs.failure = interop.text_transfer.copy(failure.message) catch exhausted: trap(exhausted.message)
        jobs.stop = true

func work(jobs: Jobs*) -> !:
    var scratch = try MeshBuilder(precise = true)
    defer scratch.close()
    for point in jobs.points:
        discard(try scratch.point(point))
    while true:
        jobs.lock.lock()
        if jobs.stop or jobs.next == jobs.faces.length:
            jobs.lock.unlock()
            return
        let index = jobs.next
        jobs.next += 1
        jobs.lock.unlock()
        scratch.np = jobs.points.length
        scratch.nf = 0
        scratch.nc = 0
        prepare(jobs, index, &scratch) catch failure:
            var context: u8[1024]
            let message = format(context, f"CAD face {index}: {failure.message}") catch exhausted: recover failure.message
            jobs.products[index].failure = interop.text_transfer.copy(message) catch exhausted: trap(exhausted.message)
            # Do not cook the rest of a rejected model. Lower indices have
            # already been assigned; joining their in-flight jobs below keeps
            # the reported first failing face deterministic across schedules.
            jobs.lock.lock()
            jobs.stop = true
            jobs.lock.unlock()
        jobs.lock.lock()
        jobs.completed += 1
        jobs.lock.unlock()

func prepare(jobs: Jobs*, index: usize, scratch: MeshBuilder*) -> !:
    let face = jobs.faces[index]
    let plan = jobs.plans[index]
    try jobs.mesher(scratch, face, jobs.surfaces[(usize)face.surface], jobs.edges, jobs.samples, plan, jobs.divisions, jobs.tolerance, jobs.edge_size)
    let product = &jobs.products[index]
    product.points = try alloc Vector3[scratch.np - jobs.points.length] in memory.heap
    product.sizes = try alloc i64[scratch.nf] in memory.heap
    product.corners = try alloc i64[scratch.nc] in memory.heap
    memory.copy(product.points, scratch.points[jobs.points.length..<scratch.np], product.points.length)
    memory.copy(product.sizes, scratch.sizes, scratch.nf)
    memory.copy(product.corners, scratch.corners, scratch.nc)
    if scratch.display.length > 0:
        product.display = try alloc i64[(scratch.nc-scratch.nf*2)*3] in memory.heap
        memory.copy(product.display,scratch.display,product.display.length)
    product.owns_normals = not (plan.applied.length > 0 and plan.applied[0])
    product.normals = (try face_normals(scratch, 0, scratch.nc, face, jobs.surfaces[(usize)face.surface], jobs.tolerance)) if product.owns_normals else plan.normals[0].values

## The caller invokes progress on its own thread. Results are assembled in face
## order, so parallel scheduling cannot change point IDs, topology or attributes.
pub func mesh_faces(mesh: MeshBuilder*, edges: const Curve[], surfaces: const Surface[], faces: const BrepFace[], samples: const Samples[], plans: const GridLayout[], divisions: i64, tolerance: f64, edge_size: f64, progress: interop.Callback[f64, unit]?, mesher: FaceMesher) -> f64[]!:
    let products = try alloc Product[faces.length] in memory.heap
    defer free(products) in memory.heap
    for index in 0..<products.length:
        products[index] = Product()
    defer close_products(products)
    var jobs = Jobs(points = mesh.points[..<mesh.np], edges = edges, surfaces = surfaces, faces = faces, samples = samples, plans = plans, divisions = divisions, tolerance = tolerance, edge_size = edge_size, products = products, mesher = mesher)
    defer release_failure(&jobs)
    var job = parallel.Job()
    let threads = job_threads()
    parallel.start(&job, threads if threads < faces.length else faces.length, run, (void*)&jobs)
    var running = true
    defer:
        if running: stop_jobs(&jobs, &job)
    var reported: usize = 0
    while true:
        jobs.lock.lock()
        let completed = jobs.completed
        let stopped = jobs.stop
        jobs.lock.unlock()
        if completed != reported:
            if let report = progress:
                let outcome = report.invoke((f64)completed / (f64)faces.length * 0.9)
                defer outcome.release()
                try outcome.get()
            reported = completed
        if completed == faces.length or stopped:
            break
        thread.sleep(2)
    stop_jobs(&jobs, &job)
    running = false
    if let failure = jobs.failure:
        let owned = try interop.copy_text(failure.value)
        if let owner = owned.owner: discard(ownership.pool_object(owner))
        error(invalid, owned.value)
    # Check before allocating or assembling partial products. Unscheduled
    # faces are empty, while every assigned worker has now been joined.
    for product in products:
        if let failure = product.failure:
            let owned = try interop.copy_text(failure.value)
            if let owner = owned.owner: discard(ownership.pool_object(owner))
            error(invalid, owned.value)
    let boundary = mesh.np
    var normal_count: usize = 0
    for product in products: normal_count += product.normals.length
    let normals = try alloc f64[normal_count] in memory.heap
    errdefer free(normals) in memory.heap
    var normal_offset: usize = 0
    for index in 0..<products.length:
        let product = products[index]
        let base = mesh.np
        for point in product.points:
            discard(try mesh.point(point))
        var corner: usize = 0
        var display: usize = 0
        var local_indices: i64[762]
        for size in product.sizes:
            let first = corner
            try mesh.face(size, (i64)index)
            for at in 0..<size:
                let id = product.corners[corner]
                try mesh.corner(id if (usize)id < boundary else (i64)(base + (usize)id - boundary))
                corner += 1
            let count = ((usize)size-2)*3
            if product.display.length > 0 and product.display[display] >= 0:
                for at in 0..<count: local_indices[at] = product.display[display+at]-(i64)first
                try mesh.set_last_display(local_indices[..<count])
            display += count
        memory.copy(normals[normal_offset..<normal_offset + product.normals.length], product.normals, product.normals.length)
        normal_offset += product.normals.length
    return normals

func stop_jobs(jobs: Jobs*, job: parallel.Job*):
    jobs.lock.lock()
    jobs.stop = true
    jobs.lock.unlock()
    parallel.wait(job)

func close_products(products: const Product[]):
    for product in products: product.close()

func release_failure(jobs: Jobs*):
    if let failure = jobs.failure: failure.release()

## Faces meshed at once: one long-running item per pool worker (a batch
## started here runs on the workers alone), or one on this thread without any.
pub func job_threads() -> usize:
    let width = parallel.width()
    return width - 1 if width > 1 else 1
