## Shared trim discretization and interior flow are separate decisions.
## Planar charts are orthonormal support-distance coordinates. Their existing
## curvature/size grid needs no extra support from a late neighbor's phase.
import math
from luce_cad.layout_types import Stations

## Keep useful subdivisions, but stop a competing phase if its worst rectangle
## exceeds 20:1 and is more than twice as stretched as the cell it splits.
## Guard intervals outside the real trim bounds do not participate. Nothing
## here removes a station, moves a trim vertex, or changes canonical edge IDs.
pub func accept_plane_row(along: Stations, across: Stations, value: f64, low: f64, high: f64, cross_low: f64, cross_high: f64, epsilon: f64) -> bool:
    if value <= low+epsilon or value >= high-epsilon: return true
    var left = low
    var right = high
    for at in along.values[..<along.count]:
        if math.abs(at-value) <= epsilon: return true
        if at < value: left = math.max(left,at)
        else:
            right = math.min(right,at)
            break
    let whole = right-left
    let small = math.min(value-left,right-value)
    let large = math.max(value-left,right-value)
    if small <= epsilon or whole <= epsilon: return true
    for at in 0..<across.count-1:
        let gap = math.min(cross_high,across.values[at+1])-math.max(cross_low,across.values[at])
        if gap <= epsilon: continue
        # Compare the same rectangle before/after. A pre-existing skinny cell
        # in another row must not excuse a newly damaged healthy rectangle.
        let before = math.max(whole/gap,gap/whole)
        let after = math.max(large/gap,gap/small)
        if after > 20.0 and after > before*2.0: return false
    return true
