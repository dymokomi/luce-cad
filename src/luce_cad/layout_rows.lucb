## Face-owned interior rows, distinct from the shared boundary discretization.
import memory
import math
from three import invalid
from luce_cad.brep_types import Curve, Surface, BrepFace, Samples
from luce_cad.patch_sides import PatchSides, side_count, edge_index
from luce_cad.patch_density import patch_density
from luce_cad.layout_types import Stations, RowIds, GridLayout
from luce_cad.seam_flow import SeamFlow
from luce_cad.curve_spacing import ArcMetric, raise_side

## Establish each patch's own curvature requirement before sharing any rows.
## Hard seams share cuts later, but cannot inflate a neighbor's interior grid.
pub func initialize(edges: const Curve[], surfaces: const Surface[], faces: const BrepFace[], sides: const PatchSides[], baseline: const usize[], seams: const SeamFlow[], metrics: const ArcMetric[], plans: GridLayout[], divisions: i64, tolerance: f64) -> !:
    let counts = try alloc usize[edges.length] in memory.heap
    defer free(counts) in memory.heap
    for at in 0..<faces.length:
        let face = faces[at]
        for use in face.uses:
            let edge = edge_index(use)
            counts[edge] = baseline[edge]
        patch_density(face,surfaces[(usize)face.surface],edges,counts,metrics,divisions,tolerance) catch failure:
            if failure.code != invalid: error(failure.code,failure.message)
            recover ()
        let side = sides[at]
        if side.valid:
            for pair in 0..<(usize)2:
                let a = side_count(face,side,pair,counts)
                let b = side_count(face,side,pair+2,counts)
                if a == b: continue
                let axis = pair if a < b else pair+2
                raise_side(face,side,axis,counts,metrics,b if a < b else a)
        let plan = &plans[at]
        plan.rows = try alloc Stations[face.uses.length] in memory.heap
        for use in 0..<plan.rows.length: plan.rows[use] = Stations()
        plan.row_ids = try alloc RowIds[face.uses.length] in memory.heap
        for use in 0..<plan.row_ids.length: plan.row_ids[use] = RowIds()
        plan.flow = try alloc bool[face.uses.length] in memory.heap
        plan.support_rows = try alloc bool[face.uses.length] in memory.heap
        let kind = surfaces[(usize)face.surface].kind
        # Only single-span transverse NURBS strips get this conservative guard.
        # On doubly-curved patches it would pull an unrelated hard-edge phase
        # through the interior, recreating the very fans the flow stop avoids.
        let strip = side.valid and (side_count(face,side,0,counts) == 1 or side_count(face,side,1,counts) == 1)
        for use in 0..<face.uses.length:
            let index = edge_index(face.uses[use])
            plan.flow[use] = seams[index].aligned
            # A curved support cannot always absorb curved-edge cuts into a
            # warped n-gon: its display ears can become perpendicular slivers.
            # Retain support rows on that side, without opening the flow island
            # or forcing a planar neighbor to inherit any interior rows.
            plan.support_rows[use] = side.valid and not seams[index].smooth and kind != 0 and (kind != 3 or strip) and edges[index].kind != 0 and baseline[index] > 1
            try plan.rows[use].open(1025)
            for step in 0..<counts[index]+1:
                discard(try plan.rows[use].insert(metrics[index].station((f64)step/(f64)counts[index]),1e-12))

## Freeze local row parameters as canonical shared point IDs, never new points.
pub func bind(faces: const BrepFace[], cuts: const Stations[], samples: const Samples[], plans: GridLayout[]) -> !:
    for face in 0..<faces.length:
        for use in 0..<faces[face].uses.length:
            let index = edge_index(faces[face].uses[use])
            let row = plans[face].rows[use]
            let ids = try alloc i64[row.count] in memory.heap
            plans[face].row_ids[use].values = ids
            var station: usize = 0
            for at in 0..<row.count:
                while station+1 < cuts[index].count and cuts[index].values[station] < row.values[at]-1e-9: station += 1
                if math.abs(cuts[index].values[station]-row.values[at]) > 1e-9:
                    error(invalid,"shared boundary lost a face row station")
                ids[at] = samples[index].ids[station]
