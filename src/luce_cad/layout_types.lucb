## Owned planning scratch. The frozen layouts are borrowed by native face jobs.
import memory
import math
from three import invalid
from three import Vector3

## Cached parameter chain for one oriented face use; points remain in the
## canonical edge direction. Its length is the edge's monotonic revision.
pub struct UVChain:
    pub var points: Vector3[]
    pub var times: f64[]

## Corner normals evaluated directly from the clipped grid's known UVs.
pub struct NormalCache:
    pub var values: f64[]

## Frozen global point IDs selected by one face for its own interior rows.
pub struct RowIds:
    pub var values: i64[]

## Bounded, sorted parameters with separate numerical and optional row spacing.
pub struct Stations:
    pub var values: f64[]
    pub var count: usize = 0
    pub var epsilon: f64 = 1e-7
    pub var separation: f64 = 0.0
    pub var baseline: usize = 0
    pub var limit: usize = 0

    pub mutating func open(capacity: usize) -> !:
        self.values = try alloc f64[capacity if capacity < 16 else 16] in memory.heap
        self.count = 0
        self.limit = capacity

    ## Sorted bounded union, not an interval count: phase survives propagation.
    pub mutating func insert(value: f64, epsilon: f64) -> bool!:
        var low: usize = 0
        var high = self.count
        while low < high:
            let mid = (low+high)//2
            if self.values[mid] < value: low = mid+1
            else: high = mid
        let distance = math.max(epsilon,self.separation)
        if low < self.count and math.abs(self.values[low]-value) <= distance: return false
        if low > 0 and math.abs(self.values[low-1]-value) <= distance: return false
        if self.count == self.values.length:
            if self.count == self.limit: error(invalid,"cross-patch layout station budget exceeded")
            let capacity = self.limit if self.values.length*2 > self.limit else self.values.length*2
            let grown = try alloc f64[capacity] in memory.heap
            memory.copy(grown,self.values,self.count)
            free(self.values) in memory.heap
            self.values = grown
        var at = self.count
        while at > low:
            self.values[at] = self.values[at-1]
            at -= 1
        self.values[low] = value
        self.count += 1
        return true

    pub func close():
        if self.values.length > 0: free(self.values) in memory.heap

## Per-face layout and owned coedge/normal caches, frozen before face meshing.
pub struct GridLayout:
    pub var island: i64 = -1
    pub var rows: Stations[]
    pub var row_ids: RowIds[]
    pub var flow: bool[]
    pub var support_rows: bool[]
    pub var u: Stations = Stations()
    pub var v: Stations = Stations()
    pub var valid: bool = false
    pub var cut_first: bool = false
    pub var epsilon: f64 = 1e-8
    pub var applied: bool[]
    pub var seen: usize = 0
    pub var chains: UVChain[]
    pub var normals: NormalCache[]

    pub func close():
        for row in self.rows: row.close()
        if self.rows.length > 0: free(self.rows) in memory.heap
        for ids in self.row_ids:
            if ids.values.length > 0: free(ids.values) in memory.heap
        if self.row_ids.length > 0: free(self.row_ids) in memory.heap
        if self.flow.length > 0: free(self.flow) in memory.heap
        if self.support_rows.length > 0: free(self.support_rows) in memory.heap
        self.u.close()
        self.v.close()
        if self.applied.length > 0: free(self.applied) in memory.heap
        for chain in self.chains:
            if chain.points.length > 0: free(chain.points) in memory.heap
            if chain.times.length > 0: free(chain.times) in memory.heap
        if self.chains.length > 0: free(self.chains) in memory.heap
        if self.normals.length > 0:
            if self.normals[0].values.length > 0: free(self.normals[0].values) in memory.heap
            free(self.normals) in memory.heap
