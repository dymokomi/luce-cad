## Pure support-normal evaluation, independent of projection and face meshing.
import math
from geocore import Vector3
from luce_cad.tessellation.surface import surface_normal_checked
from luce_cad.brep_types import Surface

pub func nurbs_normal(s: Surface, uv: Vector3) -> Vector3!:
    let u0 = s.ku[(usize)s.du]
    let v0 = s.kv[(usize)s.dv]
    let u1 = s.ku[(usize)s.nu]
    let v1 = s.kv[(usize)s.nv]
    return try surface_normal_checked(s.points, s.weights, s.nu, s.nv, s.du, s.dv, s.ku, s.kv, math.clamp(u0 + (u1-u0)*uv.x, u0, u1), math.clamp(v0 + (v1-v0)*uv.y, v0, v1))

## Native analytic parameters or normalized NURBS parameters, as in mapped.point.
pub func support_normal(s: Surface, uv: Vector3) -> Vector3!:
    if s.kind == 0: return s.z
    if s.kind == 3: return try nurbs_normal(s,uv)
    let radial = s.x.multiply_scalar(math.cos(uv.x)).add(s.y.multiply_scalar(math.sin(uv.x)))
    if s.kind == 4 or s.kind == 5:
        return radial.multiply_scalar(math.cos(uv.y)).add(s.z.multiply_scalar(math.sin(uv.y)))
    return try radial.subtract(s.z.multiply_scalar(math.tan(s.angle) if s.kind == 2 else 0.0)).normalized()
