## Trimmed nonperiodic NURBS: bounded UV inversion, constrained meshing, lifting.
import memory
import math
import interop
import ownership
from three import Vector3, MeshBuilder, invalid
from tesselator import TrimPolygon
from luce_cad.brep_types import Surface
from luce_cad.adaptive_uv import refine_uv

pub func evaluate(surface: Surface, uv: Vector3) -> Vector3!:
    let u0 = surface.ku[(usize)surface.du]
    let v0 = surface.kv[(usize)surface.dv]
    let u1 = surface.ku[(usize)surface.nu]
    let v1 = surface.kv[(usize)surface.nv]
    return try surface.at(math.clamp(u0 + (u1 - u0) * uv.x, u0, u1), math.clamp(v0 + (v1 - v0) * uv.y, v0, v1))

func improve(surface: Surface, point: Vector3, seed: Vector3) -> Vector3!:
    var uv = seed
    for iteration in 0..<48:
        let p = try evaluate(surface, uv)
        let residual = point.subtract(p)
        # Layout intersections need parameter precision finer than a grid snap.
        # The acceptance tolerance below is unchanged; this only solves the UV
        # inverse more accurately when the edge actually lies on the support.
        if residual.length() < 0.000000000001:
            break
        let ua = math.max(0.0, uv.x - 0.00001)
        let ub = math.min(1.0, uv.x + 0.00001)
        let va = math.max(0.0, uv.y - 0.00001)
        let vb = math.min(1.0, uv.y + 0.00001)
        let du = (try evaluate(surface, Vector3(ub, uv.y, 0.0))).subtract(try evaluate(surface, Vector3(ua, uv.y, 0.0))).multiply_scalar(1.0 / (ub - ua))
        let dv = (try evaluate(surface, Vector3(uv.x, vb, 0.0))).subtract(try evaluate(surface, Vector3(uv.x, va, 0.0))).multiply_scalar(1.0 / (vb - va))
        let aa = du.dot(du)
        let ab = du.dot(dv)
        let bb = dv.dot(dv)
        let det = aa * bb - ab * ab
        if det <= aa * bb * 0.000000000001:
            break
        var dx = math.clamp((bb * du.dot(residual) - ab * dv.dot(residual)) / det, -0.25, 0.25)
        var dy = math.clamp((aa * dv.dot(residual) - ab * du.dot(residual)) / det, -0.25, 0.25)
        # Solve the remaining tangent when a constrained parameter cannot move.
        # Clamping the unconstrained 2D Newton step alone made edge projections
        # seed-dependent when STEP curves differ slightly from the support.
        if (uv.x <= 1e-12 and dx < 0.0) or (uv.x >= 1.0-1e-12 and dx > 0.0):
            dx = 0.0
            dy = math.clamp(dv.dot(residual)/bb,-0.25,0.25)
        if (uv.y <= 1e-12 and dy < 0.0) or (uv.y >= 1.0-1e-12 and dy > 0.0):
            dy = 0.0
            dx = math.clamp(du.dot(residual)/aa,-0.25,0.25)
        var accepted = false
        var factor: f64 = 1.0
        for step in 0..<12:
            let candidate = Vector3(math.clamp(uv.x + dx * factor, 0.0, 1.0), math.clamp(uv.y + dy * factor, 0.0, 1.0), 0.0)
            if (try evaluate(surface, candidate)).subtract(point).length() < residual.length():
                uv = candidate
                accepted = true
                break
            factor *= 0.5
        if not accepted:
            break
    return uv

pub func project(surface: Surface, point: Vector3, seed: Vector3, tolerance: f64) -> Vector3!:
    var uv = try improve(surface, point, seed)
    if (try evaluate(surface, uv)).subtract(point).length() <= tolerance:
        return uv
    var best: f64 = 1e100
    for u in 0..<9:
        for v in 0..<9:
            let candidate = Vector3((f64)u / 8.0, (f64)v / 8.0, 0.0)
            let distance = (try evaluate(surface, candidate)).subtract(point).length()
            if distance < best:
                best = distance
                uv = candidate
    uv = try improve(surface, point, uv)
    if (try evaluate(surface, uv)).subtract(point).length() > tolerance:
        # Narrow knot spans can disappear entirely between uniform seeds. Use
        # nearby control points' Greville parameters as additional local starts.
        var distances: f64[16]
        let seeds = try alloc Vector3[16] in memory.heap
        defer free(seeds) in memory.heap
        for index in 0..<(usize)16: seeds[index] = Vector3()
        for index in 0..<(usize)16: distances[index] = 1e100
        for u in 0..<(usize)surface.nu:
            for v in 0..<(usize)surface.nv:
                let delta = surface.points[u * (usize)surface.nv + v].subtract(point)
                let distance = delta.dot(delta)
                if distance >= distances[15]: continue
                var index: usize = 15
                while index > 0 and distance < distances[index - 1]:
                    distances[index] = distances[index - 1]
                    seeds[index] = seeds[index - 1]
                    index -= 1
                distances[index] = distance
                seeds[index] = Vector3(greville(surface.ku, u, surface.nu, surface.du), greville(surface.kv, v, surface.nv, surface.dv), 0.0)
        for index in 0..<(usize)16:
            if distances[index] == 1e100: break
            let candidate = try improve(surface, point, seeds[index])
            if (try evaluate(surface, candidate)).subtract(point).length() <= tolerance: return candidate
            if (try evaluate(surface, candidate)).subtract(point).length() < (try evaluate(surface, uv)).subtract(point).length(): uv = candidate
        var buffer: u8[512]
        let residual = (try evaluate(surface, uv)).subtract(point).length()
        let owned = try interop.copy_text(try format(buffer, f"NURBS boundary projection exceeds CAD tolerance: residual {residual}, tolerance {tolerance}"))
        if let owner = owned.owner: discard(ownership.pool_object(owner))
        error(invalid, owned.value)
    return uv

func greville(knots: const f64[], at: usize, count: i64, degree: i64) -> f64:
    var sum: f64 = 0.0
    for index in 1..<(usize)degree + 1: sum += knots[at + index]
    let low = knots[(usize)degree]
    return math.clamp((sum / (f64)degree - low) / (knots[(usize)count] - low), 0.0, 1.0)

pub func mesh_trim(mesh: MeshBuilder*, ids: const i64[], sizes: const i64[], surface: Surface, sense: bool, divisions: i64, edge_size: f64, tolerance: f64) -> !:
    # Approximate metric scaling avoids a square UV lattice on long thin strips.
    var u_length: f64 = 0.0
    var v_length: f64 = 0.0
    for at in 0..<16:
        let a = (f64)at / 16.0
        let b = (f64)(at + 1) / 16.0
        u_length += (try evaluate(surface, Vector3(b, 0.5, 0.0))).subtract(try evaluate(surface, Vector3(a, 0.5, 0.0))).length()
        v_length += (try evaluate(surface, Vector3(0.5, b, 0.0))).subtract(try evaluate(surface, Vector3(0.5, a, 0.0))).length()
    if u_length <= 0.000000001 or v_length <= 0.000000001:
        error(invalid, "degenerate NURBS parameter metric")
    let uv = try alloc Vector3[ids.length] in memory.heap
    defer free(uv) in memory.heap
    var seed = Vector3(0.5, 0.5, 0.0)
    for at in 0..<ids.length:
        seed = try project(surface, mesh.points[(usize)ids[at]], seed, tolerance)
        # Inversion noise along exact domain edges creates microscopic UV ears.
        # Snap parameters only near an endpoint, and only after checking the
        # actual surface residual. Original shared 3D boundary points stay intact.
        let snapped = Vector3(0.0 if seed.x < 0.0000001 else (1.0 if seed.x > 0.9999999 else seed.x),
                              0.0 if seed.y < 0.0000001 else (1.0 if seed.y > 0.9999999 else seed.y), 0.0)
        if (try evaluate(surface, snapped)).subtract(mesh.points[(usize)ids[at]]).length() <= tolerance:
            seed = snapped
        uv[at] = Vector3(seed.x * u_length, seed.y * v_length, 0.0)
    var spacing = u_length / (f64)divisions
    var vertical = v_length / (f64)divisions
    if edge_size > 0.0:
        spacing = math.min(spacing, edge_size)
        vertical = math.min(vertical, edge_size)
    let initial = try TrimPolygon.quadrangulate_seams(uv, sizes, Vector3(0.0, 0.0, 1.0), ids, spacing, vertical)
    defer initial.release()
    let chord = math.max(tolerance * 4.0, math.min(u_length, v_length) / ((f64)divisions * (f64)divisions * 4.0))
    let part = try refine_uv(initial, surface, u_length, v_length, chord)
    defer part.release()
    let mapped = try alloc i64[(usize)part.value().point_count()] in memory.heap
    defer free(mapped) in memory.heap
    for at in 0..<mapped.length:
        let point = try part.value().point((i64)at)
        mapped[at] = ids[at] if at < ids.length else (try mesh.point(try evaluate(surface, Vector3(point.x / u_length, point.y / v_length, 0.0))))
    for face in 0..<part.value().face_count():
        let count = try part.value().face_size(face)
        try mesh.face(count)
        for at in 0..<count:
            try mesh.corner(mapped[(usize)(try part.value().face_point(face, at if sense else count - 1 - at))])
