## All edge-split masks preserve a triangle's constrained boundary and area.
import math
from geocore import Vector3, MeshBuilder, invalid
from luce_cad.adaptive_cells import split_triangle, center_conditioned

pub func adaptive_cells_contract() -> !:
    for scale in [0.001,1.0,1000.0]: try conditioned_alternative(scale)
    for scale in [0.001,1.0,1000.0]:
        for thin in [false,true]:
            for reverse in [false,true]:
                for mask in 1..<8: try check(scale,thin,reverse,mask)

func check(scale: f64, thin: bool, reverse: bool, mask: i64) -> !:
    var mesh = try MeshBuilder(precise = true)
    defer mesh.close()
    let height = 1e-8 if thin else 0.7
    let positions = [Vector3(),Vector3(scale,0.0,0.0),Vector3(scale*0.2,scale*height,0.0)]
    for at in 0..<(usize)3: discard(try mesh.point(positions[2-at if reverse else at]))
    let vertices = [0,1,2]
    var cuts = [-1,-1,-1]
    var count: i64 = 0
    for at in 0..<(usize)3:
        if mask & (1 << at) == 0: continue
        cuts[at] = try mesh.point(mesh.points[at].add(mesh.points[(at+1)%3]).multiply_scalar(0.5))
        count += 1
    let before = mesh.np
    if not (try split_triangle(&mesh,vertices,cuts)): error(invalid,"a marked triangle side was ignored")
    if mesh.np != before or mesh.nf != (usize)(count+1): error(invalid,"edge refinement added unnecessary centroids or children")
    let result = try mesh.finish()
    defer result.release()
    let m = result.value()
    var area: f64 = 0.0
    for face in 0..<m.face_count():
        let a = try m.point(try m.face_point(face,0))
        let b = try m.point(try m.face_point(face,1))
        let c = try m.point(try m.face_point(face,2))
        let signed = b.subtract(a).cross(c.subtract(a)).z*( -1.0 if reverse else 1.0)
        if signed <= 0.0: error(invalid,"edge refinement inverted a child")
        area += signed
    if math.abs(area-scale*scale*height) > scale*scale*height*1e-12: error(invalid,"edge refinement changed triangle area")
    for edge in 0..<(try m.edge_count()):
        let a = try m.edge_point(edge,0)
        let b = try m.edge_point(edge,1)
        var expected: i64 = 2
        for at in 0..<(usize)3:
            let x = vertices[at]
            let y = vertices[(at+1)%3]
            let cut = cuts[at]
            if cut < 0:
                if same_edge(a,b,x,y): expected = 1
            elif same_edge(a,b,x,cut) or same_edge(a,b,cut,y): expected = 1
        var uses: i64 = 0
        var direction: i64 = 0
        for face in 0..<m.face_count():
            for corner in 0..<3:
                let x = try m.face_point(face,corner)
                let y = try m.face_point(face,(corner+1)%3)
                if same_edge(a,b,x,y):
                    uses += 1
                    direction += 1 if x == a else -1
        if uses != expected or (uses == 2 and direction != 0): error(invalid,"edge refinement broke constrained or interior edge ownership")

func same_edge(a: i64, b: i64, c: i64, d: i64) -> bool:
    return (a == c and b == d) or (a == d and b == c)

func conditioned_alternative(scale: f64) -> !:
    var mesh = try MeshBuilder(precise = true)
    defer mesh.close()
    for p in [Vector3(),Vector3(1.0,0.0,0.0),Vector3(0.2,1.4e-14,0.0)]: discard(try mesh.point(p.multiply_scalar(scale)))
    var cuts = [-1,-1,-1]
    var center = Vector3()
    for at in 0..<(usize)3:
        center = center.add(mesh.points[at].multiply_scalar(1.0/3.0))
        cuts[at] = try mesh.point(mesh.points[at].add(mesh.points[(at+1)%3]).multiply_scalar(0.5))
    if center_conditioned(&mesh,[0,1,2],cuts,center): error(invalid,"unsafe centre fan was not detected")
    if not (try split_triangle(&mesh,[0,1,2],cuts)): error(invalid,"conditioned edge alternative was not emitted")
    let result = try mesh.finish()
    defer result.release()
    if result.value().face_count() != 4 or result.value().point_count() != 6: error(invalid,"conditioned subdivision added a needless centre")
