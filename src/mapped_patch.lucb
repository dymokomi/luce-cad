## Four-sided trimmed patches: matched shared boundaries and a Coons UV grid.
## Interior points lie on the exact support, not a ruled approximation in 3D.
import memory
import luce_std.math
from luce_geocore.geocore import Vector3, MeshBuilder, invalid
from brep_types import Surface, BrepFace, Samples, Curve
from surface_trim import project, evaluate
from patch_sides import patch_sides
from mapped_refine import mapped_refine
from mapped_spacing import redistribute

## Mesh a four-sided disk without inserting independent boundary vertices.
## Reject folded/degenerate parameter grids so the constrained mesher can retry.
pub func mapped_patch(mesh: MeshBuilder*, face: BrepFace, s: Surface, edges: const Curve[], samples: const Samples[], tolerance: f64, divisions: i64 = 16) -> !:
    let sides = try patch_sides(face, s, edges, tolerance)
    if not sides.valid:
        error(invalid, "mapped patch requires four boundary sides")
    var offsets: usize[5]
    offsets[0] = 0
    for side in 0..<(usize)4:
        offsets[side + 1] = offsets[side] + 1
        for segment in 0..<sides.lengths[side]:
            offsets[side + 1] += samples[edge_index(face.uses[(sides.starts[side]+segment)%face.uses.length])].ids.length - 1
    let nx = offsets[1] - offsets[0] - 1
    let ny = offsets[2] - offsets[1] - 1
    if nx != offsets[3] - offsets[2] - 1 or ny != offsets[4] - offsets[3] - 1 or nx == 0 or ny == 0 or (nx + 1) * (ny + 1) > 131072:
        error(invalid, "mapped patch boundary counts are incompatible")
    let boundary = try alloc Vector3[offsets[4]] in memory.heap
    defer free(boundary) in memory.heap
    let ids = try alloc i64[offsets[4]] in memory.heap
    defer free(ids) in memory.heap
    var previous = Vector3(0.5, 0.5, 0.0)
    for side in 0..<(usize)4:
        var index = offsets[side]
        for segment in 0..<sides.lengths[side]:
            let use = face.uses[(sides.starts[side]+segment)%face.uses.length]
            let points = samples[edge_index(use)].ids
            let length = points.length if segment+1 == sides.lengths[side] else points.length-1
            for at in 0..<length:
                ids[index] = points[at if use > 0 else points.length - 1 - at]
                let p = mesh.points[(usize)ids[index]]
                previous = try parameter(s, p, previous, tolerance, index > 0)
                boundary[index] = previous
                index += 1
        if side > 0 and ids[offsets[side] - 1] != ids[offsets[side]]:
            error(invalid, "mapped patch sides do not meet")
    if ids[0] != ids[ids.length - 1] or boundary[0].subtract(boundary[boundary.length - 1]).length() > 0.00001:
        error(invalid, "mapped patch has an open or singular parameter boundary")
    let grid = try alloc Vector3[(nx + 1) * (ny + 1)] in memory.heap
    defer free(grid) in memory.heap
    let mapped = try alloc i64[grid.length] in memory.heap
    defer free(mapped) in memory.heap
    let a = boundary[0]
    let b = boundary[nx]
    let c = boundary[offsets[2]]
    let d = boundary[offsets[3]]
    for row in 0..<ny + 1:
        let v = (f64)row / (f64)ny
        for column in 0..<nx + 1:
            let u = (f64)column / (f64)nx
            let bottom = boundary[column]
            let right = boundary[offsets[1] + row]
            let top = boundary[offsets[2] + nx - column]
            let left = boundary[offsets[3] + ny - row]
            let bilinear = a.multiply_scalar((1.0-u)*(1.0-v)).add(b.multiply_scalar(u*(1.0-v))).add(c.multiply_scalar(u*v)).add(d.multiply_scalar((1.0-u)*v))
            let uv = bottom.multiply_scalar(1.0-v).add(top.multiply_scalar(v)).add(left.multiply_scalar(1.0-u)).add(right.multiply_scalar(u)).subtract(bilinear)
            grid[row * (nx + 1) + column] = uv
            if s.kind == 3 and (uv.x < -0.0000001 or uv.x > 1.0000001 or uv.y < -0.0000001 or uv.y > 1.0000001):
                error(invalid, "mapped patch leaves the NURBS domain")
    let initial_turn = grid[1].subtract(grid[0]).cross(grid[nx+2].subtract(grid[1])).z
    try redistribute(grid,nx,ny,s,tolerance,(initial_turn > 0.0) == face.sense,divisions)
    # Every corner must have the same nonzero Jacobian sign. This also excludes
    # concave quads that would otherwise hide an inverted display triangle.
    var direction: f64 = 0.0
    for row in 0..<ny:
        for column in 0..<nx:
            let at = row * (nx + 1) + column
            let corners = [grid[at], grid[at + 1], grid[at + nx + 2], grid[at + nx + 1]]
            for corner in 0..<(usize)4:
                let turn = corners[(corner + 1) % 4].subtract(corners[corner]).cross(corners[(corner + 2) % 4].subtract(corners[(corner + 1) % 4])).z
                if direction == 0.0: direction = turn
                if math.abs(turn) < 1e-16 or turn * direction <= 0.0:
                    error(invalid, "mapped patch grid folds or degenerates")
    for row in 0..<ny + 1:
        for column in 0..<nx + 1:
            let at = row * (nx + 1) + column
            if row == 0: mapped[at] = ids[column]
            elif row == ny: mapped[at] = ids[offsets[2] + nx - column]
            elif column == 0: mapped[at] = ids[offsets[3] + ny - row]
            elif column == nx: mapped[at] = ids[offsets[1] + row]
            else: mapped[at] = try mesh.point(try point(s, grid[at]))
    let forward = (direction > 0.0) == face.sense
    let refine = s.kind != 0 and s.kind != 3 and face.uses.length > 4
    for row in 0..<ny:
        for column in 0..<nx:
            let at = row * (nx + 1) + column
            let corners = [mapped[at], mapped[at + 1], mapped[at + nx + 2], mapped[at + nx + 1]]
            let pa = mesh.points[(usize)corners[0]]
            let pb = mesh.points[(usize)corners[1]]
            let pc = mesh.points[(usize)corners[2]]
            let pd = mesh.points[(usize)corners[3]]
            let first = pb.subtract(pa).cross(pc.subtract(pa))
            let second = pc.subtract(pa).cross(pd.subtract(pa))
            if first.length() <= 1e-12 or second.length() <= 1e-12 or first.dot(second) <= 0.0:
                error(invalid, "mapped patch folds or collapses on its support")
            let normal = try first.add(second).normalized()
            let positions = [pa, pb, pc, pd]
            for corner in 0..<(usize)4:
                let p = positions[corner]
                if positions[(corner+1)%4].subtract(p).cross(positions[(corner+2)%4].subtract(p)).dot(normal) <= 1e-12:
                    error(invalid, "mapped patch has a degenerate display diagonal")
            if not refine:
                try mesh.face(4)
                for corner in 0..<(usize)4: try mesh.corner(corners[corner if forward else 3 - corner])
    if refine: try mapped_refine(mesh,grid,mapped,nx,ny,s,forward,tolerance,divisions)

func edge_index(use: i64) -> usize:
    return (usize)(use - 1 if use > 0 else -use - 1)

func wrap(value: f64, previous: f64) -> f64:
    var result = value
    while result - previous > math.pi: result -= 2.0 * math.pi
    while result - previous < -math.pi: result += 2.0 * math.pi
    return result

## Parameters on a support surface; unwrap periodic coordinates continuously.
pub func parameter(s: Surface, p: Vector3, previous: Vector3, tolerance: f64, unwrap: bool = true) -> Vector3!:
    if s.kind == 3: return try project(s, p, previous, tolerance)
    let relative = p.subtract(s.origin)
    let x = relative.dot(s.x)
    let y = relative.dot(s.y)
    let z = relative.dot(s.z)
    if s.kind == 0:
        if math.abs(z) > tolerance: error(invalid, "mapped planar boundary is outside its support tolerance")
        return Vector3(x, y, 0.0)
    let radius = math.sqrt(x*x + y*y)
    var u = math.atan2(y, x)
    var v = math.atan2(z, radius) if s.kind == 4 else (math.atan2(z, radius - s.radius) if s.kind == 5 else z)
    if unwrap:
        u = wrap(u, previous.x)
        if s.kind == 5: v = wrap(v, previous.y)
    let uv = Vector3(u, v, 0.0)
    if (try point(s, uv)).subtract(p).length() > tolerance:
        error(invalid, "mapped boundary is outside its support tolerance")
    return uv

## Evaluate normalized NURBS UV or native analytic surface parameters.
pub func point(s: Surface, uv: Vector3) -> Vector3!:
    if s.kind == 3: return try evaluate(s, uv)
    if s.kind == 0: return s.origin.add(s.x.multiply_scalar(uv.x)).add(s.y.multiply_scalar(uv.y))
    let radial = s.x.multiply_scalar(math.cos(uv.x)).add(s.y.multiply_scalar(math.sin(uv.x)))
    if s.kind == 4: return s.origin.add(radial.multiply_scalar(s.radius * math.cos(uv.y))).add(s.z.multiply_scalar(s.radius * math.sin(uv.y)))
    if s.kind == 5: return s.origin.add(radial.multiply_scalar(s.radius + s.angle * math.cos(uv.y))).add(s.z.multiply_scalar(s.angle * math.sin(uv.y)))
    return s.origin.add(radial.multiply_scalar(s.radius + uv.y * math.tan(s.angle) if s.kind == 2 else s.radius)).add(s.z.multiply_scalar(uv.y))
