## Chamfers and fillets of straight edges between two planar faces (the
## first rows of OpenCASCADE's ChFiKPart table: plane/plane gives a plane or
## a cylinder), made with booleans: for each edge a tool solid, the corner
## the blend takes away, swept along the edge a little past its ends, is
## subtracted. A chamfer's tool is the triangle between the edge and the
## points `distance` along each face; a fillet's is the region between the
## edge and the circle of `radius` touching both faces (its center where a
## ball of that radius rolls). Chamfered corners where edges meet follow
## from the booleans; fillets meeting at a corner need cylinders crossing at
## an angle, which booleans do not support yet. Convex edges only.

## The unit direction across face `f` from the middle of edge `e`, into the
## face, perpendicular to the edge.
func into_face(w: const Shape*, f: usize, e: usize, along: Vector3) -> Vector3!:
    let middle = try w.edge_at(e, 0.5)
    let n = try w.face_normal(f, middle)
    let side = try n.cross(along).normalized()
    let reach = math.max((try w.edge_at(e, 0.0)).subtract(try w.edge_at(e, 1.0)).length(), (try w.edge_at(e, 0.0)).subtract(middle).length()) * 0.01
    if try face_contains(w, f, middle.add(side.multiply_scalar(reach)), w.tolerance) == inside_face: return side
    return side.multiply_scalar(-1.0)

## The unit direction along edge `e` at its middle.
func along_edge(w: const Shape*, e: usize) -> Vector3!:
    let edge = w.edges.items[e]
    let t = (edge.t0 + edge.t1) * 0.5
    return try (try w.tangent(edge.carrier, t)).multiply_scalar(1.0 if edge.t1 > edge.t0 else -1.0).normalized()

## A full circle between a flat face across its axis and a cylinder about
## it (a hole's rim, a boss's edge).
func is_rim(w: const Shape*, e: usize, fa: usize, fb: usize) -> bool:
    let edge = w.edges.items[e]
    let c = w.carriers.items[(usize)edge.carrier]
    if c.kind != 1 or edge.start != edge.end: return false
    let axis = c.x.cross(c.y)
    let sa = w.surfaces.items[(usize)w.faces.items[fa].surface]
    let sb = w.surfaces.items[(usize)w.faces.items[fb].surface]
    let plane = sa if sa.kind == 0 else sb
    let cylinder = sb if sa.kind == 0 else sa
    if plane.kind != 0 or cylinder.kind != 1: return false
    if math.abs(math.abs(plane.z.dot(axis)) - 1.0) > 1e-9 or math.abs(math.abs(cylinder.z.dot(axis)) - 1.0) > 1e-9: return false
    let offset = c.origin.subtract(cylinder.origin)
    return offset.subtract(cylinder.z.multiply_scalar(offset.dot(cylinder.z))).length() < c.a * 1e-6 and math.abs(cylinder.radius - c.a) < c.a * 1e-6

## Whether edge `e` can be blended: a line between two planar faces, or a
## rim (is_rim), convex (the faces turn away from each other).
func blendable(w: const Shape*, e: usize) -> bool!:
    let edge = w.edges.items[e]
    let kind = w.carriers.items[(usize)edge.carrier].kind
    if kind != 0 and kind != 1: return false
    # A seam (one face's both ways) is no edge between two faces.
    let (fa, fb) = edge_faces(w, e) catch failure:
        _ = failure
        return false
    if kind == 1:
        if not is_rim(w, e, fa, fb): return false
    elif w.surfaces.items[(usize)w.faces.items[fa].surface].kind != 0 or w.surfaces.items[(usize)w.faces.items[fb].surface].kind != 0: return false
    let along = try along_edge(w, e)
    let ua = try into_face(w, fa, e, along)
    let ub = try into_face(w, fb, e, along)
    # Convex: the other face runs below this one's outward normal.
    return ub.dot(try w.face_normal(fa, try w.edge_at(e, 0.5))) < -1e-9 and ua.cross(ub).length() > 1e-9

## The tool that blends edge `e` from `start` to `end` (its chain's ends),
## a fillet of `size` radius when `round`, else a chamfer `size` along each
## face, as a closed solid.
## `body` is the solid's mesh: the tool reaches past an end only where
## nothing is there (an outside corner), and stops flush where the solid
## goes on (a wall the edge runs into).
## Its blend face is named `name`.
func edge_tool(w: const Shape*, e: usize, size: f64, round: bool, start: Vector3, end: Vector3, body: const Mesh*, name: str) -> interop.Reference[CadModel]!:
    if w.carriers.items[(usize)w.edges.items[e].carrier].kind == 1: return try rim_tool(w, e, size, round, name)
    let length = end.subtract(start).length()
    let along = try end.subtract(start).normalized()
    let (fa, fb) = try edge_faces(w, e)
    let ua = try into_face(w, fa, e, along)
    let ub = try into_face(w, fb, e, along)
    let angle = math.acos(math.clamp(ua.dot(ub), -1.0, 1.0))
    # Past each end by a margin, where the corner beyond is empty.
    let margin = size * 2.0 + length * 0.01
    let corner = try ua.add(ub).normalized().multiply_scalar(size * 0.25)
    let extent = math.max(length, size) * 4.0
    let before = 0.0 if try inside_mesh(body, start.subtract(along.multiply_scalar(size * 0.5)).add(corner), extent) else margin
    let after = 0.0 if try inside_mesh(body, end.add(along.multiply_scalar(size * 0.5)).add(corner), extent) else margin
    let p = start.subtract(along.multiply_scalar(before))
    var reach = size
    if round: reach = size / math.tan(angle * 0.5)
    let ta = p.add(ua.multiply_scalar(reach))
    let tb = p.add(ub.multiply_scalar(reach))
    let u = ua
    let v = along.cross(ua)
    var profile = Profiles(p, along, u, v, Growing[ProfileEdge](), Growing[usize](), Growing[usize](), Growing[usize](),
                           Growing[ProfileSpline](), Growing[Vector3](), Growing[f64](), Growing[f64]())
    defer profile.close()
    try profile.loop_offsets.push(0)
    try profile.edges.push(line_edge(p, ta))
    if round:
        let bisector = try ua.add(ub).normalized()
        let center = p.add(bisector.multiply_scalar(size / math.sin(angle * 0.5)))
        let leaving = ta.subtract(center)
        let arriving = tb.subtract(center)
        let sweep = math.atan2(along.dot(leaving.cross(arriving)), leaving.dot(arriving))
        try profile.edges.push(ProfileEdge(1, ta, tb, center, size, sweep, -1))
    else:
        try profile.edges.push(line_edge(ta, tb))
    try profile.edges.push(line_edge(tb, p))
    try profile.loop_offsets.push(profile.edges.count)
    try nest(&profile)
    let solid = try new_solid(length + margin * 2.0)
    defer solid.release()
    try extrude_into(solid.value(), &profile, length + before + after, "")
    try name_tool(solid.value(), name)
    return try model_of(solid)

## A tool's faces: the one its corner profile's middle edge made (the
## profile's order survives nesting: three edges reversed keep their
## middle) is the blend, named `name`; the rest go with the corner and
## stay unnamed.
func name_tool(b: BrepModel*, name: str) -> !:
    for face in 0..<b.face_count():
        try b.set_face_name(face, name if face == 1 else "")

## A rim's tool: the corner profile at its middle (a triangle `size` along
## each face, or the region between them and the circle of radius `size`
## touching both) turned about the rim's axis: a cone, or a torus.
func rim_tool(w: const Shape*, e: usize, size: f64, round: bool, name: str) -> interop.Reference[CadModel]!:
    let carrier = w.carriers.items[(usize)w.edges.items[e].carrier]
    let (fa, fb) = try edge_faces(w, e)
    let along = try along_edge(w, e)
    let p = try w.edge_at(e, 0.5)
    let ua = try into_face(w, fa, e, along)
    let ub = try into_face(w, fb, e, along)
    let angle = math.acos(math.clamp(ua.dot(ub), -1.0, 1.0))
    var reach = size
    if round: reach = size / math.tan(angle * 0.5)
    let ta = p.add(ua.multiply_scalar(reach))
    let tb = p.add(ub.multiply_scalar(reach))
    var profile = Profiles(p, along, ua, along.cross(ua), Growing[ProfileEdge](), Growing[usize](), Growing[usize](), Growing[usize](),
                           Growing[ProfileSpline](), Growing[Vector3](), Growing[f64](), Growing[f64]())
    defer profile.close()
    try profile.loop_offsets.push(0)
    try profile.edges.push(line_edge(p, ta))
    if round:
        let bisector = try ua.add(ub).normalized()
        let center = p.add(bisector.multiply_scalar(size / math.sin(angle * 0.5)))
        let leaving = ta.subtract(center)
        let arriving = tb.subtract(center)
        let sweep = math.atan2(along.dot(leaving.cross(arriving)), leaving.dot(arriving))
        try profile.edges.push(ProfileEdge(1, ta, tb, center, size, sweep, -1))
    else:
        try profile.edges.push(line_edge(ta, tb))
    try profile.edges.push(line_edge(tb, p))
    try profile.loop_offsets.push(profile.edges.count)
    try nest(&profile)
    let solid = try new_solid(carrier.a + size * 4.0)
    defer solid.release()
    try revolve_into(solid.value(), &profile, carrier.origin, carrier.x.cross(carrier.y), (carrier.a + size) * 1e-7, "")
    try name_tool(solid.value(), name)
    return try model_of(solid)

## `model` with the edges `references` refers to (references.lucb; empty:
## every straight convex edge between two planes) blended: filleted to
## `size` when `round`, else chamfered `size` along each face. The blend
## faces are named for feature `tag`.
pub func blended(model: const CadModel*, references: str, size: f64, round: bool, tag: str) -> interop.Reference[CadModel]!:
    if not math.is_finite(size) or size <= 0.0: error(invalid, "a blend needs a positive size")
    var w = try shape_of(model)
    defer w.close()
    var chosen = Growing[usize]()
    defer chosen.close()
    let every = trimmed(references) == ""
    if every:
        # Every straight edge between flat faces; rims only when named.
        for e in 0..<w.edges.count:
            if w.carriers.items[(usize)w.edges.items[e].carrier].kind == 0 and try blendable(&w, e): try chosen.push(e)
    else:
        try resolve_edges(&w, references, &chosen)
        for e in chosen.view():
            if not try blendable(&w, e): error(invalid, "only convex straight edges between flat faces, and rims (a circle between a flat face and a cylinder about it), can be blended yet")
    if chosen.count == 0: error(invalid, "the body has no edges to blend")
    # Every edge of a convex polyhedron rounded: built whole.
    if round and every:
        if let whole = try rounded_polyhedron(&w, size, tag): return whole
    if round:
        # Fillets meeting at a corner at an angle need a corner patch (a
        # sphere where three meet), which is not made yet.
        for i in 0..<chosen.count:
            for j in i + 1..<chosen.count:
                let a = w.edges.items[chosen.items[i]]
                let b = w.edges.items[chosen.items[j]]
                let touching = a.start == b.start or a.start == b.end or a.end == b.start or a.end == b.end
                if touching and not try same_curve(&w, a.carrier, chosen.items[j], w.tolerance):
                    error(invalid, "fillets meeting at a corner are not supported yet: fillet edges that do not meet, or chamfer them")
    let body = try model.tessellate(16)
    defer body.release()
    var tools = Growing[interop.Reference[CadModel]]()
    defer:
        for tool in tools.view(): tool.release()
        tools.close()
    # Collinear chosen edges between the same two faces (one edge cut into
    # pieces by earlier operations) are one chain: one tool spans them.
    var done = Growing[bool]()
    defer done.close()
    for _ in chosen.view(): try done.push(false)
    var name = Growing[u8]()
    defer name.close()
    for i in 0..<chosen.count:
        if done.items[i]: continue
        done.items[i] = true
        let e = chosen.items[i]
        var low = try w.edge_at(e, 0.0)
        var high = try w.edge_at(e, 1.0)
        try blend_name(&w, e, tag, &name)
        # A rim is its own tool.
        if w.carriers.items[(usize)w.edges.items[e].carrier].kind != 0:
            try tools.push(try edge_tool(&w, e, size, round, low, high, body.value(), (str)name.view()))
            continue
        let (fa, fb) = try edge_faces(&w, e)
        let along = try high.subtract(low).normalized()
        for j in i + 1..<chosen.count:
            if done.items[j]: continue
            let other = chosen.items[j]
            if not try same_curve(&w, w.edges.items[e].carrier, other, w.tolerance): continue
            let (ga, gb) = try edge_faces(&w, other)
            if not ((ga == fa and gb == fb) or (ga == fb and gb == fa)): continue
            done.items[j] = true
            for k in 0..<2:
                let p = try w.edge_at(other, (f64)k)
                if p.subtract(low).dot(along) < 0.0: low = p
                if p.subtract(high).dot(along) > 0.0: high = p
        try tools.push(try edge_tool(&w, e, size, round, low, high, body.value(), (str)name.view()))
    var result = try copy_model(model)
    for tool in tools.view():
        let next = combine(result.value(), tool.value(), op_subtract) catch failure:
            result.release()
            error(failure.code, failure.message)
        result.release()
        result = next
    return result

## The name of edge `e`'s blend, `tag/blend[A&B]`, into `out` (empty
## when its faces have no names).
func blend_name(w: const Shape*, e: usize, tag: str, out: Growing[u8]*) -> !:
    out.clear()
    let (fa, fb) = try edge_faces(w, e)
    if w.face_name(fa) == "" or w.face_name(fb) == "": return
    try role_name(out, tag, "blend[")
    try edge_name(w, e, out)
    try out.push(93)

## A new reference to `model`'s B-rep, placed as it is.
func copy_model(model: const CadModel*) -> interop.Reference[CadModel]!:
    var w = try shape_of(model)
    defer w.close()
    let b = try brep_of(&w)
    defer b.release()
    return try model_of(b)

## Every edge of a convex polyhedron (flat faces of one loop, straight
## convex edges) filleted to `radius`, built whole rather than by booleans:
## the solid shrunk by the radius and grown back by a ball (a Minkowski
## sum). Each face keeps its plane, its corners moved in; each edge becomes
## a cylinder about the shrunk edge; each corner a sphere about the shrunk
## vertex, bounded by its edges' arcs. None when the solid is not such a
## polyhedron (or the radius consumes a face).
func rounded_polyhedron(w: const Shape*, radius: f64, tag: str) -> interop.Reference[CadModel]?!:
    for f in 0..<w.faces.count:
        if w.surfaces.items[(usize)w.faces.items[f].surface].kind != 0 or w.face_sizes(f).length != 1: return none
    for e in 0..<w.edges.count:
        if not try blendable(w, e): return none
    # Each vertex's faces, and its shrunk position: the faces' planes moved
    # in by the radius meet there.
    let count = w.points.count
    var centers = Growing[Vector3]()
    defer centers.close()
    for v in 0..<count:
        var normals = Growing[Vector3]()
        defer normals.close()
        var offsets = Growing[f64]()
        defer offsets.close()
        for f in 0..<w.faces.count:
            var touches = false
            for use in w.face_uses(f):
                let edge = w.edges.items[(usize)((use if use > 0 else -use) - 1)]
                if edge.start == (i64)v or edge.end == (i64)v: touches = true
            if not touches: continue
            let s = w.surfaces.items[(usize)w.faces.items[f].surface]
            let n = s.z if w.faces.items[f].sense else s.z.multiply_scalar(-1.0)
            try normals.push(n)
            try offsets.push(n.dot(s.origin) - radius)
        if normals.count < 3: return none
        try centers.push(try least_squares_point(normals.view(), offsets.view()))
    let solid = try new_solid(radius * 100.0)
    defer solid.release()
    let b = solid.value()
    # Contact points: vertex v on face f at center + normal * radius, made
    # once per (vertex, face).
    var contact_keys = Growing[i64]()
    defer contact_keys.close()
    var contact_ids = Growing[i64]()
    defer contact_ids.close()
    # Lines along each face's side of each edge, and arcs at each end of
    # each edge, made once, by key.
    var curve_keys = Growing[i64]()
    defer curve_keys.close()
    var curve_ids = Growing[i64]()
    defer curve_ids.close()
    let faces = (i64)w.faces.count
    let edges = (i64)w.edges.count
    var name = Growing[u8]()
    defer name.close()
    for f in 0..<w.faces.count:
        let s = w.surfaces.items[(usize)w.faces.items[f].surface]
        let n = s.z if w.faces.items[f].sense else s.z.multiply_scalar(-1.0)
        var uses = Growing[i64]()
        defer uses.close()
        for use in w.face_uses(f):
            let e = (use if use > 0 else -use) - 1
            let edge = w.edges.items[(usize)e]
            let from_vertex = edge.start if use > 0 else edge.end
            let to_vertex = edge.end if use > 0 else edge.start
            let a = try contact(b, &contact_keys, &contact_ids, centers.view(), from_vertex * faces + (i64)f, from_vertex, n, radius)
            let z = try contact(b, &contact_keys, &contact_ids, centers.view(), to_vertex * faces + (i64)f, to_vertex, n, radius)
            let line = try b.add_line(a, z)
            try curve_keys.push(e * faces + (i64)f)
            try curve_ids.push(line)
            try uses.push(line + 1)
        let sizes: i64[1] = [(i64)uses.count]
        let (corner, unused) = try edge_ends(b, uses.items[0] - 1)
        _ = unused
        let plane = try b.add_surface(0, try b.vertex_at(corner), n, s.x)
        let face = try b.add_face(plane, uses.view(), sizes[..<1], true)
        try b.set_face_name(face, w.face_name(f))
    # Each edge: a cylinder band between its two faces' lines and its arcs.
    for e in 0..<w.edges.count:
        let edge = w.edges.items[e]
        let (fa, fb) = try edge_faces(w, e)
        # fa uses the edge forward (start to end), fb backward.
        var forward_face = fa
        var backward_face = fb
        for use in w.face_uses(fb):
            if use == (i64)e + 1:
                forward_face = fb
                backward_face = fa
        let na = face_outward(w, forward_face)
        let nb = face_outward(w, backward_face)
        let v = edge.start
        let u = edge.end
        let cv = centers.items[(usize)v]
        let cu = centers.items[(usize)u]
        let pa_v = try contact(b, &contact_keys, &contact_ids, centers.view(), v * faces + (i64)forward_face, v, na, radius)
        let pa_u = try contact(b, &contact_keys, &contact_ids, centers.view(), u * faces + (i64)forward_face, u, na, radius)
        let pb_v = try contact(b, &contact_keys, &contact_ids, centers.view(), v * faces + (i64)backward_face, v, nb, radius)
        let pb_u = try contact(b, &contact_keys, &contact_ids, centers.view(), u * faces + (i64)backward_face, u, nb, radius)
        let line_a = try find_curve(&curve_keys, &curve_ids, (i64)e * faces + (i64)forward_face)
        let line_b = try find_curve(&curve_keys, &curve_ids, (i64)e * faces + (i64)backward_face)
        # Arcs at each end, from the forward face's contact to the backward's.
        let arc_v = try short_arc(b, pa_v, pb_v, cv, radius)
        let arc_u = try short_arc(b, pa_u, pb_u, cu, radius)
        try curve_keys.push(-(((i64)e * 2) + 1))
        try curve_ids.push(arc_v)
        try curve_keys.push(-(((i64)e * 2) + 2))
        try curve_ids.push(arc_u)
        # The band: the forward face's line backward (u to v), the arc at v,
        # the backward face's line (v to u, as that face runs it backward),
        # the arc at u back.
        let axis = try cu.subtract(cv).normalized()
        let cylinder = try b.add_surface(1, cv, axis, (try b.vertex_at(pa_v)).subtract(cv), radius)
        let uses: i64[4] = [-(line_a + 1), arc_v + 1, -(line_b + 1), -(arc_u + 1)]
        let sizes: i64[1] = [4]
        let band = try b.add_face(cylinder, uses[..<4], sizes[..<1], true)
        try blend_name(w, e, tag, &name)
        try b.set_face_name(band, (str)name.view())
    # Each vertex: a sphere patch bounded by its edges' arcs, each run the
    # other way than its band runs it, chained into a loop.
    for v in 0..<count:
        var pieces = Growing[i64]()
        defer pieces.close()
        for e in 0..<w.edges.count:
            let edge = w.edges.items[e]
            if edge.start == (i64)v: try pieces.push(-(try find_curve(&curve_keys, &curve_ids, -(((i64)e * 2) + 1)) + 1))
            if edge.end == (i64)v: try pieces.push(try find_curve(&curve_keys, &curve_ids, -(((i64)e * 2) + 2)) + 1)
        var chained = Growing[i64]()
        defer chained.close()
        try chain_uses(b, pieces.view(), &chained)
        let center = centers.items[(usize)v]
        # Poles across the patch (its axis square to the way it faces).
        let (first_start, first_end) = try edge_ends(b, (chained.items[0] if chained.items[0] > 0 else -chained.items[0]) - 1)
        let facing = try (try b.vertex_at(first_start if chained.items[0] > 0 else first_end)).subtract(center).normalized()
        let pole = try facing.cross(Vector3(0.0, 0.0, 1.0) if math.abs(facing.z) < 0.9 else Vector3(1.0, 0.0, 0.0)).normalized()
        let sphere = try b.add_surface(4, center, pole, facing, radius)
        let sizes: i64[1] = [(i64)chained.count]
        let patch = try b.add_face(sphere, chained.view(), sizes[..<1], true)
        try corner_name(w, v, tag, &name)
        try b.set_face_name(patch, (str)name.view())
    _ = edges
    return try model_of(solid)

## The name of the corner at vertex `v`, `tag/corner[A&B&C]` (its faces'
## names, sorted), into `out`.
func corner_name(w: const Shape*, v: usize, tag: str, out: Growing[u8]*) -> !:
    var names = Growing[str]()
    defer names.close()
    for f in 0..<w.faces.count:
        for use in w.face_uses(f):
            let edge = w.edges.items[(usize)((use if use > 0 else -use) - 1)]
            if edge.start != (i64)v and edge.end != (i64)v: continue
            var known = false
            for other in names.view():
                if other == w.face_name(f): known = true
            if not known: try names.push(w.face_name(f))
    for i in 1..<names.count:
        let value = names.items[i]
        var j = i
        while j > 0 and text_before(value, names.items[j - 1]):
            names.items[j] = names.items[j - 1]
            j -= 1
        names.items[j] = value
    try role_name(out, tag, "corner[")
    for at in 0..<names.count:
        if at > 0: try out.push(face_separator)
        try push_text(out, names.items[at])
    try out.push(93)

## A vertex's outward-facing face normal of face `f`.
func face_outward(w: const Shape*, f: usize) -> Vector3:
    let s = w.surfaces.items[(usize)w.faces.items[f].surface]
    return s.z if w.faces.items[f].sense else s.z.multiply_scalar(-1.0)

## The point where `normals` . x = `offsets` best (exact for three planes).
func least_squares_point(normals: const Vector3[], offsets: const f64[]) -> Vector3!:
    # The normal equations, a 3x3 solved by Cramer's rule.
    var m: f64[9]
    for k in 0..<(usize)9: m[k] = 0.0
    var r = Vector3()
    for i in 0..<normals.length:
        let n = normals[i]
        m[0] += n.x * n.x
        m[1] += n.x * n.y
        m[2] += n.x * n.z
        m[4] += n.y * n.y
        m[5] += n.y * n.z
        m[8] += n.z * n.z
        r = r.add(n.multiply_scalar(offsets[i]))
    m[3] = m[1]
    m[6] = m[2]
    m[7] = m[5]
    let a = Vector3(m[0], m[3], m[6])
    let b = Vector3(m[1], m[4], m[7])
    let c = Vector3(m[2], m[5], m[8])
    let det = a.dot(b.cross(c))
    if math.abs(det) < 1e-300: error(invalid, "a corner's faces do not meet in a point")
    return Vector3(r.dot(b.cross(c)) / det, a.dot(r.cross(c)) / det, a.dot(b.cross(r)) / det)

## The vertex of vertex `v`'s contact with the face of normal `n` (key
## `key`), made once.
func contact(b: BrepModel*, keys: Growing[i64]*, ids: Growing[i64]*, centers: const Vector3[], key: i64, v: i64, n: Vector3, radius: f64) -> i64!:
    for at in 0..<keys.count:
        if keys.items[at] == key: return ids.items[at]
    let id = try b.add_vertex(centers[(usize)v].add(n.multiply_scalar(radius)))
    try keys.push(key)
    try ids.push(id)
    return id

func find_curve(keys: const Growing[i64]*, ids: const Growing[i64]*, key: i64) -> i64!:
    for at in 0..<keys.count:
        if keys.items[at] == key: return ids.items[at]
    error(invalid, "a rounded corner lost one of its curves")

## The shorter arc of the circle about `center` from vertex `a` to `z`.
func short_arc(b: BrepModel*, a: i64, z: i64, center: Vector3, radius: f64) -> i64!:
    let pa = (try b.vertex_at(a)).subtract(center)
    let pz = (try b.vertex_at(z)).subtract(center)
    let axis = try pa.cross(pz).normalized()
    return try b.add_circle(a, z, center, axis, pa, radius, true)

## Edge `e` of `b`'s start and end vertices.
func edge_ends(b: const BrepModel*, e: i64) -> (i64, i64)!:
    var record = try b.edge_record(e)
    defer record.close()
    return (record.start, record.end)

## Signed edge uses chained end to start into one loop onto `out`.
func chain_uses(b: const BrepModel*, uses: const i64[], out: Growing[i64]*) -> !:
    out.clear()
    if uses.length == 0: error(invalid, "a rounded corner has no arcs")
    var taken = Growing[bool]()
    defer taken.close()
    for _ in uses: try taken.push(false)
    taken.items[0] = true
    try out.push(uses[0])
    for _ in 1..<uses.length:
        let last = out.items[out.count - 1]
        let (ls, le) = try edge_ends(b, (last if last > 0 else -last) - 1)
        let at_vertex = le if last > 0 else ls
        var found = false
        for k in 0..<uses.length:
            if taken.items[k]: continue
            let (s0, e0) = try edge_ends(b, (uses[k] if uses[k] > 0 else -uses[k]) - 1)
            if (s0 if uses[k] > 0 else e0) == at_vertex:
                taken.items[k] = true
                try out.push(uses[k])
                found = true
                break
        if not found: error(invalid, "a rounded corner's arcs do not close")
