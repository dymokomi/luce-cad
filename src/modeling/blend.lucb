## Chamfers and fillets of straight edges between two planar faces (the
## first rows of OpenCASCADE's ChFiKPart table: plane/plane gives a plane or
## a cylinder), made with booleans: for each edge a tool solid, the corner
## the blend takes away, swept along the edge a little past its ends, is
## subtracted. A chamfer's tool is the triangle between the edge and the
## points `distance` along each face; a fillet's is the region between the
## edge and the circle of `radius` touching both faces (its center where a
## ball of that radius rolls). Chamfered corners where edges meet follow
## from the booleans; fillets meeting at corners are corners.lucb's, and
## every edge of a convex polyhedron is rounded whole (rounded.lucb).
## Convex edges only.

## The unit direction across face `f` from the middle of edge `e`, into the
## face, perpendicular to the edge.
func into_face(w: const Shape*, f: usize, e: usize, along: Vector3) -> Vector3!:
    let middle = try w.edge_at(e, 0.5)
    let n = try w.face_normal(f, middle)
    let side = try n.cross(along).normalized()
    let reach = math.max((try w.edge_at(e, 0.0)).subtract(try w.edge_at(e, 1.0)).length(), (try w.edge_at(e, 0.0)).subtract(middle).length()) * 0.01
    if try face_contains(w, f, middle.add(side.multiply_scalar(reach)), w.tolerance) == inside_face: return side
    return side.multiply_scalar(-1.0)

## The unit direction along edge `e` at its middle.
func along_edge(w: const Shape*, e: usize) -> Vector3!:
    let edge = w.edges.items[e]
    let t = (edge.t0 + edge.t1) * 0.5
    return try (try w.tangent(edge.carrier, t)).multiply_scalar(1.0 if edge.t1 > edge.t0 else -1.0).normalized()

## A circle, or an arc of one, between a flat face across its axis and a
## cylinder or cone about it (a hole's rim, a boss's edge, the edge around
## an earlier fillet, a countersink's rim).
func is_rim(w: const Shape*, e: usize, fa: usize, fb: usize) -> bool:
    let edge = w.edges.items[e]
    let c = w.carriers.items[(usize)edge.carrier]
    if c.kind != 1: return false
    let axis = c.x.cross(c.y)
    let sa = w.surfaces.items[(usize)w.faces.items[fa].surface]
    let sb = w.surfaces.items[(usize)w.faces.items[fb].surface]
    let plane = sa if sa.kind == 0 else sb
    let round = sb if sa.kind == 0 else sa
    if plane.kind != 0 or (round.kind != 1 and round.kind != 2): return false
    if math.abs(math.abs(plane.z.dot(axis)) - 1.0) > 1e-9 or math.abs(math.abs(round.z.dot(axis)) - 1.0) > 1e-9: return false
    # On the cylinder or cone, about its axis: its radius there is the
    # circle's (a cone's along its height).
    let offset = c.origin.subtract(round.origin)
    let height = offset.dot(round.z)
    let radius = round.radius + (height * math.tan(round.angle) if round.kind == 2 else 0.0)
    return offset.subtract(round.z.multiply_scalar(height)).length() < c.a * 1e-6 and math.abs(radius - c.a) < c.a * 1e-6

## Whether edge `e` can be blended: a line between two planar faces, or a
## rim (is_rim), convex or concave but not flat.
func blendable(w: const Shape*, e: usize) -> bool!:
    let edge = w.edges.items[e]
    let kind = w.carriers.items[(usize)edge.carrier].kind
    if kind != 0 and kind != 1: return false
    # A seam (one face's both ways) is no edge between two faces.
    let (fa, fb) = edge_faces(w, e) catch failure:
        _ = failure
        return false
    if kind == 1:
        if not is_rim(w, e, fa, fb): return false
    elif not flat_pair(w, fa, fb) and ruled_pair(w, e, fa, fb) < 0: return false
    let along = try along_edge(w, e)
    let ua = try into_face(w, fa, e, along)
    let ub = try into_face(w, fb, e, along)
    return ua.cross(ub).length() > 1e-9

func flat_pair(w: const Shape*, fa: usize, fb: usize) -> bool:
    return w.surfaces.items[(usize)w.faces.items[fa].surface].kind == 0 and w.surfaces.items[(usize)w.faces.items[fb].surface].kind == 0

## Of a straight edge `e` between a plane and a cylinder along it (a
## D-shaft's flat, a slot's side meeting its round end), the cylinder's
## face (fa or fb); -1 when it is not one.
func ruled_pair(w: const Shape*, e: usize, fa: usize, fb: usize) -> i64:
    let sa = w.surfaces.items[(usize)w.faces.items[fa].surface]
    let sb = w.surfaces.items[(usize)w.faces.items[fb].surface]
    var cylinder: i64 = -1
    if sa.kind == 0 and sb.kind == 1: cylinder = (i64)fb
    elif sa.kind == 1 and sb.kind == 0: cylinder = (i64)fa
    else: return -1
    let c = w.surfaces.items[(usize)w.faces.items[(usize)cylinder].surface]
    let edge = w.edges.items[e]
    let direction = w.carriers.items[(usize)edge.carrier].x
    if c.z.cross(direction).length() > 1e-9: return -1
    return cylinder

## The section of edge `e`'s blend at `p` (its start), swept along `along`:
## the corner profile between two planes, or between a plane and a
## cylinder along the edge (ruled_profile).
func section_profile(w: const Shape*, e: usize, p: Vector3, along: Vector3, size: f64, round: bool, continuity: i64) -> Profiles!:
    let (fa, fb) = try edge_faces(w, e)
    let ua = try into_face(w, fa, e, along)
    let ub = try into_face(w, fb, e, along)
    let cylinder = ruled_pair(w, e, fa, fb)
    if cylinder < 0: return try corner_profile(p, along, ua, ub, size, round, continuity)
    if round and continuity > 1: error(invalid, "G2 and G3 fillets between a plane and a cylinder are not supported yet")
    let plane = fb if (usize)cylinder == fa else fa
    return try ruled_profile(w, plane, (usize)cylinder, p, along, ua if plane == fa else ub, ub if plane == fa else ua, size, round, try convex(w, e))

## The section of a blend between plane face `plane` and cylinder face
## `cylinder` (its axis along the edge), at edge point `p`: the region
## between the edge, the contacts and the blend (a fillet's circle touching
## the plane and the cylinder, its center where the plane and the cylinder
## moved by the radius meet; a chamfer's line `size` along each), closed
## back along the cylinder's own circle. `into_plane` and `into_round` are
## the directions into each face from the edge.
func ruled_profile(w: const Shape*, plane: usize, cylinder: usize, p: Vector3, along: Vector3, into_plane: Vector3, into_round: Vector3, size: f64, round: bool, outward: bool) -> Profiles!:
    let s = w.surfaces.items[(usize)w.faces.items[cylinder].surface]
    let axis_point = s.origin.add(s.z.multiply_scalar(p.subtract(s.origin).dot(s.z)))
    let radius = s.radius
    let (ta, tb, center) = try ruled_contacts(w, plane, cylinder, p, into_plane, into_round, size, round, outward)
    var profile = Profiles(p, along, into_plane, along.cross(into_plane), Growing[ProfileEdge](), Growing[usize](), Growing[usize](), Growing[usize](),
                           Growing[ProfileSpline](), Growing[Vector3](), Growing[f64](), Growing[f64]())
    errdefer profile.close()
    try profile.loop_offsets.push(0)
    try profile.edges.push(line_edge(p, ta))
    if round:
        let leaving = ta.subtract(center)
        let arriving = tb.subtract(center)
        try profile.edges.push(ProfileEdge(1, ta, tb, center, size, math.atan2(along.dot(leaving.cross(arriving)), leaving.dot(arriving)), -1))
    else:
        try profile.edges.push(line_edge(ta, tb))
    let back = tb.subtract(axis_point)
    let home = p.subtract(axis_point)
    try profile.edges.push(ProfileEdge(1, tb, p, axis_point, radius, math.atan2(along.dot(back.cross(home)), back.dot(home)), -1))
    try profile.loop_offsets.push(profile.edges.count)
    try nest(&profile)
    return profile

## A plane/cylinder blend's contacts at edge point `p`: on the plane, on
## the cylinder, and a fillet's center (see ruled_profile).
func ruled_contacts(w: const Shape*, plane: usize, cylinder: usize, p: Vector3, into_plane: Vector3, into_round: Vector3, size: f64, round: bool, outward: bool) -> (Vector3, Vector3, Vector3)!:
    let s = w.surfaces.items[(usize)w.faces.items[cylinder].surface]
    let axis_point = s.origin.add(s.z.multiply_scalar(p.subtract(s.origin).dot(s.z)))
    let radius = s.radius
    let n_plane = face_outward_at(w, plane, p)
    # Away from the axis, the cylinder's outward normal at p, or toward it.
    let away = (try w.face_normal(cylinder, p)).dot(p.subtract(axis_point)) > 0.0
    var ta = Vector3()
    var tb = Vector3()
    var center = Vector3()
    if round:
        # The center: `size` from the plane (inside an outside corner, in
        # the air at an inside one), the cylinder's radius moved likewise.
        let toward = n_plane.multiply_scalar(-size if outward else size)
        let moved = radius - size if outward == away else radius + size
        if moved <= 0.0: error(invalid, "a fillet radius is larger than the cylinder it meets allows")
        let q = p.add(toward).subtract(axis_point)
        let b = q.dot(into_plane)
        let disc = b * b - (q.dot(q) - moved * moved)
        if disc < 0.0: error(invalid, "a fillet this large finds no circle touching both faces")
        let spread = math.sqrt(disc)
        # The nearer place along the plane into its face.
        var t = -b - spread
        if t <= 0.0: t = -b + spread
        center = p.add(toward).add(into_plane.multiply_scalar(t))
        ta = center.subtract(toward)
        tb = axis_point.add(try center.subtract(axis_point).normalized().multiply_scalar(radius))
    else:
        ta = p.add(into_plane.multiply_scalar(size))
        # `size` along the cylinder's circle, the way into its face.
        let r0 = p.subtract(axis_point)
        let turn = 1.0 if s.z.cross(r0).dot(into_round) > 0.0 else -1.0
        tb = axis_point.add(turned_direction(r0, s.z, turn * size / radius))
    return (ta, tb, center)

func face_outward_at(w: const Shape*, f: usize, p: Vector3) -> Vector3:
    return w.face_normal(f, p) catch failure:
        _ = failure
        recover Vector3()

## Whether edge `e`'s faces turn away from each other (the other face runs
## below this one's outward normal): a blend takes material away there.
## Concave edges (an inside corner) are blended by adding it.
func convex(w: const Shape*, e: usize) -> bool!:
    let (fa, fb) = try edge_faces(w, e)
    let ub = try into_face(w, fb, e, try along_edge(w, e))
    return ub.dot(try w.face_normal(fa, try w.edge_at(e, 0.5))) < 0.0

## The tool that blends edge `e` from `start` to `end` (its chain's ends),
## a fillet of `size` radius when `round`, else a chamfer `size` along each
## face, as a closed solid.
## `body` is the solid's mesh: the tool reaches past an end only where
## nothing is there (an outside corner), and stops flush where the solid
## goes on (a wall the edge runs into).
## An end marked exact (where a corner ball takes over) stops right there.
## Its blend face is named `name`.
func edge_tool(w: const Shape*, e: usize, size: f64, round: bool, continuity: i64, start: Vector3, end: Vector3, exact_start: bool, exact_end: bool, body: const Mesh*, name: str) -> interop.Reference[CadModel]!:
    if w.carriers.items[(usize)w.edges.items[e].carrier].kind == 1: return try rim_tool(w, e, size, round, continuity, exact_start, exact_end, body, name)
    let length = end.subtract(start).length()
    let along = try end.subtract(start).normalized()
    let (fa, fb) = try edge_faces(w, e)
    let ua = try into_face(w, fa, e, along)
    let ub = try into_face(w, fb, e, along)
    # Past each end by a margin, where the corner beyond is empty.
    let margin = size * 2.0 + length * 0.01
    let corner = try ua.add(ub).normalized().multiply_scalar(size * 0.25)
    let extent = math.max(length, size) * 4.0
    let before = 0.0 if exact_start or try inside_mesh(body, start.subtract(along.multiply_scalar(size * 0.5)).add(corner), extent) else margin
    let after = 0.0 if exact_end or try inside_mesh(body, end.add(along.multiply_scalar(size * 0.5)).add(corner), extent) else margin
    var profile = try section_profile(w, e, start.subtract(along.multiply_scalar(before)), along, size, round, continuity)
    defer profile.close()
    let solid = try new_solid(length + margin * 2.0)
    defer solid.release()
    try extrude_into(solid.value(), &profile, length + before + after, "")
    try name_tool(solid.value(), name)
    return try model_of(solid)

## The corner profile at `p` on an edge running `along`, between its faces'
## directions `ua` and `ub` (into each face): a chamfer's triangle `size`
## along each, or a fillet's region between them and its curve. A fillet of
## continuity 1 (G1) is the circle of radius `size` touching both faces; of
## 2 or 3 (G2, G3) a Bezier curve between the same contact points whose
## first three or four control points lie along each face, so its
## curvature (and for G3 its change) is zero where it meets them. Its
## middle edge is the blend's.
func corner_profile(p: Vector3, along: Vector3, ua: Vector3, ub: Vector3, size: f64, round: bool, continuity: i64) -> Profiles!:
    let angle = math.acos(math.clamp(ua.dot(ub), -1.0, 1.0))
    let reach = size / math.tan(angle * 0.5) if round else size
    let ta = p.add(ua.multiply_scalar(reach))
    let tb = p.add(ub.multiply_scalar(reach))
    var profile = Profiles(p, along, ua, along.cross(ua), Growing[ProfileEdge](), Growing[usize](), Growing[usize](), Growing[usize](),
                           Growing[ProfileSpline](), Growing[Vector3](), Growing[f64](), Growing[f64]())
    errdefer profile.close()
    try profile.loop_offsets.push(0)
    try profile.edges.push(line_edge(p, ta))
    if round and continuity > 1:
        let first = profile.spline_points.count
        let knot_first = profile.spline_knots.count
        try fillet_section(ta, tb, p, continuity, &profile.spline_points, &profile.spline_knots)
        let count = profile.spline_points.count - first
        for _ in 0..<count: try profile.spline_weights.push(1.0)
        try profile.splines.push(ProfileSpline(first, count, knot_first, 5))
        try profile.edges.push(ProfileEdge(2, ta, tb, Vector3(), 0.0, 0.0, (i64)profile.splines.count - 1))
    elif round:
        let bisector = try ua.add(ub).normalized()
        let center = p.add(bisector.multiply_scalar(size / math.sin(angle * 0.5)))
        let leaving = ta.subtract(center)
        let arriving = tb.subtract(center)
        let sweep = math.atan2(along.dot(leaving.cross(arriving)), leaving.dot(arriving))
        try profile.edges.push(ProfileEdge(1, ta, tb, center, size, sweep, -1))
    else:
        try profile.edges.push(line_edge(ta, tb))
    try profile.edges.push(line_edge(tb, p))
    try profile.loop_offsets.push(profile.edges.count)
    try nest(&profile)
    return profile

## A G2 or G3 fillet's section from contact `ta` to contact `tb`, whose
## legs run along the faces to the corner `p`: a degree 5 B-spline (the
## degree of every freeform element), its control points onto `points`
## and its knots onto `knots`. The first three (G2) or four (G3) control
## points lie along each leg, so the curvature (and for G3 its change) is
## zero where it meets each face. G2 is one span (six points); G3 three
## spans (eight points, knots at the thirds). At a square corner with
## contacts a unit from it, both curves' curvature peaks at 1.17 times the
## circle's, and their middles are 0.376 (G2) and 0.360 (G3) from the
## corner, the circle's 0.414.
func fillet_section(ta: Vector3, tb: Vector3, p: Vector3, continuity: i64, points: Growing[Vector3]*, knots: Growing[f64]*) -> !:
    let g2: f64[3] = [0.0, 0.3, 0.6]
    let g3: f64[4] = [0.0, 0.1, 0.2, 0.6]
    let half: usize = 3 if continuity == 2 else 4
    for k in 0..<half: try points.push(ta.add(p.subtract(ta).multiply_scalar(g2[k] if half == 3 else g3[k])))
    for k in 0..<half:
        let f = g2[half - 1 - k] if half == 3 else g3[half - 1 - k]
        try points.push(tb.add(p.subtract(tb).multiply_scalar(f)))
    for _ in 0..<(usize)6: try knots.push(0.0)
    if half == 4:
        try knots.push(1.0 / 3.0)
        try knots.push(2.0 / 3.0)
    for _ in 0..<(usize)6: try knots.push(1.0)

## A concave edge's tool, added to the solid: the corner profile (in the
## air between its faces) swept from `start` to `end`, ending flush with
## the face at each end: exactly there when that face is square to the
## edge, else swept past and cut by the face's plane.
## An end marked exact (where a corner ball takes over) ends square there.
func concave_tool(w: const Shape*, e: usize, size: f64, round: bool, continuity: i64, start: Vector3, end: Vector3, exact_start: bool, exact_end: bool, name: str) -> interop.Reference[CadModel]!:
    let length = end.subtract(start).length()
    let along = try end.subtract(start).normalized()
    let (fa, fb) = try edge_faces(w, e)
    let ua = try into_face(w, fa, e, along)
    let ub = try into_face(w, fb, e, along)
    let (n0, h0) = (along.multiply_scalar(-1.0), -along.dot(start)) if exact_start else try end_plane(w, start, fa, fb)
    let (n1, h1) = (along, along.dot(end)) if exact_end else try end_plane(w, end, fa, fb)
    let square = math.abs(n0.dot(along)) > 1.0 - 1e-9 and math.abs(n1.dot(along)) > 1.0 - 1e-9
    let margin = 0.0 if square else size * 4.0 + length * 0.1
    var profile = try section_profile(w, e, start.subtract(along.multiply_scalar(margin)), along, size, round, continuity)
    defer profile.close()
    let solid = try new_solid(length + margin * 2.0)
    defer solid.release()
    try extrude_into(solid.value(), &profile, length + margin * 2.0, "")
    try name_tool(solid.value(), name)
    let swept = try model_of(solid)
    if square: return swept
    defer swept.release()
    # Cut by the end faces' planes; the sides far off.
    let s1 = try ua.add(ub).normalized()
    let s2 = along.cross(s1)
    let far = (size * 8.0 + length) * 2.0
    let normals: Vector3[6] = [n0, s1, s2, n1, s1.multiply_scalar(-1.0), s2.multiply_scalar(-1.0)]
    let offsets: f64[6] = [h0, s1.dot(start) + far, s2.dot(start) + far, h1, -s1.dot(start) + far, -s2.dot(start) + far]
    let cell = try hexahedron(normals[..<6], offsets[..<6], far)
    defer cell.release()
    return try combine(swept.value(), cell.value(), op_intersect)

## The plane of the face at the end of an edge between faces `fa` and `fb`
## (at its vertex at `point`): its outward normal and offset.
func end_plane(w: const Shape*, point: Vector3, fa: usize, fb: usize) -> (Vector3, f64)!:
    var vertex: i64 = -1
    for v in 0..<w.points.count:
        if w.points.items[v].subtract(point).length() <= w.tolerance * 10.0: vertex = (i64)v
    if vertex < 0: error(invalid, "a concave blend's end is not a corner of the body")
    var found: i64 = -1
    for f in 0..<w.faces.count:
        if f == fa or f == fb: continue
        for use in w.face_uses(f):
            let edge = w.edges.items[(usize)((use if use > 0 else -use) - 1)]
            if edge.start == vertex or edge.end == vertex:
                if found >= 0 and found != (i64)f: error(invalid, "a concave blend must end at one flat face")
                found = (i64)f
    if found < 0 or w.surfaces.items[(usize)w.faces.items[(usize)found].surface].kind != 0: error(invalid, "a concave blend must end at one flat face")
    let n = face_outward(w, (usize)found)
    return (n, n.dot(w.surfaces.items[(usize)w.faces.items[(usize)found].surface].origin))

## A tool's faces: the one its corner profile's middle edge made (the
## profile's order survives nesting: three edges reversed keep their
## middle) is the blend, named `name`; the rest go with the corner and
## stay unnamed.
func name_tool(b: BrepModel*, name: str) -> !:
    for face in 0..<b.face_count():
        try b.set_face_name(face, name if face == 1 else "")

## A rim's tool: the corner profile (a triangle `size` along each face,
## or the region between them and the circle of radius `size` touching
## both) turned about the rim's axis: a cone, or a torus. A whole circle's
## turns all the way; an arc's turns along it, reaching past an end where
## the corner beyond is empty and stopping at an exact one (a tangent
## joint with the next edge of a chain).
func rim_tool(w: const Shape*, e: usize, size: f64, round: bool, continuity: i64, exact_start: bool, exact_end: bool, body: const Mesh*, name: str) -> interop.Reference[CadModel]!:
    let edge = w.edges.items[e]
    let carrier = w.carriers.items[(usize)edge.carrier]
    let (fa, fb) = try edge_faces(w, e)
    let along = try along_edge(w, e)
    let p = try w.edge_at(e, 0.5)
    let ua = try into_face(w, fa, e, along)
    let ub = try into_face(w, fb, e, along)
    let normal = carrier.x.cross(carrier.y)
    let solid = try new_solid(carrier.a + size * 4.0)
    defer solid.release()
    if edge.start == edge.end:
        var profile = try corner_profile(p, along, ua, ub, size, round, continuity)
        defer profile.close()
        try revolve_into(solid.value(), &profile, carrier.origin, normal, (carrier.a + size) * 1e-7, "")
        try name_tool(solid.value(), name)
        return try model_of(solid)
    # The axis turning the way the edge runs.
    var a = normal
    if a.cross(p.subtract(carrier.origin)).dot(along) < 0.0: a = normal.multiply_scalar(-1.0)
    let sweep = math.abs(edge.t1 - edge.t0)
    # Past a free end, by a margin where the corner beyond is empty.
    let margin = math.min(math.pi * 0.25, size * 2.0 / carrier.a)
    let corner = try ua.add(ub).normalized().multiply_scalar(size * 0.25)
    let extent = (carrier.a + size) * 4.0
    let first = try w.edge_at(e, 0.0)
    let last = try w.edge_at(e, 1.0)
    let before = 0.0 if exact_start or try inside_mesh(body, turned_point(first, carrier.origin, a, -size * 0.5 / carrier.a).add(turned_direction(corner, a, -sweep * 0.5)), extent) else margin
    let after = 0.0 if exact_end or try inside_mesh(body, turned_point(last, carrier.origin, a, size * 0.5 / carrier.a).add(turned_direction(corner, a, sweep * 0.5)), extent) else margin
    # The profile where the tool starts: the middle's turned back.
    let back = -(sweep * 0.5 + before)
    var profile = try corner_profile(turned_point(p, carrier.origin, a, back), turned_direction(along, a, back), turned_direction(ua, a, back), turned_direction(ub, a, back), size, round, continuity)
    defer profile.close()
    try revolve_into(solid.value(), &profile, carrier.origin, a, (carrier.a + size) * 1e-7, "", sweep + before + after)
    try name_tool(solid.value(), name)
    return try model_of(solid)

## `model` with the edges `references` refers to (references.lucb; empty:
## every straight convex edge between two planes) blended: filleted to
## `size` when `round`, else chamfered `size` along each face. The blend
## faces are named for feature `tag`. A fillet's `continuity` is 1 (G1,
## circular), 2 (G2) or 3 (G3): see corner_profile.
## With `chain`, each referenced edge brings the edges that continue it
## tangentially (Fusion's Tangent Chain): a slot's rim, the edges around an
## earlier fillet.
## `direct` false skips the direct build (local_blend.lucb), for tests
## that compare it with the booleans.
pub func blended(model: const CadModel*, references: str, size: f64, round: bool, tag: str, continuity: i64 = 1, chain: bool = true, direct: bool = true) -> interop.Reference[CadModel]!:
    var w = try shape_of(model)
    defer w.close()
    var chosen = Growing[usize]()
    defer chosen.close()
    try choose_edges(&w, references, chain, &chosen)
    return try blend_chosen(model, &w, chosen.view(), trimmed(references) == "", size, round, tag, continuity, direct, none)

## The edges of `w` that `references` names onto `chosen` (empty: every
## straight convex edge between flat faces; rims and inside corners only
## when named), with the edges continuing them tangentially when `chain`.
func choose_edges(w: Shape*, references: str, chain: bool, chosen: Growing[usize]*) -> !:
    if trimmed(references) == "":
        for e in 0..<w.edges.count:
            if w.carriers.items[(usize)w.edges.items[e].carrier].kind == 0 and try blendable(w, e) and try convex(w, e): try chosen.push(e)
    else:
        try resolve_edges(w, references, chosen)
        for e in chosen.view():
            if not try blendable(w, e): error(invalid, "only straight edges between flat faces, and rims (a circle or arc between a flat face and a cylinder about it), can be blended yet")
        if chain: try tangent_chains(w, chosen)
    if chosen.count == 0: error(invalid, "the body has no edges to blend")

## `model` (its shape `w`) with edges `chosen` blended to `size` (`every`:
## they are every edge, as blended's empty references). `patches` keeps
## setback corners' patches between sizes (FilletPlan), when given.
func blend_chosen(model: const CadModel*, w: Shape*, chosen: const usize[], every: bool, size: f64, round: bool, tag: str, continuity: i64, direct: bool, patches: PatchCache*?) -> interop.Reference[CadModel]!:
    if not math.is_finite(size) or size <= 0.0: error(invalid, "a blend needs a positive size")
    if continuity < 1 or continuity > 3: error(invalid, "a fillet's continuity is G1, G2 or G3")
    # Each edge's blend must fit its faces: said precisely, before any tool.
    for e in chosen: try check_fits(w, e, size, round)
    # Straight edges between flat faces are built directly; what that
    # declines (curved faces at a corner, mixed corners, chamfers...) the
    # booleans below make.
    if round and direct:
        if let made = try local_blend(w, chosen, size, continuity, tag, patches): return made
    # Inside and outside fillets meeting at a corner: one side first, the
    # other then runs around it (a torus), by name on the result.
    if round and not every:
        var later = Growing[usize]()
        defer later.close()
        try mixed_order(w, chosen, &later)
        if later.count > 0:
            var first = Growing[i64]()
            defer first.close()
            var second = Growing[i64]()
            defer second.close()
            for e in chosen:
                if edge_in(later.view(), e): try second.push((i64)e)
                else: try first.push((i64)e)
            var text = Growing[u8]()
            defer text.close()
            try references_of(w, first.view(), &text)
            let earlier = try blended(model, (str)text.view(), size, round, tag, continuity, false, direct)
            defer earlier.release()
            try references_of(w, second.view(), &text)
            return try blended(earlier.value(), (str)text.view(), size, round, tag, continuity, true, direct)
    # Every edge of a convex polyhedron rounded: built whole.
    if round and every and continuity == 1:
        if let whole = try rounded_polyhedron(w, size, tag): return whole
    # Where three fillets meet, a ball rounds the corner.
    var balls = Growing[Ball]()
    defer balls.close()
    # Where three G2 or G3 fillets meet, a setback corner.
    var setbacks = Growing[Setback]()
    defer setbacks.close()
    # Where chained edges meet tangentially, their tools end square.
    var joints = Growing[i64]()
    defer joints.close()
    try fillet_corners(w, chosen, size, continuity, round, &balls, &setbacks, &joints)
    let body = try model.tessellate(16)
    defer body.release()
    var tools = Growing[interop.Reference[CadModel]]()
    defer:
        for tool in tools.view(): tool.release()
        tools.close()
    # Whether each tool is added (a concave edge's) rather than taken away.
    var adds = Growing[bool]()
    defer adds.close()
    # Collinear chosen edges between the same two faces (one edge cut into
    # pieces by earlier operations) are one chain: one tool spans them.
    var done = Growing[bool]()
    defer done.close()
    for _ in chosen: try done.push(false)
    var name = Growing[u8]()
    defer name.close()
    for i in 0..<chosen.length:
        if done.items[i]: continue
        done.items[i] = true
        let e = chosen[i]
        var low = try w.edge_at(e, 0.0)
        var high = try w.edge_at(e, 1.0)
        try blend_name(w, e, tag, &name)
        let adding = not try convex(w, e)
        # A rim is its own tool.
        if w.carriers.items[(usize)w.edges.items[e].carrier].kind != 0:
            let edge = w.edges.items[e]
            let at_start = vertex_in(joints.view(), edge.start)
            let at_end = vertex_in(joints.view(), edge.end)
            try tools.push(try edge_tool(w, e, size, round, continuity, low, high, at_start, at_end, body.value(), (str)name.view()))
            try adds.push(adding)
            continue
        let (fa, fb) = try edge_faces(w, e)
        let along = try high.subtract(low).normalized()
        for j in i + 1..<chosen.length:
            if done.items[j]: continue
            let other = chosen[j]
            if not try same_curve(w, w.edges.items[e].carrier, other, w.tolerance): continue
            let (ga, gb) = try edge_faces(w, other)
            if not ((ga == fa and gb == fb) or (ga == fb and gb == fa)): continue
            done.items[j] = true
            for k in 0..<2:
                let p = try w.edge_at(other, (f64)k)
                if p.subtract(low).dot(along) < 0.0: low = p
                if p.subtract(high).dot(along) > 0.0: high = p
        # An end at a ball's corner stops where the ball's center is along it.
        var exact_low = false
        var exact_high = false
        for ball in balls.view():
            let corner = w.points.items[(usize)ball.vertex]
            let foot = low.add(along.multiply_scalar(ball.center.subtract(low).dot(along)))
            if corner.subtract(low).length() <= w.tolerance * 10.0:
                low = foot
                exact_low = true
            elif corner.subtract(high).length() <= w.tolerance * 10.0:
                high = foot
                exact_high = true
        # An end at a setback corner stops at its setback.
        for corner in setbacks.view():
            let apex = w.points.items[(usize)corner.vertex]
            for k in 0..<(usize)3:
                if math.abs(corner.ways[k].dot(along)) < 1.0 - 1e-9: continue
                let foot = apex.add(corner.ways[k].multiply_scalar(corner.distances[k]))
                if apex.subtract(low).length() <= w.tolerance * 10.0:
                    low = foot
                    exact_low = true
                elif apex.subtract(high).length() <= w.tolerance * 10.0:
                    high = foot
                    exact_high = true
        # The corners at both ends must leave the edge some length.
        if exact_low or exact_high:
            let original = try w.edge_at(e, 1.0).subtract(try w.edge_at(e, 0.0)).length()
            let left = high.subtract(low).dot(along)
            if left <= w.tolerance * 10.0:
                let most = size * original / (original - left)
                var buffer: u8[256]
                let owned = try interop.copy_text(try strings.format(buffer, f"a fillet radius of {rounded_text(size)} is too large for this edge between its rounded corners: it must be less than {rounded_text(most)}"))
                if let owner = owned.owner: _ = ownership.pool_object(owner)
                error(invalid, owned.value)
        for v in joints.view():
            let corner = w.points.items[(usize)v]
            if corner.subtract(low).length() <= w.tolerance * 10.0: exact_low = true
            elif corner.subtract(high).length() <= w.tolerance * 10.0: exact_high = true
        if adding: try tools.push(try concave_tool(w, e, size, round, continuity, low, high, exact_low, exact_high, (str)name.view()))
        else: try tools.push(try edge_tool(w, e, size, round, continuity, low, high, exact_low, exact_high, body.value(), (str)name.view()))
        try adds.push(adding)
    for ball in balls.view():
        try corner_name(w, (usize)ball.vertex, tag, &name)
        try tools.push(try corner_tool(w, &ball, size, (str)name.view()))
        try adds.push(ball.inside)
    for corner in setbacks.view():
        try corner_name(w, (usize)corner.vertex, tag, &name)
        try tools.push(try setback_tool(w, &corner, size, continuity, (str)name.view()))
        try adds.push(corner.inside)
    # Material taken away first, then added.
    var result = try copy_model(model)
    for pass in 0..<2:
        for at in 0..<tools.count:
            if adds.items[at] != (pass == 1): continue
            let next = combine(result.value(), tools.items[at].value(), op_union if pass == 1 else op_subtract) catch failure:
                result.release()
                error(failure.code, failure.message)
            result.release()
            result = next
    return result

## How far along each face from edge `e` a blend of `size` reaches (a
## fillet's contact distance, a chamfer's own size).
func reach_of(w: const Shape*, e: usize, size: f64, round: bool) -> f64!:
    if not round: return size
    let (fa, fb) = try edge_faces(w, e)
    let along = try along_edge(w, e)
    let ua = try into_face(w, fa, e, along)
    let ub = try into_face(w, fb, e, along)
    let angle = math.acos(math.clamp(ua.dot(ub), -1.0, 1.0))
    return size / math.tan(angle * 0.5)

## How far into face `f` from edge `e` the blend's contact can reach before
## leaving it: over samples along the edge, the least distance to the
## face's boundary going straight in.
## On a cylinder along the edge (`around`), the step goes around its
## circle.
func room(w: const Shape*, e: usize, f: usize, limit: f64, around: bool = false) -> f64!:
    let edge = w.edges.items[e]
    var least = limit
    for k in 1..<8:
        let fraction = (f64)k / 8.0
        let p = try w.edge_at(e, fraction)
        let t = edge.t0 + (edge.t1 - edge.t0) * fraction
        let along = (try w.tangent(edge.carrier, t)).multiply_scalar(1.0 if edge.t1 > edge.t0 else -1.0)
        let n = try w.face_normal(f, p)
        var side = try n.cross(try along.normalized()).normalized()
        let probe = try stepped(w, f, p, side, least * 1e-3 + w.tolerance * 100.0, around)
        if try face_contains(w, f, probe, w.tolerance) != inside_face: side = side.multiply_scalar(-1.0)
        # On a rim's cylinder the straight step runs along the axis, on the
        # face; one leaving the surface has left the face.
        let far = try stepped(w, f, p, side, least, around)
        if try face_contains(w, f, far, w.tolerance) != outside and try on_face_surface(w, f, far): continue
        var inside_at = 0.0
        var outside_at = least
        for _ in 0..<40:
            let middle = (inside_at + outside_at) * 0.5
            let q = try stepped(w, f, p, side, middle, around)
            if try on_face_surface(w, f, q) and try face_contains(w, f, q, w.tolerance) != outside: inside_at = middle
            else: outside_at = middle
        least = inside_at
    return least

## `p` moved `distance` along `side` on face `f`: straight, or (around)
## that far around its cylinder's circle.
func stepped(w: const Shape*, f: usize, p: Vector3, side: Vector3, distance: f64, around: bool) -> Vector3!:
    if not around: return p.add(side.multiply_scalar(distance))
    let s = w.surfaces.items[(usize)w.faces.items[f].surface]
    let axis_point = s.origin.add(s.z.multiply_scalar(p.subtract(s.origin).dot(s.z)))
    let r0 = p.subtract(axis_point)
    let turn = 1.0 if s.z.cross(r0).dot(side) > 0.0 else -1.0
    return axis_point.add(turned_direction(r0, s.z, turn * distance / s.radius))

func on_face_surface(w: const Shape*, f: usize, p: Vector3) -> bool!:
    let s = &w.surfaces.items[(usize)w.faces.items[f].surface]
    if s.kind == 3: return true
    return surface_distance(s, p) <= w.tolerance * 10.0

## A blend of `size` on edge `e` must reach less far than its faces go
## (all the way, a face would vanish): else an error saying so, and the
## size it must stay under.
func check_fits(w: const Shape*, e: usize, size: f64, round: bool) -> !:
    let (fa, fb) = try edge_faces(w, e)
    # How far the blend reaches along each face: alike between planes (and
    # at rims), each its own between a plane and a cylinder (the
    # cylinder's along its circle).
    var reach_a = try reach_of(w, e, size, round)
    var reach_b = reach_a
    var around: i64 = -1
    let edge = w.edges.items[e]
    if w.carriers.items[(usize)edge.carrier].kind == 0:
        let cylinder = ruled_pair(w, e, fa, fb)
        if cylinder >= 0:
            around = cylinder
            let along = try along_edge(w, e)
            let p = try w.edge_at(e, 0.5)
            let plane = fb if (usize)cylinder == fa else fa
            let into_plane = try into_face(w, plane, e, along)
            let into_round = try into_face(w, (usize)cylinder, e, along)
            let (ta, tb, _) = try ruled_contacts(w, plane, (usize)cylinder, p, into_plane, into_round, size, round, try convex(w, e))
            let s = w.surfaces.items[(usize)w.faces.items[(usize)cylinder].surface]
            let axis_point = s.origin.add(s.z.multiply_scalar(p.subtract(s.origin).dot(s.z)))
            let arc = s.radius * math.acos(math.clamp(tb.subtract(axis_point).dot(p.subtract(axis_point)) / (s.radius * s.radius), -1.0, 1.0))
            reach_a = ta.subtract(p).length() if fa == plane else arc
            reach_b = arc if fa == plane else ta.subtract(p).length()
    let room_a = try room(w, e, fa, reach_a * 1.01 + w.tolerance * 100.0, around == (i64)fa)
    let room_b = try room(w, e, fb, reach_b * 1.01 + w.tolerance * 100.0, around == (i64)fb)
    if room_a > reach_a + w.tolerance * 10.0 and room_b > reach_b + w.tolerance * 10.0: return
    let most = size * math.min(room_a / reach_a, room_b / reach_b)
    var buffer: u8[256]
    let text = try strings.format(buffer, f"a fillet radius of {rounded_text(size)} is too large for this edge's faces: it must be less than {rounded_text(most)}") if round else try strings.format(buffer, f"a chamfer of {rounded_text(size)} is too large for this edge's faces: it must be less than {rounded_text(most)}")
    let owned = try interop.copy_text(text)
    if let owner = owned.owner: _ = ownership.pool_object(owner)
    error(invalid, owned.value)

## `value` to four significant places, for messages.
func rounded_text(value: f64) -> f64:
    if value == 0.0 or not math.is_finite(value): return value
    let scale = math.pow(10.0, 3.0 - math.floor(math.log10(math.abs(value))))
    return math.round(value * scale) / scale

func edge_in(edges: const usize[], e: usize) -> bool:
    for known in edges:
        if known == e: return true
    return false

## The edges of `chosen` to fillet after the rest, where inside and
## outside fillets meet at a corner: the lone outside edge first where it
## meets two inside ones (a boss's upright on a plate: the base then runs
## around its fillet), the lone inside edge first where two outside ones
## meet it (an L's inside upright under its top edges). Others: refused.
func mixed_order(w: const Shape*, chosen: const usize[], later: Growing[usize]*) -> !:
    var seen = Growing[i64]()
    defer seen.close()
    var here = Growing[usize]()
    defer here.close()
    for e in chosen:
        let ends: i64[2] = [w.edges.items[e].start, w.edges.items[e].end]
        for v in ends:
            if vertex_in(seen.view(), v): continue
            try seen.push(v)
            here.clear()
            var concaves = 0
            for other in chosen:
                let o = w.edges.items[other]
                if o.start != v and o.end != v: continue
                try here.push(other)
                if not try convex(w, other): concaves += 1
            if concaves == 0 or concaves == (i64)here.count: continue
            if here.count != 3:
                error(invalid, "an inside-corner fillet meeting an outside one at a corner is supported where three edges meet: fillet them one at a time")
            # The lone kind goes first; the pair after.
            let lone_inside = concaves == 1
            for other in here.view():
                let goes_later = (not try convex(w, other)) != lone_inside
                if goes_later and not edge_in(later.view(), other): try later.push(other)
                if not goes_later and edge_in(later.view(), other): error(invalid, "these fillets meet at corners in orders that conflict: fillet them in two features")
    # An edge sent later at one corner but first at another conflicts.
    seen.clear()
    for e in later.view():
        let ends: i64[2] = [w.edges.items[e].start, w.edges.items[e].end]
        for v in ends:
            var concaves = 0
            var count = 0
            for other in chosen:
                let o = w.edges.items[other]
                if o.start != v and o.end != v: continue
                count += 1
                if not try convex(w, other): concaves += 1
            if concaves == 0 or concaves == count: continue
            if (not try convex(w, e)) == (concaves == 1): error(invalid, "these fillets meet at corners in orders that conflict: fillet them in two features")

func vertex_in(vertices: const i64[], v: i64) -> bool:
    for known in vertices:
        if known == v: return true
    return false

## `chosen` with the edges that continue its edges tangentially, of the
## same convexity, through vertices where nothing else could be blended
## (a slot's rim around its ends, the edges around an earlier fillet).
func tangent_chains(w: const Shape*, chosen: Growing[usize]*) -> !:
    var at: usize = 0
    while at < chosen.count:
        let e = chosen.items[at]
        at += 1
        let outward = try convex(w, e)
        for end in 0..<2:
            let v = w.edges.items[e].start if end == 0 else w.edges.items[e].end
            # Arriving at v along e.
            let arriving = (try w.leaving(e, (i64)end)).multiply_scalar(-1.0)
            for f in 0..<w.edges.count:
                if f == e: continue
                let other = w.edges.items[f]
                if other.start != v and other.end != v: continue
                var known = false
                for c in chosen.view():
                    if c == f: known = true
                if known: continue
                let leaving = try w.leaving(f, 0 if other.start == v else 1)
                if leaving.dot(arriving) < 1.0 - 1e-6: continue
                if not try blendable(w, f) or try convex(w, f) != outward: continue
                try chosen.push(f)

## The name of edge `e`'s blend, `tag/blend[A&B]`, into `out` (empty
## when its faces have no names).
func blend_name(w: const Shape*, e: usize, tag: str, out: Growing[u8]*) -> !:
    out.clear()
    let (fa, fb) = try edge_faces(w, e)
    if w.face_name(fa) == "" or w.face_name(fb) == "": return
    try role_name(out, tag, "blend[")
    try edge_name(w, e, out)
    try out.push(93)

## A new reference to `model`'s B-rep, placed as it is.
func copy_model(model: const CadModel*) -> interop.Reference[CadModel]!:
    var w = try shape_of(model)
    defer w.close()
    let b = try brep_of(&w)
    defer b.release()
    return try model_of(b)
