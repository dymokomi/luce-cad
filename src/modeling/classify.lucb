## The booleans' classification (step 5): a point well inside each piece,
## and whether it lies inside the other solid, on its coincident face, or
## outside.

## A point well inside piece `p` of face `f`: across the middle of its
## chart, the middle of the widest stretch inside it, on the surface.
func piece_point(work: Work*, traced: const Shape*, f: usize, pieces: const Pieces*, p: usize) -> Vector3!:
    let face = work.w.faces.items[f]
    var chart = Growing[Vector3]()
    defer chart.close()
    var starts = Growing[usize]()
    defer starts.close()
    for c in pieces.piece_cycles(p):
        try starts.push(chart.count)
        try loop_chart(traced, face.surface, try face_pole(&work.w, f), pieces.cycle(c), &chart)
    try starts.push(chart.count)
    var low = Vector3(1.0e300, 1.0e300, 0.0)
    var high = Vector3(-1.0e300, -1.0e300, 0.0)
    for q in chart.view():
        low = Vector3(math.min(low.x, q.x), math.min(low.y, q.y), 0.0)
        high = Vector3(math.max(high.x, q.x), math.max(high.y, q.y), 0.0)
    # Angles count by the radius, so clearances compare like lengths.
    let s = &work.w.surfaces.items[(usize)face.surface]
    let wraps = periodic(s)
    let scale = 1.0 if s.kind == 0 or s.kind == 3 else math.max(s.radius, 1e-300)
    # The chart with angles scaled, for clearances.
    var scaled = Growing[Vector3]()
    defer scaled.close()
    for q in chart.view(): try scaled.push(Vector3(q.x * scale, q.y, 0.0))
    var best_u = 0.0
    var best_v = 0.0
    var best = -1.0
    # A coarse grid of candidates off the vertices (an irrational step); of
    # those inside, the one farthest from every boundary segment; then
    # finer grids about the best so far.
    var cell_u = (high.x - low.x) / 24.0
    var cell_v = (high.y - low.y) / 12.0
    var from_u = low.x + cell_u * (0.5 + 0.0098765432)
    var from_v = low.y + cell_v * (0.5 + 0.0123456789)
    var columns = 24
    var rows = 12
    for round in 0..<4:
        for row in 0..<rows:
            let v = from_v + cell_v * (f64)row
            for column in 0..<columns:
                let u = from_u + cell_u * (f64)column
                if chart_winding(chart.view(), starts.view(), u, v, wraps, s.kind == 5) == 0: continue
                let clearance = nearest_segment(scaled.view(), starts.view(), u * scale, v, best)
                if clearance > best:
                    best = clearance
                    best_u = u
                    best_v = v
        if best < 0.0: break
        # Next: a 7 x 7 grid over the cells about the best.
        cell_u = cell_u * 2.0 / 7.0
        cell_v = cell_v * 2.0 / 7.0
        from_u = best_u - cell_u * 3.0
        from_v = best_v - cell_v * 3.0
        columns = 7
        rows = 7
        _ = round
    if best < 0.0: error(invalid, "a face piece has no inside to classify")
    return try surface_point(&work.w.surfaces.items[(usize)face.surface], best_u, best_v)

## The distance from (`u`, `v`) to the nearest segment of the loops of
## `points` (from `starts`), or a smaller one as soon as it is below
## `enough` (the candidate cannot win).
func nearest_segment(points: const Vector3[], starts: const usize[], u: f64, v: f64, enough: f64) -> f64:
    var nearest = 1.0e300
    let floor = enough * enough if enough > 0.0 else -1.0
    for loop in 0..<starts.length - 1:
        let first = starts[loop]
        let last = starts[loop + 1]
        for k in first..<last:
            let a = points[k]
            let b = points[first if k + 1 == last else k + 1]
            let dx = b.x - a.x
            let dy = b.y - a.y
            let length = dx * dx + dy * dy
            var t = 0.0
            if length > 0.0: t = math.clamp(((u - a.x) * dx + (v - a.y) * dy) / length, 0.0, 1.0)
            let ex = a.x + dx * t - u
            let ey = a.y + dy * t - v
            let d = ex * ex + ey * ey
            if d < nearest:
                nearest = d
                if nearest <= floor: return math.sqrt(nearest)
    return math.sqrt(nearest)

## The point of `s` at chart coordinates (u, v) (surface_uv's inverse).
func surface_point(s: const Surface*, u: f64, v: f64) -> Vector3!:
    if s.kind == 0: return s.origin.add(s.x.multiply_scalar(u)).add(s.y.multiply_scalar(v))
    if s.kind == 3: return try evaluate(*s, Vector3(u, v, 0.0))
    let around = s.x.multiply_scalar(math.cos(u)).add(s.y.multiply_scalar(math.sin(u)))
    if s.kind == 1: return s.origin.add(around.multiply_scalar(s.radius)).add(s.z.multiply_scalar(v))
    if s.kind == 2: return s.origin.add(around.multiply_scalar(s.radius + v * math.tan(s.angle))).add(s.z.multiply_scalar(v))
    if s.kind == 4: return s.origin.add(around.multiply_scalar(s.radius * math.cos(v))).add(s.z.multiply_scalar(s.radius * math.sin(v)))
    return s.origin.add(around.multiply_scalar(s.radius + s.angle * math.cos(v))).add(s.z.multiply_scalar(s.angle * math.sin(v)))

## What pieces are classified against: both solids' faces (their charts,
## for exact rays), and the meshes of solids with B-spline faces, made when
## first needed.
struct Others:
    var charts: Charts
    var a: const CadModel*
    var b: const CadModel*
    var mesh_a: interop.Reference[Mesh]?
    var mesh_b: interop.Reference[Mesh]?

    func close():
        self.charts.close()
        if let m = self.mesh_a: m.release()
        if let m = self.mesh_b: m.release()

func new_others(w: const Shape*, a: const CadModel*, b: const CadModel*) -> Others!:
    return Others(try new_charts(w.faces.count), a, b, none, none)

## Piece `p` of face `f` against the other solid.
func classify(work: Work*, traced: const Shape*, f: usize, pieces: const Pieces*, p: usize, others: Others*) -> i64!:
    let point = try piece_point(work, traced, f, pieces, p)
    for pair in work.coincident.view():
        let partner = pair.fb if pair.fa == f else (pair.fa if pair.fb == f else f)
        if partner == f: continue
        if try face_contains(&work.w, partner, point, work.tol) != outside:
            return class_same if pair.same else class_opposite
    # The other solid's faces.
    let first = work.faces_a if work.is_a(f) else 0
    let last = work.w.faces.count if work.is_a(f) else work.faces_a
    if analytic_faces(&work.w, first, last):
        return class_in if try inside_faces(&work.w, &others.charts, first, last, point, work.size) else class_out
    if work.is_a(f):
        if others.mesh_b == none: others.mesh_b = try others.b.tessellate(16)
    elif others.mesh_a == none:
        others.mesh_a = try others.a.tessellate(16)
    let mesh = (others.mesh_b if work.is_a(f) else others.mesh_a) else error(invalid, "a solid lost its mesh")
    return class_in if try inside_mesh(mesh.value(), point, work.size) else class_out

## Whether `point` is inside the closed `mesh` (of extent `size`): crossings
## of three rays through it, the majority deciding.
pub func inside_mesh(mesh: const Mesh*, point: Vector3, size: f64) -> bool!:
    let rays: Vector3[3] = [Vector3(0.5377, 0.8319, 0.1373), Vector3(-0.3271, 0.2491, 0.9116), Vector3(0.7713, -0.5129, -0.3772)]
    var inside_votes = 0
    for ray in rays:
        let direction = try ray.normalized()
        var origin = point
        var crossings_count = 0
        for _ in 0..<10000:
            let distance = try mesh.ray_distance(origin, direction)
            if distance < 0.0: break
            crossings_count += 1
            origin = origin.add(direction.multiply_scalar(distance + size * 1e-7))
        if crossings_count % 2 == 1: inside_votes += 1
    return inside_votes >= 2
