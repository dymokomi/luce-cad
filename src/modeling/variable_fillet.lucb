## Fusion's Variable radius fillet: radii at points along a tangent chain
## of edges (positions 0 to 1 along it: radius_law.lucb), blending between
## them smoothly or straight, G1, G2 or G3.
##
## The chain is built as a constant fillet's would be, the radius asked of
## the law at each section: loops round a flat face and their open ends'
## run-outs (cap_blend.lucb: a box's top past rounded uprights, an earlier
## fillet's edges, a hole's rim, a chain ending where an unpicked tangent
## edge goes on), loops between two curved faces (curved_blend.lucb). Their
## rows are fitted along the chain, within the tolerance.
##
## One straight edge between two flat faces is exact: the rolling ball's
## section swept with its radius changing. In each section square to the
## edge every control point is the edge's point plus r(s) times a fixed
## vector (G1: the rational quadratic arc from contact to contact whose
## middle control point is the edge's own point, weighted sin(θ/2) for
## faces θ apart, the contacts r cot(θ/2) along each face; G2 and G3: the
## fillet's B-spline on those contacts), so with r(s) a piecewise cubic the
## face is exactly a B-spline, cubic along (a knot thrice at each point:
## each piece a Bezier). The tool is the region between the edge and that
## face, taken away (an inside edge: added) by the booleans. Its net keeps
## to one side of each face's plane, touching it only along the contact
## row, so it meets the body only along curves both carry (kept_apart). At
## an end square to the edge it ends flush. At another flat end face,
## leaning either way (a slanted end, a wall a convex edge runs into, an
## inside edge's end), each row of the net stops where it meets the end
## face's plane: its first or last piece is the same polynomial from there,
## so the rows keep their knots, the end's section lies in that plane, and
## no boolean has to cross the strip there (an exact cylinder when the
## radius holds).

## `model` with the edges `reference` names (with their tangent chains when
## `chain`) filleted with `radii` at `positions` along the chain (0 its
## start, 1 its end; the ends are added from the nearest radius when
## missing), smoothly or straight between them, of `continuity`, the blend
## named for feature `tag`.
func variable_filleted_edge(model: const CadModel*, reference: str, positions: const f64[], radii: const f64[], smooth: bool, tag: str, continuity: i64 = 1, chain: bool = true) -> interop.Reference[CadModel]!:
    if continuity < 1 or continuity > 3: error(invalid, "a fillet's continuity is G1, G2 or G3")
    var w = try shape_of(model)
    defer w.close()
    var chosen = Growing[usize]()
    defer chosen.close()
    try resolve_edges(&w, reference, &chosen)
    if chosen.count == 0: error(invalid, "a variable radius fillet takes an edge")
    for e in chosen.view():
        if not try blendable(&w, e): error(invalid, "only straight edges between flat faces, rims, edges round a flat face whose walls are ruled away from it, and loops between two curved faces can be blended yet")
    let first = chosen.items[0]
    if chain: try tangent_chains(&w, &chosen)
    var law = try chain_law(&w, chosen.view(), first, positions, radii, smooth)
    defer law.close()
    let largest = law.largest()
    for e in chosen.view(): try check_fits(&w, e, largest, true)
    if let made = try cap_blend(&w, chosen.view(), largest, true, continuity, tag, none, &law): return made
    if let made = try curved_blend(&w, chosen.view(), largest, true, continuity, tag, none, &law): return made
    let e = chosen.items[0]
    let (fa, fb) = try edge_faces(&w, e)
    if chosen.count != 1 or w.carriers.items[(usize)w.edges.items[e].carrier].kind != curve_line or not flat_pair(&w, fa, fb):
        error(invalid, "a variable radius fillet takes one straight edge between flat faces, a tangent chain round a flat face, or a loop between two curved faces")
    return try variable_straight(model, &w, e, &law, continuity, tag)

## One straight edge `e` between flat faces filleted by `law`, of
## `continuity` (see the header).
func variable_straight(model: const CadModel*, w: const Shape*, e: usize, law: const RadiusLaw*, continuity: i64, tag: str) -> interop.Reference[CadModel]!:
    let edge = w.edges.items[e]
    let (fa, fb) = try edge_faces(w, e)
    let start = try w.edge_at(e, 0.0)
    let end = try w.edge_at(e, 1.0)
    let length = end.subtract(start).length()
    let along = try end.subtract(start).normalized()
    let ua = try into_face(w, fa, e, along)
    let ub = try into_face(w, fb, e, along)
    let theta = math.acos(math.clamp(ua.dot(ub), -1.0, 1.0))
    let reach = 1.0 / math.tan(theta * 0.5)
    let weight = math.sin(theta * 0.5)
    let convex_edge = try convex(w, e)
    # How each end goes: flush at a face square to the edge; at another
    # flat face, leaning either way, each row of the net stops in its plane
    # (no boolean then crosses the strip there: a G2 strip's crossing with
    # a slanted face, marched, could not be split cleanly).
    var ends = EndPlanes(along.multiply_scalar(-1.0), 0.0, false, along, 0.0, false)
    for k in 0..<(usize)2:
        let v = edge.start if k == 0 else edge.end
        let point = start if k == 0 else end
        if ends_square(w, v, fa, fb, along): continue
        let (n, h) = end_plane(w, point, fa, fb) catch failure:
            _ = failure
            error(invalid, "a variable radius fillet's edge must end at a flat face")
        if k == 0:
            ends.n0 = n
            ends.h0 = h
            ends.slanted0 = true
        else:
            ends.n1 = n
            ends.h1 = h
            ends.slanted1 = true
    # The law's points that change nothing (on a straight run, or between
    # equal radii) go: fewer knots.
    var kept_at = Growing[f64]()
    defer kept_at.close()
    var kept_sizes = Growing[f64]()
    defer kept_sizes.close()
    let at = law.positions.view()
    let sizes = law.radii.view()
    for k in 0..<at.length:
        if k > 0 and k + 1 < at.length:
            let previous = kept_sizes.items[kept_sizes.count - 1]
            let before = (sizes[k] - previous) / (at[k] - kept_at.items[kept_at.count - 1])
            let after = (sizes[k + 1] - sizes[k]) / (at[k + 1] - at[k])
            let flat = previous == sizes[k] and sizes[k] == sizes[k + 1]
            if flat or (not law.smooth and math.abs(before - after) <= 1e-12 * math.max(1.0, math.abs(before))): continue
        try kept_at.push(at[k])
        try kept_sizes.push(sizes[k])
    var name = Growing[u8]()
    defer name.close()
    try blend_name(w, e, tag, &name)
    let tool = try variable_tool(start, end, ua, ub, face_outward(w, fa), face_outward(w, fb), reach, weight, kept_at.view(), kept_sizes.view(), law.smooth, (str)name.view(), convex_edge, continuity, &ends)
    defer tool.release()
    return try combine(model, tool.value(), op_subtract if convex_edge else op_union)

## The planes a variable radius tool ends in, at its start and end
## (outward normals, offsets), where `slanted` (else it ends square).
struct EndPlanes:
    var n0: Vector3
    var h0: f64
    var slanted0: bool
    var n1: Vector3
    var h1: f64
    var slanted1: bool

## The radius of law piece `j` (points `positions`, `radii`) at `s`, its
## polynomial carried on outside the piece.
func piece_radius(positions: const f64[], radii: const f64[], smooth: bool, j: usize, s: f64) -> f64:
    let span = positions[j + 1] - positions[j]
    let t = (s - positions[j]) / span
    let blend = t * t * (3.0 - 2.0 * t) if smooth else t
    return radii[j] + (radii[j + 1] - radii[j]) * blend

## Where a row of a variable tool (the edge's point at `s` from `low` along
## `span`, plus law piece `j`'s radius times `q`) meets the plane n·x = h:
## Newton from `s`.
func row_meets(low: Vector3, span: Vector3, q: Vector3, positions: const f64[], radii: const f64[], smooth: bool, j: usize, n: Vector3, h: f64, s: f64) -> f64!:
    var x = s
    let step = 1e-7
    for _ in 0..<50:
        let f = n.dot(low.add(span.multiply_scalar(x)).add(q.multiply_scalar(piece_radius(positions, radii, smooth, j, x)))) - h
        let g = n.dot(low.add(span.multiply_scalar(x + step)).add(q.multiply_scalar(piece_radius(positions, radii, smooth, j, x + step)))) - h
        let slope = (g - f) / step
        if math.abs(slope) < 1e-12: error(invalid, "a variable radius fillet's strip runs along its end face")
        let next = x - f / slope
        if math.abs(next - x) <= 1e-14: return next
        x = next
    return x

## Whether the edge between faces `fa` and `fb` ends at vertex `v` at a
## flat face square to its way `along`.
func ends_square(w: const Shape*, v: i64, fa: usize, fb: usize, along: Vector3) -> bool:
    for f in 0..<w.faces.count:
        if f == fa or f == fb: continue
        var holds = false
        for use in w.face_uses(f):
            let o = w.edges.items[edge_index(use)]
            if o.start == v or o.end == v: holds = true
        if not holds: continue
        let s = &w.surfaces.items[(usize)w.faces.items[f].surface]
        if s.kind == surface_plane and math.abs(math.abs(s.z.dot(along)) - 1.0) < 1e-9: return true
    return false

## The tool of a variable radius fillet of the edge from `start` to `end`
## (faces' ways `ua`, `ub` into them and their outward normals `na`, `nb`,
## contacts `reach` r along each, a G1 arc's middle weight `weight`), its
## blend face named `name`, of `continuity`; `convex_edge` for a convex edge
## (the tool taken away; an inside one's, in the air, is added). Where
## `ends` says an end is slanted, each row of the net stops in that end's
## plane: its first (last) piece runs from there, the same polynomial, so
## every row keeps the knots and the end's section lies in the plane.
func variable_tool(start: Vector3, end: Vector3, ua: Vector3, ub: Vector3, na: Vector3, nb: Vector3, reach: f64, weight: f64, positions: const f64[], radii: const f64[], smooth: bool, name: str, convex_edge: bool, continuity: i64, ends: const EndPlanes*) -> interop.Reference[CadModel]!:
    let pieces = positions.length - 1
    let count = 3 * pieces + 1
    # Along: a cubic Bezier per piece, knots thrice at each point.
    var knots = Growing[f64]()
    defer knots.close()
    for _ in 0..<4: try knots.push(0.0)
    for k in 1..<pieces:
        for _ in 0..<3: try knots.push(positions[k])
    for _ in 0..<4: try knots.push(1.0)
    # The section at unit radius from the edge's point: control points
    # `unit_section` (contact a to contact b), their weights and knots.
    var unit_section = Growing[Vector3]()
    defer unit_section.close()
    var section_knots = Growing[f64]()
    defer section_knots.close()
    var section_weights = Growing[f64]()
    defer section_weights.close()
    var degree: i64 = 2
    if continuity == 1:
        try unit_section.push(ua.multiply_scalar(reach))
        try unit_section.push(Vector3())
        try unit_section.push(ub.multiply_scalar(reach))
        let k6: f64[6] = [0.0, 0.0, 0.0, 1.0, 1.0, 1.0]
        try section_knots.assign(k6[..<6])
        let x3: f64[3] = [1.0, weight, 1.0]
        try section_weights.assign(x3[..<3])
    else:
        try fillet_section(ua.multiply_scalar(reach), ub.multiply_scalar(reach), Vector3(), continuity, &unit_section, &section_knots)
        try section_weights.fill(unit_section.count, 1.0)
        degree = 5
    let rows = unit_section.count
    # The net, u (across: contact a to contact b) by v (along): along each
    # row, the edge's point plus r times its section point, each piece's
    # Bezier values from the piece's polynomial between the row's own ends
    # of it (a slanted end's plane, else the piece's points).
    var net = Growing[Vector3]()
    defer net.close()
    var weights = Growing[f64]()
    defer weights.close()
    let length = end.subtract(start)
    for u in 0..<rows:
        let q = unit_section.items[u]
        var first_s = 0.0
        var last_s = 1.0
        if ends.slanted0: first_s = try row_meets(start, length, q, positions, radii, smooth, 0, ends.n0, ends.h0, 0.0)
        if ends.slanted1: last_s = try row_meets(start, length, q, positions, radii, smooth, pieces - 1, ends.n1, ends.h1, 1.0)
        if first_s >= (positions[1] if pieces > 1 else last_s) or last_s <= (positions[pieces - 1] if pieces > 1 else first_s):
            error(invalid, "a variable radius fillet's slanted end reaches past its next radius point: move the point along")
        for j in 0..<pieces:
            let a = first_s if j == 0 else positions[j]
            let b = last_s if j == pieces - 1 else positions[j + 1]
            # The piece's cubic on [a, b] as a Bezier: its values at the
            # thirds, solved for the inner control values.
            let v0 = piece_radius(positions, radii, smooth, j, a)
            let v1 = piece_radius(positions, radii, smooth, j, a + (b - a) / 3.0)
            let v2 = piece_radius(positions, radii, smooth, j, a + (b - a) * 2.0 / 3.0)
            let v3 = piece_radius(positions, radii, smooth, j, b)
            let c1 = (-5.0 * v0 + 18.0 * v1 - 9.0 * v2 + 2.0 * v3) / 6.0
            let c2 = (2.0 * v0 - 9.0 * v1 + 18.0 * v2 - 5.0 * v3) / 6.0
            let values: f64[4] = [v0, c1, c2, v3]
            for m in 0..<(usize)4:
                if j > 0 and m == 0: continue
                let s = a + (b - a) * (f64)m / 3.0
                try net.push(start.add(length.multiply_scalar(s)).add(q.multiply_scalar(values[m])))
                try weights.push(section_weights.items[u])
    let middle_r = radius_at(positions, radii, smooth, 0.5)
    let last_row = (rows - 1) * count
    let size = length.length() + reach * radii[0] * 4.0
    let solid = try BrepModel.sized(size)
    defer solid.release()
    let b = solid.value()
    let e0 = try b.add_vertex(start)
    let e1 = try b.add_vertex(end)
    let a0 = try b.add_vertex(net.items[0])
    let a1 = try b.add_vertex(net.items[count - 1])
    let b0 = try b.add_vertex(net.items[last_row])
    let b1 = try b.add_vertex(net.items[last_row + count - 1])
    let ridge = try b.add_line(e0, e1)
    let to_a0 = try b.add_line(e0, a0)
    let to_b0 = try b.add_line(e0, b0)
    let to_a1 = try b.add_line(e1, a1)
    let to_b1 = try b.add_line(e1, b1)
    var row = Growing[Vector3]()
    defer row.close()
    var ones = Growing[f64]()
    defer ones.close()
    try ones.fill(count, 1.0)
    try row.assign(net.view()[0..<count])
    let curve_a = try b.add_spline_edge(a0, a1, row.view(), ones.view(), 3, knots.view(), true)
    try row.assign(net.view()[last_row..<last_row + count])
    let curve_b = try b.add_spline_edge(b0, b1, row.view(), ones.view(), 3, knots.view(), true)
    var first = Growing[Vector3]()
    defer first.close()
    var last = Growing[Vector3]()
    defer last.close()
    for u in 0..<rows:
        try first.push(net.items[u * count])
        try last.push(net.items[u * count + count - 1])
    let arc0 = try b.add_spline_edge(a0, b0, first.view(), section_weights.view(), degree, section_knots.view(), true)
    let arc1 = try b.add_spline_edge(a1, b1, last.view(), section_weights.view(), degree, section_knots.view(), true)
    # The blend face: outward toward the ball's center (away from the edge,
    # the tool lying between the edge and the face, either way).
    let surface = try b.add_spline_surface(net.view(), weights.view(), (i64)rows, (i64)count, degree, 3, section_knots.view(), knots.view())
    let middle = start.add(length.multiply_scalar(0.5))
    let bisector = try ua.add(ub).normalized()
    let center = middle.add(bisector.multiply_scalar(middle_r / weight))
    let arc_point = center.subtract(bisector.multiply_scalar(middle_r))
    let toward = center.subtract(arc_point)
    let sizes: i64[1] = [4]
    # Counterclockwise in (u, v), unit_section (a to b) by along: about du x dv.
    let du = net.items[last_row + count // 2].subtract(net.items[count // 2])
    let forward = du.cross(length).dot(toward) > 0.0
    let ahead: i64[4] = [arc0 + 1, curve_b + 1, -(arc1 + 1), -(curve_a + 1)]
    let back: i64[4] = [curve_a + 1, arc1 + 1, -(curve_b + 1), -(arc0 + 1)]
    let face = try b.add_face(surface, ahead[..<4] if forward else back[..<4], sizes[..<1], forward)
    try b.set_face_name(face, name)
    # The flat faces: on face a, on face b (the body's faces' own planes:
    # outward as the body's for a tool taken away, inward for one added),
    # and the two ends.
    let normal_a = na if convex_edge else na.multiply_scalar(-1.0)
    let normal_b = nb if convex_edge else nb.multiply_scalar(-1.0)
    let on_a: i64[4] = [ridge + 1, to_a1 + 1, -(curve_a + 1), -(to_a0 + 1)]
    let around_a: Vector3[4] = [start, end, net.items[count - 1], net.items[0]]
    try flat_face(b, start, normal_a, on_a[..<4], around_a[..<4])
    let on_b: i64[4] = [to_b0 + 1, curve_b + 1, -(to_b1 + 1), -(ridge + 1)]
    let around_b: Vector3[4] = [start, net.items[last_row], net.items[last_row + count - 1], end]
    try flat_face(b, start, normal_b, on_b[..<4], around_b[..<4])
    let way = try length.normalized()
    # The ends: square to the edge, or a slanted end's plane, facing away
    # from the tool.
    var start_normal = way.multiply_scalar(-1.0)
    if ends.slanted0: start_normal = ends.n0.multiply_scalar(1.0 if ends.n0.dot(way) < 0.0 else -1.0)
    var end_normal = way
    if ends.slanted1: end_normal = ends.n1.multiply_scalar(1.0 if ends.n1.dot(way) > 0.0 else -1.0)
    let at_start: i64[3] = [to_a0 + 1, arc0 + 1, -(to_b0 + 1)]
    let around_start: Vector3[3] = [start, net.items[0], net.items[last_row]]
    try flat_face(b, start, start_normal, at_start[..<3], around_start[..<3])
    let at_end: i64[3] = [to_b1 + 1, -(arc1 + 1), -(to_a1 + 1)]
    let around_end: Vector3[3] = [end, net.items[last_row + count - 1], net.items[count - 1]]
    try flat_face(b, end, end_normal, at_end[..<3], around_end[..<3])
    return try CadModel.of_brep(solid)
