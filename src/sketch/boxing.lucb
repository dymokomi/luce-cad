## Box selection in a sketch: what a screen box seen on the sketch plane
## holds. The view casts the box's corners onto the plane, a convex
## quadrilateral there (any convex polygon does); its points inside it are
## held, and its curves and texts wherever they meet it (Houdini's rule:
## touching is enough), as their samples say.

## How many samples a circle, arc or free-form curve is met by.
let box_samples: usize = 64

## The entities of `sketch` that the convex polygon `corners` (x, y pairs
## on the plane, in order round it either way) holds, ascending onto `out`
## (replacing it): points inside it, curves meeting it; `only` 1 points
## alone, 2 curves alone, 0 both.
func boxed_entities(sketch: const Sketch*, corners: const f64[], only: i64, out: Growing[i64]*) -> !:
    out.clear()
    if corners.length < 6 or corners.length % 2 != 0: error(invalid, "a sketch box is a polygon of three corners or more, as x, y pairs")
    for value in corners:
        if not math.is_finite(value): error(invalid, "a sketch box's corners must be finite")
    var samples = Growing[f64]()
    defer samples.close()
    for at in 0..<sketch.entities.count:
        let e = sketch.entities.items[at]
        let point = e.kind == EntityKind.point
        if (only == 1 and not point) or (only == 2 and point): continue
        if point:
            if polygon_holds(corners, sketch.x((i64)at), sketch.y((i64)at)): try out.push((i64)at)
            continue
        try sample_curve(sketch, e, box_samples, &samples)
        if polygon_meets(corners, samples.view()): try out.push((i64)at)

## Whether (`x`, `y`) is inside the convex polygon `corners` or on its
## edge.
func polygon_holds(corners: const f64[], x: f64, y: f64) -> bool:
    let count = corners.length // 2
    var above = false
    var below = false
    for k in 0..<count:
        let next = (k + 1) % count
        let side = side_of(corners[2 * k], corners[2 * k + 1], corners[2 * next], corners[2 * next + 1], x, y)
        above = above or side > 0.0
        below = below or side < 0.0
    return not (above and below)

## Whether the polyline `samples` (x, y pairs; a NaN pair breaks it) meets
## the convex polygon `corners`: a sample inside it, or a piece crossing
## one of its edges.
func polygon_meets(corners: const f64[], samples: const f64[]) -> bool:
    let count = samples.length // 2
    let sides = corners.length // 2
    for k in 0..<count:
        let x = samples[2 * k]
        let y = samples[2 * k + 1]
        if math.is_nan(x): continue
        if polygon_holds(corners, x, y): return true
        if k + 1 >= count or math.is_nan(samples[2 * k + 2]): continue
        for side in 0..<sides:
            let next = (side + 1) % sides
            if segments_cross(x, y, samples[2 * k + 2], samples[2 * k + 3], corners[2 * side], corners[2 * side + 1], corners[2 * next], corners[2 * next + 1]): return true
    return false

## Whether segments a-b and c-d cross or touch (lying along one line,
## whether they overlap).
func segments_cross(ax: f64, ay: f64, bx: f64, by: f64, cx: f64, cy: f64, dx: f64, dy: f64) -> bool:
    let d1 = side_of(cx, cy, dx, dy, ax, ay)
    let d2 = side_of(cx, cy, dx, dy, bx, by)
    let d3 = side_of(ax, ay, bx, by, cx, cy)
    let d4 = side_of(ax, ay, bx, by, dx, dy)
    if d1 == 0.0 and d2 == 0.0 and d3 == 0.0 and d4 == 0.0:
        return math.max(ax, bx) >= math.min(cx, dx) and math.max(cx, dx) >= math.min(ax, bx) and math.max(ay, by) >= math.min(cy, dy) and math.max(cy, dy) >= math.min(ay, by)
    return ((d1 >= 0.0 and d2 <= 0.0) or (d1 <= 0.0 and d2 >= 0.0)) and ((d3 >= 0.0 and d4 <= 0.0) or (d3 <= 0.0 and d4 >= 0.0))

## Which side of a-b (`x`, `y`) is: the cross product of a→b and a→it.
func side_of(ax: f64, ay: f64, bx: f64, by: f64, x: f64, y: f64) -> f64:
    return (bx - ax) * (y - ay) - (by - ay) * (x - ax)
