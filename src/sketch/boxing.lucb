## Box selection in a sketch: what a screen box seen on the sketch plane
## holds. The view casts the box's corners onto the plane, a convex
## quadrilateral there (any convex polygon does). What lies entirely inside
## it is held, Fusion's window rule in either drag direction: its points
## inside it, and its curves and texts with every sample inside it.

## How many samples a circle, arc or free-form curve is met by.
let box_samples: usize = 64

## The entities of `sketch` that the convex polygon `corners` (x, y pairs
## on the plane, in order round it either way) holds, ascending onto `out`
## (replacing it): points inside it, curves wholly inside it; `only` 1
## points alone, 2 curves alone, 0 both.
func boxed_entities(sketch: const Sketch*, corners: const f64[], only: i64, out: Growing[i64]*) -> !:
    out.clear()
    if corners.length < 6 or corners.length % 2 != 0: error(invalid, "a sketch box is a polygon of three corners or more, as x, y pairs")
    for value in corners:
        if not math.is_finite(value): error(invalid, "a sketch box's corners must be finite")
    var samples = Growing[f64]()
    defer samples.close()
    for at in 0..<sketch.entities.count:
        let e = sketch.entities.items[at]
        let point = e.kind == EntityKind.point
        if (only == 1 and not point) or (only == 2 and point) or e.origin != 0: continue
        if point:
            if polygon_holds(corners, sketch.x((i64)at), sketch.y((i64)at)): try out.push((i64)at)
            continue
        try sample_curve(sketch, e, box_samples, &samples)
        if polygon_contains(corners, samples.view()): try out.push((i64)at)

## Whether (`x`, `y`) is inside the convex polygon `corners` or on its
## edge.
func polygon_holds(corners: const f64[], x: f64, y: f64) -> bool:
    let count = corners.length // 2
    var above = false
    var below = false
    for k in 0..<count:
        let next = (k + 1) % count
        let side = side_of(corners[2 * k], corners[2 * k + 1], corners[2 * next], corners[2 * next + 1], x, y)
        above = above or side > 0.0
        below = below or side < 0.0
    return not (above and below)

## Whether every sample of `samples` (x, y pairs; NaN pairs break the
## line and are skipped) is inside the convex polygon `corners` or on its
## edge; a convex polygon holding every sample holds the curve between
## them to within the sampling.
func polygon_contains(corners: const f64[], samples: const f64[]) -> bool:
    var any = false
    for k in 0..<samples.length // 2:
        let x = samples[2 * k]
        let y = samples[2 * k + 1]
        if math.is_nan(x): continue
        if not polygon_holds(corners, x, y): return false
        any = true
    return any

## Which side of a-b (`x`, `y`) is: the cross product of a→b and a→it.
func side_of(ax: f64, ay: f64, bx: f64, by: f64, x: f64, y: f64) -> f64:
    return (bx - ax) * (y - ay) - (by - ay) * (x - ax)
