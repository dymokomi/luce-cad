## Fusion 360's MODIFY tools on a sketch's curves: Trim takes away the piece
## of a curve between the nearest crossings round where it is picked;
## Extend runs a line's or arc's nearest end on to the next curve in its
## way; Break splits a curve at the crossings round where it is picked;
## Fillet and Chamfer round or cut the corner where two lines meet; Offset
## copies a chain of curves a distance to one side; Move/Copy and Scale act
## on entities. New end_xy lie on the curves they were cut at (point-on-curve
## constraints keep them there), as Fusion's coincident constraints do. A
## piece split off a line stays collinear with it; one split off an arc
## keeps its circle (the center shared, the radius equal).
##
## A place along a curve: a line's from 0 at its start to 1 at its end; an
## arc's the same along its sweep; a circle's an angle (radians).

## Where curve `other` crosses (or touches) a curve: the place along it and
## the point.
struct Crossing:
    var place: f64
    var x: f64
    var y: f64
    var other: i64

## Remove the piece of curve `curve` round plane point (`qx`, `qy`) between
## its nearest crossings (or its end_xy): the whole curve when nothing
## crosses it.
pub func trim_curve(sketch: Sketch*, curve: i64, qx: f64, qy: f64) -> !:
    try require_curve(sketch, curve)
    var found = Growing[Crossing]()
    defer found.close()
    try crossings(sketch, curve, &found)
    let e = sketch.entity(curve)
    let here = place_of(sketch, curve, qx, qy)
    if e.kind == EntityKind.circle:
        if found.count < 2:
            try sketch.remove(curve)
            return
        # The arc kept runs counterclockwise from the crossing after the
        # pick round to the one before it.
        let (before, after) = around_angle(&found, here)
        # The circle becomes the arc in place (its center and radius kept).
        try to_arc(sketch, curve, try point_at(sketch, &found.items[after]), try point_at(sketch, &found.items[before]))
        return
    let (low, high) = around(&found, here)
    if low < 0 and high < 0:
        try sketch.remove(curve)
        return
    if low < 0:
        # The start piece goes: the curve start_xy at the crossing after.
        try set_end(sketch, curve, true, &found.items[(usize)high])
    elif high < 0:
        try set_end(sketch, curve, false, &found.items[(usize)low])
    else:
        # A middle piece: the curve end_xy at the crossing before; a new
        # piece goes on from the crossing after to the old end.
        let piece = try split_off(sketch, curve, &found.items[(usize)high])
        _ = piece
        try set_end(sketch, curve, false, &found.items[(usize)low])

## Split curve `curve` at the crossings round plane point (`qx`, `qy`):
## the piece between them becomes a curve of its own.
pub func break_curve(sketch: Sketch*, curve: i64, qx: f64, qy: f64) -> !:
    try require_curve(sketch, curve)
    var found = Growing[Crossing]()
    defer found.close()
    try crossings(sketch, curve, &found)
    let e = sketch.entity(curve)
    if e.kind == EntityKind.circle:
        # A circle breaks into two arcs at the crossings round the pick.
        if found.count < 2: error(invalid, "a circle breaks where two curves cross it")
        let (before, after) = around_angle(&found, place_of(sketch, curve, qx, qy))
        let a = try point_at(sketch, &found.items[before])
        let b = try point_at(sketch, &found.items[after])
        # The circle becomes one arc in place; the other is new, on its
        # circle.
        try to_arc(sketch, curve, a, b)
        let other = try sketch.add_arc(e.first, b, a, e.construction)
        _ = try sketch.constrain(ConstraintKind.equal, curve, other)
        return
    let (low, high) = around(&found, place_of(sketch, curve, qx, qy))
    if low < 0 and high < 0: error(invalid, "no curve crosses this one to break it at")
    # The far crossing first, so the near one's place still holds.
    if high >= 0: _ = try split_off(sketch, curve, &found.items[(usize)high])
    if low >= 0: _ = try split_off(sketch, curve, &found.items[(usize)low])

## Run the end of line or arc `curve` nearest plane point (`qx`, `qy`) on to
## the first curve in its way.
pub func extend_curve(sketch: Sketch*, curve: i64, qx: f64, qy: f64) -> !:
    try require_curve(sketch, curve)
    let e = sketch.entity(curve)
    if e.kind == EntityKind.circle: error(invalid, "a circle has no end to extend")
    let here = place_of(sketch, curve, qx, qy)
    let at_start = here < 0.5
    var best = Crossing(0.0, 0.0, 0.0, -1)
    var best_reach = math.infinity
    for other in 0..<(i64)sketch.entities.count:
        if other == curve or sketch.entity(other).kind == EntityKind.point: continue
        var hits = Growing[Crossing]()
        defer hits.close()
        try meet(sketch, curve, other, true, &hits)
        for h in hits.view():
            # Beyond the end being extended: below 0 for the start, above 1
            # for the end (arcs: past their sweep, the shorter way round).
            let reach = -h.place if at_start else h.place - 1.0
            if reach > 1e-9 and reach < best_reach:
                best_reach = reach
                best = h
    if best.other < 0: error(invalid, "nothing lies in this end's way to extend it to")
    try set_end(sketch, curve, at_start, &best)

## Round the corner of lines `first` and `second` (sharing a point) with an
## arc of `radius` tangent to both, the lines shortened to it: Fusion's
## sketch fillet (tangent constraints and a radius dimension added).
pub func fillet_corner(sketch: Sketch*, first: i64, second: i64, radius: f64) -> i64!:
    let (corner, a_far, b_far) = try corner_of(sketch, first, second)
    let cx = sketch.x(corner)
    let cy = sketch.y(corner)
    let (ux, uy) = unit_vector(sketch.x(a_far) - cx, sketch.y(a_far) - cy)
    let (vx, vy) = unit_vector(sketch.x(b_far) - cx, sketch.y(b_far) - cy)
    let turn = math.acos(math.max(-1.0, math.min(1.0, ux * vx + uy * vy)))
    if turn < 1e-6 or turn > math.pi - 1e-6: error(invalid, "lines in line have no corner to fillet")
    let reach = radius / math.tan(turn * 0.5)
    if reach >= math.hypot(sketch.x(a_far) - cx, sketch.y(a_far) - cy) or reach >= math.hypot(sketch.x(b_far) - cx, sketch.y(b_far) - cy):
        error(invalid, "the fillet is larger than its lines")
    let (bx, by) = unit_vector(ux + vx, uy + vy)
    let away = radius / math.sin(turn * 0.5)
    let ta = try sketch.add_point(cx + ux * reach, cy + uy * reach)
    let tb = try sketch.add_point(cx + vx * reach, cy + vy * reach)
    try replace_end(sketch, first, corner, ta)
    try replace_end(sketch, second, corner, tb)
    # The corner, used by nothing else now, is the arc's center.
    let center = try reused(sketch, corner, cx + bx * away, cy + by * away)
    # Counterclockwise from one tangent point to the other the short way.
    let cross = ux * vy - uy * vx
    let arc = try sketch.add_arc(center, tb if cross > 0.0 else ta, ta if cross > 0.0 else tb)
    _ = try sketch.constrain(ConstraintKind.tangent, first, arc, side = line_side(sketch, first, center))
    _ = try sketch.constrain(ConstraintKind.tangent, second, arc, side = line_side(sketch, second, center))
    _ = try sketch.constrain(ConstraintKind.radius, arc, value = radius)
    return arc

## Cut the corner of lines `first` and `second` (sharing a point) by a line
## `distance` along each from it, the lines shortened to it.
pub func chamfer_corner(sketch: Sketch*, first: i64, second: i64, distance: f64) -> i64!:
    let (corner, a_far, b_far) = try corner_of(sketch, first, second)
    let cx = sketch.x(corner)
    let cy = sketch.y(corner)
    if distance >= math.hypot(sketch.x(a_far) - cx, sketch.y(a_far) - cy) or distance >= math.hypot(sketch.x(b_far) - cx, sketch.y(b_far) - cy):
        error(invalid, "the chamfer is longer than its lines")
    let (ux, uy) = unit_vector(sketch.x(a_far) - cx, sketch.y(a_far) - cy)
    let (vx, vy) = unit_vector(sketch.x(b_far) - cx, sketch.y(b_far) - cy)
    let tb = try sketch.add_point(cx + vx * distance, cy + vy * distance)
    try replace_end(sketch, second, corner, tb)
    # The corner, now only the first line's, moves to its end of the cut.
    let ta = try reused(sketch, corner, cx + ux * distance, cy + uy * distance, first)
    if ta != corner: try replace_end(sketch, first, corner, ta)
    return try sketch.add_line(ta, tb)

## Copies of the connected chain `curves` (lines and arcs end to end) a
## `distance` to the side of plane point (`qx`, `qy`), neighbors meeting
## again where their copies cross; the new curves onto `out` (lines kept
## parallel to theirs).
pub func offset_chain(sketch: Sketch*, curves: const i64[], distance: f64, qx: f64, qy: f64, out: Growing[i64]*) -> !:
    if curves.length == 0: error(invalid, "offset needs curves")
    for c in curves: try require_curve(sketch, c)
    let side = 1.0 if signed_side(sketch, curves[0], qx, qy) >= 0.0 else -1.0
    # Each copy's carrier, and its end_xy as offset (before joining).
    var carriers = Growing[Carrier]()
    defer carriers.close()
    for c in curves: try carriers.push(try offset_carrier(sketch, c, distance, side, qx, qy))
    let closed = curves.length > 1 and try chain_closed(sketch, curves)
    let n = curves.length
    # Where each copy start_xy and end_xy: at its neighbors' meeting points.
    var start_xy = Growing[f64]()
    defer start_xy.close()
    var end_xy = Growing[f64]()
    defer end_xy.close()
    for at in 0..<n:
        let k = carriers.items[at]
        try start_xy.push(k.sx)
        try start_xy.push(k.sy)
        try end_xy.push(k.ex)
        try end_xy.push(k.ey)
    for at in 0..<n:
        if at + 1 == n and not closed: break
        let next = (at + 1) % n
        let (x, y) = joint(&carriers.items[at], &carriers.items[next])
        end_xy.items[at * 2] = x
        end_xy.items[at * 2 + 1] = y
        start_xy.items[next * 2] = x
        start_xy.items[next * 2 + 1] = y
    # Points, each joint once: a copy start_xy where the one before end_xy.
    var start_points = Growing[i64]()
    defer start_points.close()
    var end_points = Growing[i64]()
    defer end_points.close()
    try start_points.push(try sketch.add_point(start_xy.items[0], start_xy.items[1]))
    for at in 0..<n:
        let last = at + 1 == n
        let p = start_points.items[0] if last and closed else try sketch.add_point(end_xy.items[at * 2], end_xy.items[at * 2 + 1])
        try end_points.push(p)
        if not last: try start_points.push(p)
    for at in 0..<n:
        let c = curves[at]
        let e = sketch.entity(c)
        let k = carriers.items[at]
        if k.line:
            try out.push(try sketch.add_line(start_points.items[at], end_points.items[at], e.construction))
            _ = try sketch.constrain(ConstraintKind.parallel, c, out.items[out.count - 1])
        elif e.kind == EntityKind.circle:
            try out.push(try sketch.add_circle(e.first, k.r, e.construction))
        else:
            let made = try sketch.add_arc(e.first, start_points.items[at], end_points.items[at], e.construction)
            sketch.params.items[(usize)sketch.entity(made).second] = k.r
            try out.push(made)

## A curve's offset copy as a line or a circle, with its end_xy.
struct Carrier:
    var line: bool
    var x: f64
    var y: f64
    var dx: f64
    var dy: f64
    var r: f64
    var sx: f64
    var sy: f64
    var ex: f64
    var ey: f64

## Curve `c` moved `distance` to `side` of it (lines: left is +1; arcs and
## circles: toward plane point (`qx`, `qy`) when it is outside them, the
## radius growing).
func offset_carrier(sketch: const Sketch*, c: i64, distance: f64, side: f64, qx: f64, qy: f64) -> Carrier!:
    let e = sketch.entity(c)
    if e.kind == EntityKind.line:
        let (ax, ay, dx, dy) = line_of(sketch, e)
        let (ux, uy) = unit_vector(dx, dy)
        let d = distance * side
        return Carrier(true, ax - uy * d, ay + ux * d, dx, dy, 0.0, ax - uy * d, ay + ux * d, ax + dx - uy * d, ay + dy + ux * d)
    let cx = sketch.x(e.first)
    let cy = sketch.y(e.first)
    let r = sketch.radius_of(c)
    let outward = math.hypot(qx - cx, qy - cy) > r
    let nr = r + distance if outward else r - distance
    if nr <= 0.0: error(invalid, "the offset is larger than an arc's radius")
    if e.kind == EntityKind.circle: return Carrier(false, cx, cy, 0.0, 0.0, nr, cx, cy, cx, cy)
    let (sx, sy) = scaled_from(sketch, e.first, e.third, nr / r)
    let (tx, ty) = scaled_from(sketch, e.first, e.fourth, nr / r)
    return Carrier(false, cx, cy, 0.0, 0.0, nr, sx, sy, tx, ty)

## Where copies `a` (its end) and `b` (its start) meet: their carriers'
## crossing nearest the gap between them, or the gap's middle.
func joint(a: const Carrier*, b: const Carrier*) -> (f64, f64):
    let gx = (a.ex + b.sx) * 0.5
    let gy = (a.ey + b.sy) * 0.5
    var best_x = gx
    var best_y = gy
    var best = math.infinity
    var hits: f64[4] = [0.0, 0.0, 0.0, 0.0]
    var count: usize = 0
    if a.line and b.line:
        let d = a.dx * b.dy - a.dy * b.dx
        if math.abs(d) > 1e-12 * math.hypot(a.dx, a.dy) * math.hypot(b.dx, b.dy):
            let t = ((b.x - a.x) * b.dy - (b.y - a.y) * b.dx) / d
            hits[0] = a.x + t * a.dx
            hits[1] = a.y + t * a.dy
            count = 1
    elif a.line or b.line:
        let line = a if a.line else b
        let round = b if a.line else a
        let l2 = line.dx * line.dx + line.dy * line.dy
        let fx = line.x - round.x
        let fy = line.y - round.y
        let half_b = fx * line.dx + fy * line.dy
        let disc = half_b * half_b - l2 * (fx * fx + fy * fy - round.r * round.r)
        if disc >= 0.0:
            let root = math.sqrt(disc)
            for at in 0..<(usize)2:
                let t = (-half_b + (root if at == 1 else -root)) / l2
                hits[at * 2] = line.x + t * line.dx
                hits[at * 2 + 1] = line.y + t * line.dy
            count = 2
    else:
        let d = math.hypot(b.x - a.x, b.y - a.y)
        if d > 0.0 and d <= a.r + b.r and d >= math.abs(a.r - b.r):
            let along = (a.r * a.r - b.r * b.r + d * d) / (2.0 * d)
            let h = math.sqrt(math.max(0.0, a.r * a.r - along * along))
            let ux = (b.x - a.x) / d
            let uy = (b.y - a.y) / d
            for at in 0..<(usize)2:
                let s = -1.0 if at == 0 else 1.0
                hits[at * 2] = a.x + along * ux - s * h * uy
                hits[at * 2 + 1] = a.y + along * uy + s * h * ux
            count = 2
    for at in 0..<count:
        let dist = math.hypot(hits[at * 2] - gx, hits[at * 2 + 1] - gy)
        if dist < best:
            best = dist
            best_x = hits[at * 2]
            best_y = hits[at * 2 + 1]
    return (best_x, best_y)

## Move the points of `entities` by (`dx`, `dy`), or move copies of them
## (`copy`): the copies onto `out`.
pub func move_entities(sketch: Sketch*, entities: const i64[], dx: f64, dy: f64, copy: bool, out: Growing[i64]*) -> !:
    var points = Growing[i64]()
    defer points.close()
    for e in entities: try points_of(sketch, e, &points)
    if not copy:
        for p in points.view():
            sketch.place(p, sketch.x(p) + dx, sketch.y(p) + dy)
        return
    # Copies: each point once, the curves on the copied points.
    var copies = Growing[i64]()
    defer copies.close()
    for p in points.view(): try copies.push(try sketch.add_point(sketch.x(p) + dx, sketch.y(p) + dy))
    for e in entities:
        let made = try copied(sketch, e, &points, &copies)
        if made >= 0: try out.push(made)

## Copies of `entities` mirrored about line `axis`, each copied point held
## symmetric to its original about it; the copies onto `out`.
pub func mirror_entities(sketch: Sketch*, entities: const i64[], axis: i64, out: Growing[i64]*) -> !:
    let a = sketch.entity(axis)
    if a.kind != EntityKind.line: error(invalid, "a mirror is about a line")
    let (ax, ay, dx, dy) = line_of(sketch, a)
    let (ux, uy) = unit_vector(dx, dy)
    var points = Growing[i64]()
    defer points.close()
    for e in entities:
        if e != axis: try points_of(sketch, e, &points)
    var copies = Growing[i64]()
    defer copies.close()
    for p in points.view():
        # Reflect across the line: p' = 2 (a + ((p - a)·u) u) - p.
        let wx = sketch.x(p) - ax
        let wy = sketch.y(p) - ay
        let along = wx * ux + wy * uy
        let fx = ax + along * ux
        let fy = ay + along * uy
        let made = try sketch.add_point(2.0 * fx - sketch.x(p), 2.0 * fy - sketch.y(p))
        try copies.push(made)
        _ = try sketch.constrain(ConstraintKind.symmetric, p, made, axis)
    for e in entities:
        if e == axis: continue
        let made = try copied(sketch, e, &points, &copies)
        # A mirrored arc turns the other way: its ends swap.
        if made >= 0 and sketch.entity(made).kind == EntityKind.arc:
            let start = sketch.entity(made).third
            sketch.entities.items[(usize)made].third = sketch.entity(made).fourth
            sketch.entities.items[(usize)made].fourth = start
        if made >= 0: try out.push(made)

## `count` - 1 copies of `entities`, each turned `angle` (radians) further
## about plane point (`cx`, `cy`) (Circular Pattern); the copies onto `out`.
pub func pattern_round(sketch: Sketch*, entities: const i64[], cx: f64, cy: f64, count: i64, angle: f64, out: Growing[i64]*) -> !:
    if count < 2: error(invalid, "a pattern needs two or more")
    for k in 1..<count:
        let turn = angle * (f64)k
        try copy_placed(sketch, entities, cx, cy, math.cos(turn), math.sin(turn), 0.0, 0.0, out)

## `count` - 1 copies of `entities`, each (`dx`, `dy`) further on
## (Rectangular Pattern, one direction); the copies onto `out`.
pub func pattern_along(sketch: Sketch*, entities: const i64[], dx: f64, dy: f64, count: i64, out: Growing[i64]*) -> !:
    if count < 2: error(invalid, "a pattern needs two or more")
    for k in 1..<count:
        try copy_placed(sketch, entities, 0.0, 0.0, 1.0, 0.0, dx * (f64)k, dy * (f64)k, out)

## Copies of `entities` turned (cosine `c`, sine `s`) about (`cx`, `cy`)
## then moved (`tx`, `ty`).
func copy_placed(sketch: Sketch*, entities: const i64[], cx: f64, cy: f64, c: f64, s: f64, tx: f64, ty: f64, out: Growing[i64]*) -> !:
    var points = Growing[i64]()
    defer points.close()
    for e in entities: try points_of(sketch, e, &points)
    var copies = Growing[i64]()
    defer copies.close()
    for p in points.view():
        let x = sketch.x(p) - cx
        let y = sketch.y(p) - cy
        try copies.push(try sketch.add_point(cx + c * x - s * y + tx, cy + s * x + c * y + ty))
    for e in entities:
        let made = try copied(sketch, e, &points, &copies)
        if made >= 0: try out.push(made)

## Scale `entities` about plane point (`cx`, `cy`) by `factor`.
pub func scale_entities(sketch: Sketch*, entities: const i64[], cx: f64, cy: f64, factor: f64) -> !:
    if not (factor > 0.0): error(invalid, "a scale needs a positive factor")
    var points = Growing[i64]()
    defer points.close()
    for e in entities: try points_of(sketch, e, &points)
    for p in points.view():
        sketch.place(p, cx + (sketch.x(p) - cx) * factor, cy + (sketch.y(p) - cy) * factor)
    for e in entities:
        let k = sketch.entity(e).kind
        if k == EntityKind.circle or k == EntityKind.arc:
            sketch.params.items[(usize)sketch.entity(e).second] *= factor
    # Dimensions of what scaled scale with it.
    for at in 0..<sketch.constraints.count:
        let c = sketch.constraints.items[at]
        if c.kind == ConstraintKind.angle or (u8)c.kind < (u8)ConstraintKind.distance: continue
        if contains(entities, c.first) or contains(entities, c.second) or touches(sketch, entities, c.first):
            sketch.constraints.items[at].value = c.value * factor

# -- Crossings.

## Every place other curves cross or touch curve `curve`, sorted.
func crossings(sketch: const Sketch*, curve: i64, out: Growing[Crossing]*) -> !:
    for other in 0..<(i64)sketch.entities.count:
        if other == curve or sketch.entity(other).kind == EntityKind.point: continue
        try meet(sketch, curve, other, false, out)
    # Places sorted, near repeats once.
    for i in 1..<out.count:
        let v = out.items[i]
        var j = i
        while j > 0 and out.items[j - 1].place > v.place:
            out.items[j] = out.items[j - 1]
            j -= 1
        out.items[j] = v
    var kept: usize = 0
    for at in 0..<out.count:
        if kept > 0 and math.abs(out.items[at].place - out.items[kept - 1].place) <= 1e-9: continue
        out.items[kept] = out.items[at]
        kept += 1
    out.count = kept

## Where curve `other` meets curve `curve` (as places along `curve`); with
## `beyond`, `curve` counts as running on past its end_xy (lines as lines,
## arcs round their circle), for Extend.
func meet(sketch: const Sketch*, curve: i64, other: i64, beyond: bool, out: Growing[Crossing]*) -> !:
    let a = sketch.entity(curve)
    let b = sketch.entity(other)
    let size = size_of(sketch)
    let tolerance = 1e-9 * size
    var hits = Growing[f64]()
    defer hits.close()
    # Points (x, y) common to both carriers.
    if a.kind == EntityKind.line and b.kind == EntityKind.line:
        let (ax, ay, dx, dy) = line_of(sketch, a)
        let (bx, by, ex, ey) = line_of(sketch, b)
        let d = dx * ey - dy * ex
        if math.abs(d) <= 1e-12 * math.hypot(dx, dy) * math.hypot(ex, ey): return
        let t = ((bx - ax) * ey - (by - ay) * ex) / d
        try hits.push(ax + t * dx)
        try hits.push(ay + t * dy)
    elif a.kind == EntityKind.line or b.kind == EntityKind.line:
        let line = a if a.kind == EntityKind.line else b
        let round = b if a.kind == EntityKind.line else a
        let (sx, sy, dx, dy) = line_of(sketch, line)
        let cx = sketch.x(round.first)
        let cy = sketch.y(round.first)
        let r = sketch.params.items[(usize)round.second]
        let l2 = dx * dx + dy * dy
        let fx = sx - cx
        let fy = sy - cy
        let half_b = fx * dx + fy * dy
        let disc = half_b * half_b - l2 * (fx * fx + fy * fy - r * r)
        if disc < -2.0 * r * tolerance * l2: return
        let root = math.sqrt(math.max(0.0, disc))
        for t in [(-half_b - root) / l2, (-half_b + root) / l2]:
            try hits.push(sx + t * dx)
            try hits.push(sy + t * dy)
            if root == 0.0: break
    else:
        let c1x = sketch.x(a.first)
        let c1y = sketch.y(a.first)
        let c2x = sketch.x(b.first)
        let c2y = sketch.y(b.first)
        let r1 = sketch.params.items[(usize)a.second]
        let r2 = sketch.params.items[(usize)b.second]
        let d = math.hypot(c2x - c1x, c2y - c1y)
        if d <= tolerance or d > r1 + r2 + tolerance or d < math.abs(r1 - r2) - tolerance: return
        let along = (r1 * r1 - r2 * r2 + d * d) / (2.0 * d)
        let h = math.sqrt(math.max(0.0, r1 * r1 - along * along))
        let ux = (c2x - c1x) / d
        let uy = (c2y - c1y) / d
        for s in [-1.0, 1.0]:
            try hits.push(c1x + along * ux - s * h * uy)
            try hits.push(c1y + along * uy + s * h * ux)
            if h == 0.0: break
    var at: usize = 0
    while at + 1 < hits.count:
        let x = hits.items[at]
        let y = hits.items[at + 1]
        at += 2
        # On `other` as it is, on `curve` (as far as it runs).
        if not on_curve(sketch, other, x, y, tolerance * 1000.0, false): continue
        if not on_curve(sketch, curve, x, y, tolerance * 1000.0, beyond): continue
        try out.push(Crossing(place_of(sketch, curve, x, y), x, y, other))

## Whether (`x`, `y`) on its curve's carrier lies on curve `curve` itself
## (with `beyond`, anywhere on a line's line or an arc's circle).
func on_curve(sketch: const Sketch*, curve: i64, x: f64, y: f64, slack: f64, beyond: bool) -> bool:
    let e = sketch.entity(curve)
    if e.kind == EntityKind.circle or beyond: return true
    let length = curve_length(sketch, curve)
    let place = place_of(sketch, curve, x, y)
    return place >= -slack / length and place <= 1.0 + slack / length

## The place along curve `curve` nearest (`x`, `y`) (not limited to the
## curve: a line's place can be below 0 or above 1, an arc's past its
## sweep counts round from its start).
func place_of(sketch: const Sketch*, curve: i64, x: f64, y: f64) -> f64:
    let e = sketch.entity(curve)
    if e.kind == EntityKind.line:
        let (ax, ay, dx, dy) = line_of(sketch, e)
        return ((x - ax) * dx + (y - ay) * dy) / math.max(dx * dx + dy * dy, 1e-300)
    let cx = sketch.x(e.first)
    let cy = sketch.y(e.first)
    let angle = math.atan2(y - cy, x - cx)
    if e.kind == EntityKind.circle:
        return angle if angle >= 0.0 else angle + 2.0 * math.pi
    let start = math.atan2(sketch.y(e.third) - cy, sketch.x(e.third) - cx)
    var sweep = math.atan2(sketch.y(e.fourth) - cy, sketch.x(e.fourth) - cx) - start
    while sweep <= 0.0: sweep += 2.0 * math.pi
    var turn = angle - start
    while turn < 0.0: turn += 2.0 * math.pi
    # Past the end: the shorter way, before the start (negative) or after
    # the end.
    if turn > sweep and turn - sweep > 2.0 * math.pi - turn: turn -= 2.0 * math.pi
    return turn / sweep

## The crossings just before and after place `here` (-1: none, the curve's
## own end).
func around(found: const Growing[Crossing]*, here: f64) -> (i64, i64):
    var low: i64 = -1
    var high: i64 = -1
    for at in 0..<found.count:
        let p = found.items[at].place
        # Crossings at a curve's own end_xy are its end_xy.
        if p <= 1e-9 or p >= 1.0 - 1e-9: continue
        if p < here: low = (i64)at
        elif high < 0: high = (i64)at
    return (low, high)

## On a circle: the crossings before and after angle `here`, round.
func around_angle(found: const Growing[Crossing]*, here: f64) -> (usize, usize):
    var after: usize = 0
    var seen = false
    for at in 0..<found.count:
        if found.items[at].place > here and not seen:
            after = at
            seen = true
    if not seen: after = 0
    let before = (after + found.count - 1) % found.count
    return (before, after)

# -- Edits.

## Curve `curve`'s start (`start`) or end moved to crossing `c`: a new
## point there on the curve that crossed, the old point dropped when
## nothing else uses it.
func set_end(sketch: Sketch*, curve: i64, start: bool, c: const Crossing*) -> !:
    let e = sketch.entity(curve)
    let old = (e.first if start else e.second) if e.kind == EntityKind.line else (e.third if start else e.fourth)
    # The old end moves there when nothing else uses it (its constraints
    # go: they held the part cut away); else the curve gets a new point.
    let p = try reused(sketch, old, c.x, c.y, curve)
    if c.other >= 0: _ = try sketch.constrain(ConstraintKind.on_curve, p, c.other)
    if p == old: return
    if e.kind == EntityKind.line:
        if start: sketch.entities.items[(usize)curve].first = p
        else: sketch.entities.items[(usize)curve].second = p
    else:
        if start: sketch.entities.items[(usize)curve].third = p
        else: sketch.entities.items[(usize)curve].fourth = p

## A new curve from crossing `c` on to curve `curve`'s end, `curve` then
## ending at the crossing (a new point, on the curve that crossed); the new
## curve, collinear with a line or on an arc's circle.
func split_off(sketch: Sketch*, curve: i64, c: const Crossing*) -> i64!:
    let e = sketch.entity(curve)
    let p = try point_at(sketch, c)
    var made: i64 = -1
    if e.kind == EntityKind.line:
        made = try sketch.add_line(p, e.second, e.construction)
        sketch.entities.items[(usize)curve].second = p
        _ = try sketch.constrain(ConstraintKind.collinear, curve, made)
    else:
        made = try sketch.add_arc(e.first, p, e.fourth, e.construction)
        sketch.entities.items[(usize)curve].fourth = p
        _ = try sketch.constrain(ConstraintKind.equal, curve, made)
    return made

## A point at crossing `c`, held on the curve that crossed there.
func point_at(sketch: Sketch*, c: const Crossing*) -> i64!:
    let p = try sketch.add_point(c.x, c.y)
    if c.other >= 0: _ = try sketch.constrain(ConstraintKind.on_curve, p, c.other)
    return p

## `curve`'s end at point `old` moved to point `new`.
func replace_end(sketch: Sketch*, curve: i64, old: i64, new_point: i64) -> !:
    let e = sketch.entity(curve)
    if e.first == old: sketch.entities.items[(usize)curve].first = new_point
    elif e.second == old: sketch.entities.items[(usize)curve].second = new_point
    else: error(invalid, "a line does not end at the corner")

## Point `point` moved to (`x`, `y`) when no curve but `owner` uses it
## (its constraints going with what it was), else a new point there.
func reused(sketch: Sketch*, point: i64, x: f64, y: f64, owner: i64 = -1) -> i64!:
    for at in 0..<sketch.entities.count:
        let e = sketch.entities.items[at]
        if e.kind == EntityKind.point or (i64)at == owner: continue
        let uses = e.first == point or e.third == point or e.fourth == point or (e.kind == EntityKind.line and e.second == point)
        if uses: return try sketch.add_point(x, y)
    var at = sketch.constraints.count
    while at > 0:
        at -= 1
        let k = sketch.constraints.items[at]
        if k.first == point or k.second == point or k.third == point: try sketch.unconstrain((i64)at)
    sketch.place(point, x, y)
    return point

## Circle `curve` as an arc in place, from point `start` counterclockwise
## to `end` (its center and radius kept; constraints on the circle stay).
func to_arc(sketch: Sketch*, curve: i64, start: i64, end: i64) -> !:
    sketch.entities.items[(usize)curve].kind = EntityKind.arc
    sketch.entities.items[(usize)curve].third = start
    sketch.entities.items[(usize)curve].fourth = end

## Lines `first` and `second`: the point they share and each one's other end.
func corner_of(sketch: const Sketch*, first: i64, second: i64) -> (i64, i64, i64)!:
    let a = sketch.entity(first)
    let b = sketch.entity(second)
    if a.kind != EntityKind.line or b.kind != EntityKind.line: error(invalid, "a sketch fillet or chamfer joins two lines")
    if a.first == b.first: return (a.first, a.second, b.second)
    if a.first == b.second: return (a.first, a.second, b.first)
    if a.second == b.first: return (a.second, a.first, b.second)
    if a.second == b.second: return (a.second, a.first, b.first)
    error(invalid, "the lines do not meet at a point: pick two that share a corner")

## Which side of line `line` point `point` is (+1 left, -1 right), as the
## tangent constraint keeps it.
func line_side(sketch: const Sketch*, line: i64, point: i64) -> f64:
    return 1.0 if signed_side(sketch, line, sketch.x(point), sketch.y(point)) >= 0.0 else -1.0

## How far left of curve `curve` (`x`, `y`) is (a line: of its direction;
## an arc or circle: outside it is positive).
func signed_side(sketch: const Sketch*, curve: i64, x: f64, y: f64) -> f64:
    let e = sketch.entity(curve)
    if e.kind == EntityKind.line:
        let (ax, ay, dx, dy) = line_of(sketch, e)
        return (dx * (y - ay) - dy * (x - ax)) / math.max(math.hypot(dx, dy), 1e-300)
    return math.hypot(x - sketch.x(e.first), y - sketch.y(e.first)) - sketch.radius_of(curve)

## Whether the chain `curves` closes (its last curve end_xy where the first
## start_xy).
func chain_closed(sketch: const Sketch*, curves: const i64[]) -> bool!:
    let first = sketch.entity(curves[0])
    let last = sketch.entity(curves[curves.length - 1])
    let start = first.first if first.kind == EntityKind.line else first.third
    let end = last.second if last.kind == EntityKind.line else last.fourth
    return start == end or math.hypot(sketch.x(start) - sketch.x(end), sketch.y(start) - sketch.y(end)) <= 1e-9 * size_of(sketch)

## The points of entity `e` onto `out` (each once).
func points_of(sketch: const Sketch*, e: i64, out: Growing[i64]*) -> !:
    let x = sketch.entity(e)
    if x.kind == EntityKind.point:
        try add_once(out, e)
        return
    try add_once(out, x.first)
    if x.kind == EntityKind.line: try add_once(out, x.second)
    if x.kind == EntityKind.arc:
        try add_once(out, x.third)
        try add_once(out, x.fourth)

## A copy of entity `e` on the copied points (`points`' copies in
## `copies`), or -1 for a point (copied already).
func copied(sketch: Sketch*, e: i64, points: const Growing[i64]*, copies: const Growing[i64]*) -> i64!:
    let x = sketch.entity(e)
    if x.kind == EntityKind.point: return copies.items[index_in(points, e)]
    let first = copies.items[index_in(points, x.first)]
    if x.kind == EntityKind.line: return try sketch.add_line(first, copies.items[index_in(points, x.second)], x.construction)
    if x.kind == EntityKind.circle: return try sketch.add_circle(first, sketch.radius_of(e), x.construction)
    return try sketch.add_arc(first, copies.items[index_in(points, x.third)], copies.items[index_in(points, x.fourth)], x.construction)

func index_in(values: const Growing[i64]*, value: i64) -> usize:
    for at in 0..<values.count:
        if values.items[at] == value: return at
    return 0

func add_once(out: Growing[i64]*, value: i64) -> !:
    for v in out.view():
        if v == value: return
    try out.push(value)

func contains(values: const i64[], value: i64) -> bool:
    for v in values:
        if v == value: return true
    return false

## Whether point `at` is a point of one of `entities`.
func touches(sketch: const Sketch*, entities: const i64[], at: i64) -> bool:
    if at < 0 or sketch.entity(at).kind != EntityKind.point: return false
    var points = Growing[i64]()
    defer points.close()
    for e in entities:
        points_of(sketch, e, &points) catch failure:
            return false
    for p in points.view():
        if p == at: return true
    return false

func require_curve(sketch: const Sketch*, curve: i64) -> !:
    if curve < 0 or curve >= (i64)sketch.entities.count or sketch.entity(curve).kind == EntityKind.point:
        error(invalid, "this works on a sketch's curves")

## A line's start and direction.
func line_of(sketch: const Sketch*, e: SketchEntity) -> (f64, f64, f64, f64):
    let ax = sketch.x(e.first)
    let ay = sketch.y(e.first)
    return (ax, ay, sketch.x(e.second) - ax, sketch.y(e.second) - ay)

func curve_length(sketch: const Sketch*, curve: i64) -> f64:
    let e = sketch.entity(curve)
    if e.kind == EntityKind.line:
        let (ax, ay, dx, dy) = line_of(sketch, e)
        _ = ax
        _ = ay
        return math.max(math.hypot(dx, dy), 1e-300)
    return math.max(sketch.radius_of(curve) * 2.0 * math.pi, 1e-300)

func unit_vector(x: f64, y: f64) -> (f64, f64):
    let l = math.max(math.hypot(x, y), 1e-300)
    return (x / l, y / l)

## Point `point` scaled from `center` by `factor`.
func scaled_from(sketch: const Sketch*, center: i64, point: i64, factor: f64) -> (f64, f64):
    let cx = sketch.x(center)
    let cy = sketch.y(center)
    return (cx + (sketch.x(point) - cx) * factor, cy + (sketch.y(point) - cy) * factor)
