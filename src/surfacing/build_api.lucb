## Surfaces from curves (surfacing Stage 5; builders.lucb has the plan):
## what Luce calls, CadSurfaceBuild. Each builder takes a geometry set and
## the words of its curves (Align's master words, apart by `;`: "curve
## <name>", "edge <face> x y z", "isoparm <face> <0 or 1> <fraction>") and
## returns the set with a new body of one sheet named `name` after its
## others (Extend changes the face it extends).

## What a builder made: the set and its measures (CadSurfaceEdit's: the
## worst fit in `deviation`, how many faces in `count`), and for Square
## which side of the patch each picked boundary became (0 u = 0, 1 u = 1,
## 2 v = 0, 3 v = 1).
pub struct CadSurfaceBuild:
    let reserved: u8 = 0

    ## Square (square.lucb): the four boundaries `boundaries`, each picked
    ## boundary's continuity in `continuity` (square_free, square_g0, ...
    ## square_angle; four of them, in the picked order) and Tangent Angle
    ## in `angles` (degrees); Blend `cubic` (else Linear); Explicit Control
    ## with degrees and spans.
    pub static func square(set: interop.Reference[GeometrySet], boundaries: str, continuity: const i64[], angles: const f64[], cubic: bool = false, explicit: bool = false,
                           degree_u: i64 = 5, spans_u: i64 = 1, degree_v: i64 = 5, spans_v: i64 = 1, name: str = "Square") -> interop.Reference[CadSurfaceEdit]!:
        if continuity.length != 4 or angles.length != 4: error(invalid, "Square: one continuity and one angle for each of the four boundaries")
        var opts = SquareOptions([continuity[0], continuity[1], continuity[2], continuity[3]], [angles[0], angles[1], angles[2], angles[3]], cubic, explicit, degree_u, spans_u, degree_v, spans_v)
        for k in 0..<(usize)4:
            if continuity[k] < square_free or continuity[k] > square_angle: error(invalid, "Square: a boundary's continuity is Free, G0, G1, G2, Implied Tangent, Implied Curvature or Tangent Angle")
        var made = try square_net(set, boundaries, &opts)
        defer made.net.close()
        let body = try net_body(&made.net, name, true)
        defer body.release()
        let edit = try edit_of(try with_body_added(set, body))
        edit.value().deviation = made.deviation
        edit.value().count = 1
        for k in 0..<(usize)4: try edit.value().sides.push(made.sides[k])
        return edit

    ## Skin (skin.lucb): a surface through the sections `sections` in
    ## their order, `degree` across (lowered to what they allow), `closed`
    ## round, the first and last section's side matched G`start` and
    ## G`end` (0 to 3) to the surface it lies on.
    pub static func skin(set: interop.Reference[GeometrySet], sections: str, degree: i64 = 5, closed: bool = false, start: i64 = 0, end: i64 = 0, name: str = "Skin") -> interop.Reference[CadSurfaceEdit]!:
        if start < 0 or start > 3 or end < 0 or end > 3: error(invalid, "Skin's start and end continuity are G0 to G3")
        let opts = SkinOptions(degree, closed, start, end)
        var net = try skin_net(set, sections, &opts)
        defer net.close()
        return try added_sheet(set, &net, name)

    ## Rail (sweep.lucb): the generation curves `sections` swept along the
    ## rails `rails` (one or two): `mode` sweep_natural, sweep_parallel or
    ## sweep_vector (along `vector`); two rails' `transform` (two_rail_scale,
    ## two_rail_stretch, two_rail_rotate); the generation curves blended by
    ## `bias` (1 evenly); `continuity` G0 to G3 at the first rail, the
    ## second, the first and the last generation curve.
    pub static func rail(set: interop.Reference[GeometrySet], sections: str, rails: str, mode: i64 = 0, vector: Vector3 = Vector3(0.0, 0.0, 1.0), transform: i64 = 0,
                         bias: f64 = 1.0, continuity: const i64[] = [0, 0, 0, 0], name: str = "Rail") -> interop.Reference[CadSurfaceEdit]!:
        if mode < sweep_natural or mode > sweep_vector: error(invalid, "Rail's sweep mode is Natural, Parallel or Vector")
        if transform < two_rail_scale or transform > two_rail_rotate: error(invalid, "Rail's two-rail transform is Scale, Non-proportional scale or Rotate")
        var orders: i64[4] = [0, 0, 0, 0]
        for k in 0..<fewer(4, continuity.length):
            if continuity[k] < 0 or continuity[k] > 3: error(invalid, "Rail's continuity is G0 to G3")
            orders[k] = continuity[k]
        let opts = SweepOptions(mode, vector, transform, transition_linear, bias, orders)
        var net = try sweep_net(set, sections, rails, &opts)
        defer net.close()
        return try added_sheet(set, &net, name)

    ## Profile (sweep.lucb): the profiles `profiles` placed on the rail
    ## `rail` where each comes nearest it, oriented `orientation` (0
    ## Parallel, 1 Radial: turning with the rail, 2 Surface normal: up the
    ## face the rail lies on), and between them `transition`
    ## (transition_linear, transition_local, transition_global,
    ## transition_limited).
    pub static func profile(set: interop.Reference[GeometrySet], profiles: str, rail: str, orientation: i64 = 1, transition: i64 = 0, name: str = "Profile") -> interop.Reference[CadSurfaceEdit]!:
        if orientation < 0 or orientation > 2: error(invalid, "Profile's orientation is Parallel, Radial or Surface normal")
        if transition < transition_linear or transition > transition_limited: error(invalid, "Profile's transition is Linear, Local, Global or Limited")
        let modes: i64[3] = [sweep_parallel, sweep_natural, sweep_normal]
        let opts = SweepOptions(modes[(usize)orientation], Vector3(0.0, 0.0, 1.0), two_rail_scale, transition, 1.0, [0, 0, 0, 0])
        var net = try sweep_net(set, profiles, rail, &opts)
        defer net.close()
        return try added_sheet(set, &net, name)

    ## Set Planar (sheets.lucb): the closed curves `curves`, in one plane,
    ## filled: a trimmed plane face (a curve inside another a hole).
    pub static func set_planar(set: interop.Reference[GeometrySet], curves: str, name: str = "Planar") -> interop.Reference[CadSurfaceEdit]!:
        let body = try set_planar(set, curves, name)
        defer body.release()
        let edit = try edit_of(try with_body_added(set, body))
        edit.value().count = 1
        return edit

    ## Extrude (sheets.lucb): the curves `curves` carried along `direction`
    ## by `distance` (both ways with `both`), a sheet each, joined.
    pub static func extruded(set: interop.Reference[GeometrySet], curves: str, direction: Vector3, distance: f64, both: bool = false, name: str = "Extrude") -> interop.Reference[CadSurfaceEdit]!:
        let body = try swept_sheets(set, curves, false, direction, distance, both, Vector3(), Vector3(), 0.0, 0.0, name)
        defer body.release()
        let edit = try edit_of(try with_body_added(set, body))
        edit.value().count = body.value().face_count()
        return edit

    ## Revolve (sheets.lucb): the curves `curves` turned about the axis
    ## through `origin` along `axis` from `start` to `end` degrees, exactly.
    pub static func revolved(set: interop.Reference[GeometrySet], curves: str, origin: Vector3, axis: Vector3, start: f64 = 0.0, end: f64 = 360.0, name: str = "Revolve") -> interop.Reference[CadSurfaceEdit]!:
        let body = try swept_sheets(set, curves, true, Vector3(), 0.0, false, origin, axis, start, end, name)
        defer body.release()
        let edit = try edit_of(try with_body_added(set, body))
        edit.value().count = body.value().face_count()
        return edit

    ## Extend (extend.lucb): the face edge or curve end `input` ("face
    ## <name> x y z": the face's natural side nearest the point; "curve
    ## <name> x y z": the end nearest it) carried on `distance` (a
    ## percentage of its length with `percent`) by `kind` (extend_linear,
    ## extend_natural, extend_soft, extend_reflective); `merge` false keeps
    ## a surface's extension a sheet of its own.
    pub static func extended(set: interop.Reference[GeometrySet], input: str, kind: i64 = 1, distance: f64 = 1.0, percent: bool = false, merge: bool = true) -> interop.Reference[CadSurfaceEdit]!:
        let edit = try edit_of(try extended_set(set, input, kind, distance, percent, merge))
        edit.value().count = 1
        return edit

## `set` with a body of one sheet on `net` named `name` added.
func added_sheet(set: interop.Reference[GeometrySet], net: const Net*, name: str) -> interop.Reference[CadSurfaceEdit]!:
    let body = try net_body(net, name, true)
    defer body.release()
    let edit = try edit_of(try with_body_added(set, body))
    edit.value().count = 1
    return edit
