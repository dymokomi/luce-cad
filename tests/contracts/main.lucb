## luce-cad's Base contracts: layout, trim predicates and the exporter accessors, reaching
## the package's internals. Each runs every contract module it imports.
from layout_contract import layout_contracts
from trim_predicates_contract import trim_predicate_contracts
from exact_contract import exact_contracts

pub func main(arguments: str[]) -> i32!:
    _ = arguments
    try layout_contracts()
    try trim_predicate_contracts()
    try exact_contracts()
    return 0
