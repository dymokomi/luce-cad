## luce-cad's Base contracts: layout, trim predicates, the exporter accessors, direct
## fillets and the sketch solver, reaching the package's internals. Each runs every contract module it imports.
from layout_contract import layout_contracts
from trim_predicates_contract import trim_predicate_contracts
from exact_contract import exact_contracts
from direct_fillet_contract import direct_fillet_contracts
from references_contract import references_contracts
from march_contract import march_contracts
from boolean_contract import boolean_contracts
from sketch_contract import sketch_contracts
from sketch_modify_contract import sketch_modify_contracts
from sketch_shapes_contract import sketch_shapes_contracts
from sketch_cases_contract import sketch_cases_contracts

pub func main(arguments: str[]) -> i32!:
    _ = arguments
    try layout_contracts()
    try trim_predicate_contracts()
    try exact_contracts()
    try direct_fillet_contracts()
    try references_contracts()
    try march_contracts()
    try boolean_contracts()
    try sketch_contracts()
    try sketch_modify_contracts()
    try sketch_shapes_contracts()
    try sketch_cases_contracts()
    return 0
