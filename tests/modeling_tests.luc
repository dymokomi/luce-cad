## CAD modeling: sketch profiles extruded into closed solids, and booleans,
## checked by their tessellations: closed and outward, with the volumes
## geometry gives.
from luce_cad.modeling import CadModeling
from luce_cad.model import CadModel
from luce_cad.solids import CadSolids
from luce_geocore.geocore import Vector3
from luce_geocore.geocore import Mesh, GeometrySet, Sketches
from checks import manifold
from luce_std import math

func volume(mesh: Mesh) -> float!:
    var total = 0.0
    for triangle in 0..<mesh.index_count() // 3:
        let a = mesh.vertex(mesh.index(triangle * 3)).position
        let b = mesh.vertex(mesh.index(triangle * 3 + 1)).position
        let c = mesh.vertex(mesh.index(triangle * 3 + 2)).position
        total += a.dot(b.cross(c)) / 6.0
    return total

func solid(model: CadModel, faces: int, expected: float, tolerance: float) -> Mesh!:
    if model.face_count() != faces: print(f"faces {model.face_count()}, expected {faces}")
    assert(model.face_count() == faces)
    let mesh = model.tessellate(16)
    manifold(mesh)
    let v = volume(mesh)
    if math.abs(v - expected) > tolerance: print(f"volume {v}, expected {expected}")
    assert(math.abs(v - expected) <= tolerance)
    return mesh

pub func modeling_tests() -> unit!:
    let empty = GeometrySet.of_mesh(Mesh.empty())
    # A 4 x 2 rectangle with a hole of radius 0.5 (shape 4 is a rectangle,
    # 3 a circle), on the ground plane.
    let plate = Sketches.with_shape(Sketches.with_shape(empty, 4, [4.0, 2.0], 0.0, 0.0), 3, [0.5], 1.0, 0.0)
    assert(CadModeling.profile_count(plate) == 1)
    _ = solid(CadModeling.extruded(plate, 1.0), 7, 8.0 - math.pi * 0.25, 0.02)
    # Downward, and a lone circle: a cylinder.
    _ = solid(CadModeling.extruded(plate, -0.5), 7, (8.0 - math.pi * 0.25) * 0.5, 0.02)
    let disc = Sketches.with_shape(empty, 3, [1.0], 0.0, 0.0)
    _ = solid(CadModeling.extruded(disc, 2.0), 3, math.pi * 2.0, 0.05)
    # An arc closed by a line: a D shape (half disc).
    let arc = Sketches.with_shape(empty, 2, [1.0, 0.0, 180.0], 0.0, 0.0)
    let d_shape = Sketches.with_shape(arc, 0, [2.0], 0.0, 0.0)
    _ = solid(CadModeling.extruded(d_shape, 1.0), 4, math.pi * 0.5, 0.02)
    # An open curve is no profile.
    var rejected = false
    _ = CadModeling.extruded(arc, 1.0) catch failure:
        rejected = failure.message.contains("open")
    assert(rejected)
    booleans()
    blends()
    slotted_block()
    print("PASS modeling: sketch profiles extruded into closed solids; booleans (union, subtract, intersect) of boxes, cylinders and spheres with coplanar faces, holes across and at an angle, a cut sphere and a lens; chamfers and fillets of box edges, a slotted, drilled block chamfered; all closed and of the right volume")

## Booleans of solids, checked by volume: a box drilled through by a
## cylinder, two boxes overlapping (coplanar faces) joined and intersected.
func booleans() -> unit!:
    let box = CadSolids.box(2.0, 2.0, 2.0)
    let pin = CadSolids.cylinder(0.5, 3.0)
    _ = solid(CadModeling.combined(box, pin, 1), 7, 8.0 - math.pi * 0.25 * 2.0, 0.02)
    let moved = box.transformed(Vector3(1.0, 0.0, 0.0), Vector3(), Vector3(1.0, 1.0, 1.0))
    # Flush faces merge: the union and the intersection are plain boxes.
    _ = solid(CadModeling.combined(box, moved, 0), 6, 12.0, 0.001)
    _ = solid(CadModeling.combined(box, moved, 2), 6, 4.0, 0.001)
    let r = 0.5
    # A boss: a cylinder standing out of the top (from y 0.5 to 2.5).
    let boss = pin.transformed(Vector3(0.0, 1.0, 0.0), Vector3(), Vector3(1.0, 1.0, 1.0))
    _ = solid(CadModeling.combined(box, boss, 0), 8, 8.0 + math.pi * r * r * 1.5, 0.02)
    # A pocket: a smaller box cut from a corner of the top.
    let cutter = CadSolids.box(1.0, 1.0, 1.0).transformed(Vector3(0.5, 0.75, 0.5), Vector3(), Vector3(1.0, 1.0, 1.0))
    let pocket = CadModeling.combined(box, cutter, 1)
    # The cutter overlaps the box by 1 x 0.75 x 1.
    _ = solid(pocket, pocket.face_count(), 8.0 - 0.75, 0.001)
    # A horizontal hole along Z: the cylinder's side meets the end faces in
    # circles.
    let across = pin.transformed(Vector3(), Vector3(math.pi * 0.5, 0.0, 0.0), Vector3(1.0, 1.0, 1.0))
    _ = solid(CadModeling.combined(box, across, 1), 7, 8.0 - math.pi * r * r * 2.0, 0.02)
    # A tilted hole: ellipses on the top and bottom.
    let tilt = 0.3
    let slanted = CadSolids.cylinder(0.4, 4.0).transformed(Vector3(), Vector3(0.0, 0.0, tilt), Vector3(1.0, 1.0, 1.0))
    _ = solid(CadModeling.combined(box, slanted, 1), 7, 8.0 - math.pi * 0.16 * 2.0 / math.cos(tilt), 0.03)
    # A sphere cut flat: a plane meets it in a circle.
    let ball = CadSolids.sphere(1.0)
    let slab = CadSolids.box(4.0, 2.0, 4.0).transformed(Vector3(0.0, 1.5, 0.0), Vector3(), Vector3(1.0, 1.0, 1.0))
    let h = 0.5
    _ = solid(CadModeling.combined(ball, slab, 1), 3, 4.0 / 3.0 * math.pi - math.pi * h * h * (3.0 - h) / 3.0, 0.03)
    # Two parallel cylinders overlapping: their lens.
    let other = pin.transformed(Vector3(0.5, 0.0, 0.0), Vector3(), Vector3(1.0, 1.0, 1.0))
    let lens = CadModeling.combined(pin, other, 2)
    let area = 2.0 * r * r * math.acos(0.5 / (2.0 * r)) - 0.5 * 0.5 * math.sqrt(4.0 * r * r - 0.25)
    _ = solid(lens, lens.face_count(), area * 3.0, 0.02)

## The B-rep edges of `model` along Y.
func upright_edges(model: CadModel) -> list[int]!:
    let found: list[int] = []
    for face in 0..<model.face_count():
        for use in 0..<model.face_edge_count(face):
            let id = model.face_edge_id(face, use)
            let a = model.face_edge_point(face, use, 0.0)
            let b = model.face_edge_point(face, use, 1.0)
            if model.face_edge_linear(face, use) and math.abs(a.x - b.x) < 1e-9 and math.abs(a.z - b.z) < 1e-9 and not (id in found):
                found.append(id)
    return found

## Chamfers and fillets of a box's edges, by volume: the four upright ones
## chamfered and filleted, and every edge chamfered (a^3 - 6ad^2 + 6d^3:
## the corners where three chamfers meet, from the booleans).
func blends() -> unit!:
    let box = CadSolids.box(2.0, 2.0, 2.0)
    let d = 0.2
    let uprights = upright_edges(box)
    assert(uprights.length == 4)
    _ = solid(CadModeling.chamfered(box, uprights, d), 10, 8.0 - 4.0 * d * d * 0.5 * 2.0, 0.002)
    let r = 0.3
    _ = solid(CadModeling.filleted(box, uprights, r), 10, 8.0 - 8.0 * (r * r - math.pi * r * r * 0.25), 0.01)
    # Each corner is where three chamfer planes meet (mitered).
    _ = solid(CadModeling.chamfered(box, [], d), 18, 8.0 - 6.0 * 2.0 * d * d + 6.0 * d * d * d, 0.002)

## A part: a block with a slot across its top (the slot's sides flush with
## the block's), a hole down through it, then every straight convex edge
## chamfered.
func slotted_block() -> unit!:
    let block = CadSolids.box(3.0, 2.0, 2.0)
    let slot = CadSolids.box(1.0, 2.0, 2.0).transformed(Vector3(0.0, 1.0, 0.0), Vector3(), Vector3(1.0, 1.0, 1.0))
    let hole = CadSolids.cylinder(0.35, 4.0).transformed(Vector3(1.0, 0.0, 0.0), Vector3(), Vector3(1.0, 1.0, 1.0))
    let slotted = CadModeling.combined(block, slot, 1)
    let drilled = CadModeling.combined(slotted, hole, 1)
    let solid_volume = 12.0 - 2.0 - math.pi * 0.35 * 0.35 * 2.0
    _ = solid(drilled, drilled.face_count(), solid_volume, 0.02)
    let chamfered = CadModeling.chamfered(drilled, [], 0.12)
    let m = chamfered.tessellate(16)
    manifold(m)
    assert(volume(m) < solid_volume and volume(m) > solid_volume - 0.3)
