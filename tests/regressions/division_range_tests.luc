## Every face meshes at every division count, or the tessellation names it:
## no face drops out silently. Wavy strips of variable fillets rolled round
## loops (a dome's rim, a rounded box's top) once dropped out at 48
## divisions and more: their closed B-spline strip's seam started its
## chart walk on the wrong copy, so the mapped mesher refused it and the
## clipped grid outgrew its budget; the dome's sphere cap (its rim wavy,
## not a latitude) outgrew the lattice budget. Open ends' strips beside
## flat end faces and a ball drilled off its axis and at a slant (sphere
## trims that are not caps; at a slant each half sphere is its equator and
## a hole, which no chart took) are checked too, each at 4 to 64
## divisions: closed, no face skipped, and every face present.
from luce_cad.modeling import CadModeling
from luce_cad.model import CadModel
from luce_cad.solids import CadSolids
from luce_cad.cad_geometry import CadGeometry
from luce_geocore.geocore import Vector3
from checks import closed, volume
from luce_std import math

func edges_where(model: CadModel, keep: func(Vector3, Vector3) -> bool) -> list[int]!:
    let found: list[int] = []
    for face in 0..<model.face_count():
        for use in 0..<model.face_edge_count(face):
            let id = model.face_edge_id(face, use)
            if keep(model.face_edge_point(face, use, 0.0), model.face_edge_point(face, use, 0.5)) and not (id in found):
                found.append(id)
    return found

## `model` meshed at every division count: closed, nothing skipped, and
## every one of its faces holding polygons.
func every_division(name: str, model: CadModel) -> unit!:
    for d in [4, 8, 16, 24, 32, 40, 44, 48, 52, 56, 60, 64]:
        let mesh = model.tessellate(d)
        let skipped = CadGeometry.skipped_faces(mesh)
        if skipped != "": print(f"{name} at {d}: {skipped}")
        assert(skipped == "" and CadGeometry.dropped_faces(mesh) == 0)
        let parent = mesh.find_attribute("cad_face", 2)
        let seen: list[bool] = []
        for face in 0..<model.face_count(): seen.append(false)
        for face in 0..<mesh.face_count(): seen[int(mesh.attribute_value(parent, face, 0))] = true
        for face in 0..<model.face_count():
            if not seen[face]: print(f"{name} at {d}: face {face} has no polygons")
            assert(seen[face])
        closed(mesh)

## The volume `model`'s meshes at 32 and 64 divisions extrapolate to.
func refined(model: CadModel) -> float!:
    let coarse = volume(model.tessellate(32))
    let fine = volume(model.tessellate(64))
    return fine + (fine - coarse) / 3.0

pub func division_range_tests() -> unit!:
    # A dome's rim, rolled G1 at weights 1 and 0.5, and G2.
    let ball = CadModeling.tagged(CadSolids.sphere(10.0), "ball")
    let below = CadModeling.tagged(CadSolids.box(30.0, 30.0, 30.0), "cut").transformed(Vector3(0.0, -15.0, 0.0), Vector3(), Vector3(1.0, 1.0, 1.0))
    let dome = CadModeling.combined(ball, below, 1)
    let on_rim = func (a: Vector3, b: Vector3) -> bool:
        return math.abs(a.y) < 1e-9 and math.abs(b.y) < 1e-9 and math.abs(math.hypot(a.x, a.z) - 10.0) < 1e-6
    let rim = CadModeling.edge_references(dome, edges_where(dome, on_rim))
    for (continuity, weight) in [(1, 1.0), (1, 0.5), (2, 1.0)]:
        every_division(f"dome G{continuity} weight {weight}", CadModeling.variable_filleted(dome, rim, [0.0, 0.25, 0.75, 1.0], [2.0, 1.5, 2.5, 2.0], "v", false, continuity, true, weight))
    # A rounded box's top loop, rolled.
    let box = CadModeling.tagged(CadSolids.box(20.0, 20.0, 20.0), "b")
    let upright = func (a: Vector3, b: Vector3) -> bool:
        return math.abs(a.x - b.x) < 1e-9 and math.abs(a.y - b.y) < 1e-9
    let rounded = CadModeling.filleted(box, CadModeling.edge_references(box, edges_where(box, upright)), 4.0, "u", 1, false)
    let top = func (a: Vector3, b: Vector3) -> bool:
        return math.abs(a.z - 10.0) < 1e-9 and math.abs(b.z - 10.0) < 1e-9
    let loop = edges_where(rounded, top)
    for (continuity, weight) in [(1, 1.0), (2, 1.0)]:
        every_division(f"box loop G{continuity}", CadModeling.variable_filleted(rounded, CadModeling.edge_references(rounded, [loop[0]]), [0.0, 0.25, 0.75, 1.0], [2.0, 1.5, 2.5, 2.0], "v", false, continuity, true, weight))
    # An upright's arc alone on the top: its strip open, ending in flat
    # faces (strips facing either way).
    for continuity in 1..<4:
        var curve = -1
        for face in 0..<rounded.face_count():
            for use in 0..<rounded.face_edge_count(face):
                let id = rounded.face_edge_id(face, use)
                if (id in loop) and not rounded.face_edge_linear(face, use): curve = id
        every_division(f"arc alone G{continuity}", CadModeling.filleted(rounded, CadModeling.edge_references(rounded, [curve]), 2.0, "g", continuity, false))
    # A ball drilled off its axis: sphere faces trimmed by loops that are
    # not latitudes; and at a slant: each half sphere its equator round the
    # pole and a hole (sphere_disk), the same volume either way.
    let pin = CadModeling.tagged(CadSolids.cylinder(3.0, 30.0), "pin")
    let straight = CadModeling.combined(ball, pin.transformed(Vector3(2.0, 0.0, 0.0), Vector3(), Vector3(1.0, 1.0, 1.0)), 1)
    let slanted = CadModeling.combined(ball, pin.transformed(Vector3(2.0, 0.0, 0.0), Vector3(0.4, 0.3, 0.0), Vector3(1.0, 1.0, 1.0)), 1)
    every_division("drilled ball", straight)
    every_division("ball drilled at a slant", slanted)
    let a = refined(straight)
    let b = refined(slanted)
    if math.abs(a - b) > 0.1: print(f"drilled balls: {a} straight, {b} at a slant")
    assert(math.abs(a - b) <= 0.1)
    print("PASS every face meshes at 4 to 64 divisions, or is named: rolled variable fillets round a dome's rim and a box's top loop, open strips ending in flat faces, balls drilled off their axis, straight and at a slant")
