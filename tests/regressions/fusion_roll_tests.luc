902, 0.204792, 0.978745), Vector3(-0.022882, 0.561317, 0.827284), Vector3(-0.022882, 0.827284, 0.561317), Vector3(-0.010902, 0.978745, 0.204792), Vector3(-0.010902, 0.204792, 0.978745), Vector3(-0.022882, 0.561317, 0.827284), Vector3(-0.022882, 0.827284, 0.561317), Vector3(-0.010902, 0.978745, 0.204792), Vector3(-0.010902, 0.204792, 0.978745), Vector3(-0.022882, 0.561317, 0.827284), Vector3(-0.022882, 0.827284, 0.561317), Vector3(-0.010902, 0.978745, 0.204792), Vector3(-0.010902, 0.204792, 0.978745), Vector3(-0.022882, 0.561317, 0.827284), Vector3(-0.022882, 0.827284, 0.561317), Vector3(-0.010902, 0.978745, 0.204792), Vector3(-0.010902, 0.204792, 0.978745), Vector3(-0.022882, 0.561317, 0.827284), Vector3(-0.022882, 0.827284, 0.561317), Vector3(-0.010902, 0.978745, 0.204792), Vector3(-0.010902, 0.204792, 0.978745), Vector3(-0.022882, 0.561317, 0.827284), Vector3(-0.022882, 0.827284, 0.561317), Vector3(-0.010902, 0.978745, 0.204792), Vector3(-0.010902, 0.204792, 0.978745), Vector3(-0.022882, 0.561317, 0.827284), Vector3(-0.022882, 0.827284, 0.561317), Vector3(-0.010902, 0.978745, 0.204792), Vector3(-0.010902, 0.204792, 0.978745), Vector3(-0.022882, 0.561317, 0.827284), Vector3(-0.022882, 0.827284, 0.561317), Vector3(-0.010902, 0.978745, 0.204792), Vector3(-0.010902, 0.204792, 0.978745), Vector3(-0.022882, 0.561317, 0.827284), Vector3(-0.022882, 0.827284, 0.561317), Vector3(-0.010902, 0.978745, 0.204792), Vector3(-0.010902, 0.204792, 0.978745), Vector3(-0.022882, 0.561317, 0.827284), Vector3(-0.022882, 0.827284, 0.561317), Vector3(-0.010902, 0.978745, 0.204792)])
    ]
    for k in 0..<samples.length:
        let (name, points, normals) = samples[k]
        let (positions, radii, continuity, weight) = settings[k]
        let made = CadModeling.variable_filleted(slab, edge, positions, radii, "v", false, continuity, false, weight)
        closed(made.tessellate(32))
        for i in 0..<points.length:
            let a = CadModeling.inside(made, points[i].add(normals[i].multiply_scalar(0.002)))
            let b = CadModeling.inside(made, points[i].subtract(normals[i].multiply_scalar(0.002)))
            assert(a != b, f"{name}: Fusion's point {points[i]} off ours by more than 0.002")

func loops() -> unit!:
    let p = prism([Vector3(0.0, 0.0, 0.0), Vector3(20.0, 0.0, 0.0), Vector3(20.0, 20.0, 0.0), Vector3(0.0, 20.0, 0.0)])
    let upright = func (a: Vector3, b: Vector3) -> bool:
        return math.abs(a.x - b.x) < 1e-9 and math.abs(a.y - b.y) < 1e-9
    let rounded = CadModeling.filleted(p, CadModeling.edge_references(p, edges_where(p, upright)), 4.0, "u", 1, false)
    let first = func (a: Vector3, b: Vector3) -> bool:
        return math.abs(a.x) < 1e-9 and math.abs(b.x) < 1e-9 and math.abs(a.z - 20.0) < 1e-9 and math.abs(b.z - 20.0) < 1e-9
    let edge = CadModeling.edge_references(rounded, edges_where(rounded, first))
    let loop_positions = [0.0, 0.015625, 0.031250, 0.046875, 0.062500, 0.078125, 0.093750, 0.109375, 0.125000, 0.140625, 0.156250, 0.171875, 0.187500, 0.203125, 0.218750, 0.234375, 0.250000, 0.265625, 0.281250, 0.296875, 0.312500, 0.328125, 0.343750, 0.359375, 0.375000, 0.390625, 0.406250, 0.421875, 0.437500, 0.453125, 0.468750, 0.484375, 0.500000, 0.515625, 0.531250, 0.546875, 0.562500, 0.578125, 0.593750, 0.609375, 0.625000, 0.640625, 0.656250, 0.671875, 0.687500, 0.703125, 0.718750, 0.734375, 0.750000, 0.765625, 0.781250, 0.796875, 0.812500, 0.828125, 0.843750, 0.859375, 0.875000, 0.890625, 0.906250, 0.921875, 0.937500, 0.953125, 0.968750, 0.984375, 1.0]
    let loop_radii = [1.966843153, 1.966843153, 1.912006771, 1.858093380, 1.805710660, 1.755433384, 1.707841838, 1.663555763, 1.623195941, 1.587419997, 1.556881828, 1.536553088, 1.523968576, 1.513619129, 1.506286873, 1.501650918, 1.500000000, 1.504209844, 1.516496863, 1.536337494, 1.563195195, 1.596522288, 1.635610864, 1.679509618, 1.727471561, 1.778748147, 1.832585714, 1.875201673, 1.905146899, 1.934710224, 1.964567637, 1.993315550, 2.021891416, 2.079271161, 2.135833946, 2.190870132, 2.243678640, 2.293601910, 2.339905566, 2.381833205, 2.418618882, 2.449435541, 2.473487333, 2.485771500, 2.491020076, 2.494938158, 2.497826029, 2.499483832, 2.500000000, 2.496006340, 2.484401876, 2.465760596, 2.440668396, 2.409721174, 2.373541147, 2.332823180, 2.288209366, 2.240341856, 2.189868422, 2.151676441, 2.127402018, 2.101583953, 2.075780847, 2.048974185, 1.966843153]
    for (continuity, weight, fusion) in [(1, 1.0, 7662.519871703669), (1, 0.5, 7635.223651268879), (2, 1.0, 7675.829481275169)]:
        let v = refined(CadModeling.variable_filleted(rounded, edge, loop_positions, loop_radii, "v", false, continuity, true, weight))
        if math.abs(v - fusion) > 0.03: print(f"loop G{continuity} weight {weight}: {v}, Fusion {fusion}")
        assert(math.abs(v - fusion) <= 0.03)
    # The dome: a ball of 10 cut at its middle (meshes of 32 and 40: the
    # wavy strip's trims do not mesh at 64 yet).
    let ball = CadModeling.tagged(CadSolids.sphere(10.0), "ball")
    let below = CadModeling.tagged(CadSolids.box(30.0, 30.0, 30.0), "cut").transformed(Vector3(0.0, -15.0, 0.0), Vector3(), Vector3(1.0, 1.0, 1.0))
    let dome = CadModeling.combined(ball, below, 1)
    let on_rim = func (a: Vector3, b: Vector3) -> bool:
        return math.abs(a.y) < 1e-9 and math.abs(b.y) < 1e-9 and math.abs(math.hypot(a.x, a.z) - 10.0) < 1e-6
    let rim = CadModeling.edge_references(dome, edges_where(dome, on_rim))
    let dome_positions = [0.0, 0.015625, 0.031250, 0.046875, 0.062500, 0.078125, 0.093750, 0.109375, 0.125000, 0.140625, 0.156250, 0.171875, 0.187500, 0.203125, 0.218750, 0.234375, 0.250000, 0.265625, 0.281250, 0.296875, 0.312500, 0.328125, 0.343750, 0.359375, 0.375000, 0.390625, 0.406250, 0.421875, 0.437500, 0.453125, 0.468750, 0.484375, 0.500000, 0.515625, 0.531250, 0.546875, 0.562500, 0.578125, 0.593750, 0.609375, 0.625000, 0.640625, 0.656250, 0.671875, 0.687500, 0.703125, 0.718750, 0.734375, 0.750000, 0.765625, 0.781250, 0.796875, 0.812500, 0.828125, 0.843750, 0.859375, 0.875000, 0.890625, 0.906250, 0.921875, 0.937500, 0.953125, 0.968750, 0.984375, 1.0]
    let dome_radii = [1.992121639, 1.992121639, 1.945066596, 1.897876496, 1.851331938, 1.805732840, 1.761181891, 1.718404314, 1.678116434, 1.640386355, 1.605818369, 1.576036202, 1.551309501, 1.530920552, 1.514896101, 1.504064409, 1.500000046, 1.503344235, 1.512815898, 1.528148699, 1.549324282, 1.575393896, 1.605820366, 1.640841578, 1.679326342, 1.719927438, 1.762019644, 1.805666946, 1.851412329, 1.898638395, 1.946017097, 1.992842498, 2.039026663, 2.084977339, 2.130422067, 2.174399890, 2.216488751, 2.256779624, 2.295301620, 2.331280744, 2.364245059, 2.394190795, 2.421572432, 2.445878322, 2.466099032, 2.481627089, 2.492262721, 2.498200529, 2.499999962, 2.497787181, 2.490985697, 2.479627980, 2.464101882, 2.444623134, 2.421192324, 2.394190953, 2.364297892, 2.331424050, 2.295486874, 2.256866656, 2.216405121, 2.174434145, 2.130659648, 2.085216129, 1.992121639]
    let base = moderate(dome)
    for (continuity, weight, fusion) in [(1, 1.0, 2014.531548088535), (1, 0.5, 1976.9585104417026)]:
        let made = CadModeling.variable_filleted(dome, rim, dome_positions, dome_radii, "v", false, continuity, true, weight)
        let v = 2000.0 * math.pi / 3.0 - (base - moderate(made))
        if math.abs(v - fusion) > 0.03: print(f"dome G{continuity} weight {weight}: {v}, Fusion {fusion}")
        assert(math.abs(v - fusion) <= 0.03)

## The volume of `model`'s mesh at 32 and 40 divisions, extrapolated.
func moderate(model: CadModel) -> float!:
    let coarse = volume(model.tessellate(32))
    let mesh = model.tessellate(40)
    closed(mesh)
    let fine = volume(mesh)
    return fine + (fine - coarse) * 1024.0 / 576.0
