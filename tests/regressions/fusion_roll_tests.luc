## Rolled balls checked against Fusion 2705 itself (probes 8 to 11 of
## 2026-10-12, luce_work/cad/fusion): G1 variable fillets at a Tangency
## weight of exactly 1.
## - Where the envelope folds: radii 2, x at the middle, 2 along a 20 box's
##   edge; Fusion rolls the ball up to x = 10 and scales the section from 12
##   (its face then ends flush, its knots inside the edge), as ours does
##   (rolled_folds): Fusion's volumes within the law's own difference
##   (natural spline, 0.8 at x = 14), the rolled and scaled 30 apart at 10.
## - A slanted end (a prism's ridge ending at a 45° face): the sweep (or the
##   balls' envelope) carried on and trimmed by the end face, as Fusion's.
##   Fusion's faces, sampled from its NURBS, lie within 2e-3 of ours (points
##   a hair either side of each are inside and outside ours): G1 at 0.5 and
##   G2 straight 2 to 4, G2 and the rolled G1 through 3.5 at the middle.
##   (Mesh volumes of these sheared strips converge too slowly to compare.)
## - Loops: a rounded box's top loop and a dome's rim, the law Fusion's own
##   (its G2 face's radius read back at 63 points: Fusion's law round a
##   loop is not decoded, nearly a smooth step between extremes), so the
##   rolled ball alone is compared: G1 at 1 (rolled) and 0.5 and G2 take
##   Fusion's volumes within 0.03.
from luce_cad.modeling import CadModeling
from luce_cad.model import CadModel
from luce_cad.solids import CadSolids
from luce_cad.sketch import CadSketch
from luce_geocore.geocore import Vector3
from checks import closed, volume
from luce_std import math

pub func fusion_roll_tests() -> unit!:
    folds()
    slanted()
    loops()
    print("PASS Fusion rolled balls: folding laws scale as Fusion's (rolled to 10, scaled from 12); slanted ends match Fusion's faces within 2e-3; a rounded box's loop and a dome's rim with Fusion's laws, rolled at weight 1, within 0.03 of Fusion's volumes")

func refined(model: CadModel) -> float!:
    let coarse = volume(model.tessellate(32))
    let mesh = model.tessellate(64)
    closed(mesh)
    let fine = volume(mesh)
    return fine + (fine - coarse) / 3.0

func edges_where(model: CadModel, keep: func(Vector3, Vector3) -> bool) -> list[int]!:
    let found: list[int] = []
    for face in 0..<model.face_count():
        for use in 0..<model.face_edge_count(face):
            let id = model.face_edge_id(face, use)
            if keep(model.face_edge_point(face, use, 0.0), model.face_edge_point(face, use, 0.5)) and not (id in found):
                found.append(id)
    return found

## A prism of `corners` (on XY) 20 deep.
func prism(corners: list[Vector3]) -> CadModel!:
    let s = CadSketch.parse("")
    let ids: list[int] = []
    for p in corners:
        ids.append(s.add_point(p.x, p.y))
    for k in 0..<corners.length:
        _ = s.add_line(ids[k], ids[(k + 1) % corners.length])
    return CadModeling.extruded_sides(s.curves(Vector3(), Vector3(1.0, 0.0, 0.0), Vector3(0.0, 1.0, 0.0)), 20.0, 0.0, "p")

func folds() -> unit!:
    let p = prism([Vector3(0.0, 0.0, 0.0), Vector3(20.0, 0.0, 0.0), Vector3(20.0, 20.0, 0.0), Vector3(0.0, 20.0, 0.0)])
    let corner = func (a: Vector3, b: Vector3) -> bool:
        return math.abs(a.x - 20.0) < 1e-6 and math.abs(a.y - 20.0) < 1e-6 and math.abs(b.x - 20.0) < 1e-6 and math.abs(b.y - 20.0) < 1e-6
    let edge = CadModeling.edge_references(p, edges_where(p, corner))
    for (x, fusion) in [(4.0, 7953.639872761905), (8.0, 7857.110578012691), (10.0, 7797.289960469852), (12.0, 7667.594623066025), (14.0, 7554.611924271657)]:
        let v = refined(CadModeling.variable_filleted(p, edge, [0.0, 0.5, 1.0], [2.0, x, 2.0], "v", false, 1, false, 1.0))
        if math.abs(v - fusion) > 0.8: print(f"fold {x}: {v}, Fusion {fusion}")
        assert(math.abs(v - fusion) <= 0.8)

func slanted() -> unit!:
    let slab = prism([Vector3(0.0, 0.0, 0.0), Vector3(40.0, 0.0, 0.0), Vector3(30.0, 10.0, 0.0), Vector3(0.0, 10.0, 0.0)])
    let ridge = func (a: Vector3, b: Vector3) -> bool:
        return math.abs(a.y - 10.0) < 1e-9 and math.abs(b.y - 10.0) < 1e-9 and math.abs(a.z - 20.0) < 1e-9 and math.abs(b.z - 20.0) < 1e-9
    let edge = CadModeling.edge_references(slab, edges_where(slab, ridge))
    # Fusion's laws start at the slanted end (its edge runs from x = 30).
    let settings = [([0.0, 1.0], [2.0, 4.0], 1, 0.5), ([0.0, 0.5, 1.0], [2.0, 3.5, 4.0], 2, 1.0), ([0.0, 0.5, 1.0], [2.0, 3.5, 4.0], 1, 1.0), ([0.0, 1.0], [2.0, 4.0], 2, 1.0)]
