## Replace Face onto a closed body that overlaps the one changed: what
## Fusion does with the faces' surfaces alone, checked closed and of the
## volume geometry gives.
from luce_cad.modeling import CadModeling, CadDirect
from luce_cad.model import CadModel
from luce_cad.solids import CadSolids
from luce_geocore.geocore import Vector3
from checks import manifold, volume
from luce_std import math

pub func heal_replace_tests() -> unit!:
    overlapping_replace()
    print("PASS Replace Face of a top and its fillet onto an overlapping copy's top and fillet (a plane and a cylinder): the body 0.5 taller")

func solid(model: CadModel, expected: float, tolerance: float, what: str) -> unit!:
    let mesh = model.tessellate(32)
    manifold(mesh)
    let v = volume(mesh)
    assert(math.abs(v - expected) <= tolerance, f"{what}: volume {v}, expected {expected}")

## The name of `model`'s flat face whose outward normal is `normal`.
func flat(model: CadModel, normal: Vector3) -> str!:
    for f in 0..<model.face_count():
        let name = CadModeling.face_name_of(model, f)
        let frame = CadModeling.face_frame(model, name)
        if frame.found and frame.u.cross(frame.v).dot(normal) > 0.999:
            return name
    assert(false, "no such face")
    return ""

func edges_where(model: CadModel, keep: func(Vector3, Vector3) -> bool) -> str!:
    let found: list[int] = []
    for face in 0..<model.face_count():
        for use in 0..<model.face_edge_count(face):
            let id = model.face_edge_id(face, use)
            if keep(model.face_edge_point(face, use, 0.0), model.face_edge_point(face, use, 1.0)) and not (id in found):
                found.append(id)
    return CadModeling.edge_references(model, found)

## The names of `model`'s faces on surfaces of `kind` (1 a cylinder).
func of_kind(model: CadModel, kind: int) -> list[str]!:
    let found: list[str] = []
    for f in 0..<model.face_count():
        if model.face_surface_kind(f) == kind:
            found.append(CadModeling.face_name_of(model, f))
    return found

## A 2-box's +X top edge rounded 0.3 and a copy raised 0.5 (overlapping
## it): the box's top with its Tangent chain (the fillet and the +X side
## it rounds onto) replaced onto the copy's top, fillet and +X side, face
## for face (the copy reaching into the box's bottom, its solid could not
## be the target): the rounded box 0.5 taller.
func overlapping_replace() -> unit!:
    let box = CadModeling.tagged(CadSolids.box(2.0, 2.0, 2.0), "box")
    let rounded = CadModeling.filleted(box, edges_where(box, func (a: Vector3, b: Vector3) -> bool: return a.x > 0.99 and b.x > 0.99 and a.y > 0.99 and b.y > 0.99), 0.3, "r")
    let copy = CadModeling.moved_body(rounded, Vector3(0.0, 0.5, 0.0), prefix = "c:")
    let quilt = [flat(copy, Vector3(0.0, 1.0, 0.0))] + of_kind(copy, 1) + [flat(copy, Vector3(1.0, 0.0, 0.0))]
    assert(quilt.length == 3)
    let expected = 8.0 - 2.0 * (0.09 - 0.09 * math.pi / 4.0) + 2.0
    solid(CadDirect.replaced_faces(rounded, flat(rounded, Vector3(0.0, 1.0, 0.0)), copy, quilt.join(";"), chain = true), expected, 1e-3, "top and fillet onto an overlapping copy's")
