## The display mesh follows the angle, not the part's size (MeshQuality,
## docs/research/KERNEL-ROBUSTNESS.md, "Meshing like Alias"). Against
## Fusion 360's own display meshes (probe 19: its Low, Normal, High and
## Very High qualities, whose largest edge angles our presets take): a
## sphere, a cylinder as tall as it is wide, a torus (tube a quarter of
## its radius) and a cube of 2 r its edges rounded r / 4, each within a
## factor of 2.5 of Fusion's triangle count at every quality. Each meshes
## to the same counts at r = 0.5, 5, 50 and 500 mm, and the rounded box
## built 10 m off or at other sizes meshes to the same topology.
from luce_cad.modeling import CadModeling
from luce_cad.model import CadModel, MeshQuality
from luce_cad.solids import CadSolids
from luce_geocore.geocore import Vector3
from checks import closed
from luce_std import math

func qualities() -> list[MeshQuality]:
    return [MeshQuality.low(), MeshQuality.medium(), MeshQuality.high(), MeshQuality.very_high()]

func triangles(model: CadModel, quality: MeshQuality) -> int!:
    let mesh = model.tessellated(quality)
    closed(mesh)
    return mesh.index_count() // 3

func shape(kind: int, r: float) -> CadModel!:
    if kind == 0: return CadSolids.sphere(r)
    if kind == 1: return CadSolids.cylinder(r, 2.0 * r)
    if kind == 2: return CadSolids.torus(2.0 * r, r * 0.5)
    let cube = CadModeling.tagged(CadSolids.box(2.0 * r, 2.0 * r, 2.0 * r), "c")
    return CadModeling.filleted(cube, "", r * 0.25, "f", 1)

pub func mesh_calibration_tests() -> unit!:
    let names = ["sphere", "cylinder", "torus", "rounded box"]
    # Fusion's triangle counts at Low, Normal, High and Very High.
    let fusion = [[360, 2808, 11448, 46224], [76, 216, 432, 864], [434, 3246, 12862, 50950], [204, 812, 2764, 9436]]
    let sizes = [0.5, 5.0, 50.0, 500.0]
    for kind in 0..<4:
        let first: list[int] = []
        for at in 0..<sizes.length:
            let model = shape(kind, sizes[at])
            var level = 0
            for quality in qualities():
                let count = triangles(model, quality)
                if at == 0:
                    first.append(count)
                    let ratio = float(count) / float(fusion[kind][level])
                    print(f"{names[kind]} quality {level}: {count} triangles, Fusion's {fusion[kind][level]}, ratio {ratio}")
                    assert(ratio > 1.0 / 2.5 and ratio < 2.5, f"{names[kind]} at quality {level}: {count} triangles against Fusion's {fusion[kind][level]}")
                else:
                    assert(count == first[level], f"{names[kind]} at r = {sizes[at]}, quality {level}: {count} triangles, {first[level]} at r = 0.5")
                level += 1
    # The rounded box built 10 m off, and at 0.05 and 500: the same topology.
    let quality = MeshQuality.medium()
    let base = shape(3, 5.0).tessellated(quality)
    for (offset, r) in [(Vector3(10000.0, -7000.0, 3000.0), 5.0), (Vector3(), 0.05), (Vector3(), 500.0), (Vector3(-5000.0, 2500.0, 8000.0), 0.127)]:
        let cube = CadModeling.moved_body(CadModeling.tagged(CadSolids.box(2.0 * r, 2.0 * r, 2.0 * r), "c"), offset)
        let mesh = CadModeling.filleted(cube, "", r * 0.25, "f", 1).tessellated(quality)
        closed(mesh)
        assert(mesh.topology_hash() == base.topology_hash(), f"built at {offset.x},{offset.y},{offset.z} with r = {r}: another topology")
    sphere_symmetry()
    print("PASS mesh calibration: sphere, cylinder, torus and rounded box within 2.5 times Fusion's counts at its four qualities, the same counts from 0.5 to 500 mm, the same topology built 10 m off and from 0.05 to 500 mm")

## A ball's two half spheres mesh alike, mirrored: at each quality as many
## triangles and the same largest distance from the ball either side of the
## equator (each half's rows meet the equator in quads, not a finer zipped
## band on one side).
func sphere_symmetry() -> unit!:
    let r = 5.0
    let ball = CadSolids.sphere(r)
    for quality in qualities():
        let mesh = ball.tessellated(quality)
        let parent = mesh.find_attribute("cad_face", 2)
        let counts = [0, 0]
        let deviations = [0.0, 0.0]
        for triangle in 0..<mesh.index_count() // 3:
            let face = int(mesh.attribute_value(parent, mesh.triangle_face(triangle), 0))
            let a = mesh.vertex(mesh.index(triangle * 3)).position
            let b = mesh.vertex(mesh.index(triangle * 3 + 1)).position
            let c = mesh.vertex(mesh.index(triangle * 3 + 2)).position
            counts[face] += 1
            deviations[face] = math.max(deviations[face], r - a.add(b).add(c).multiply_scalar(1.0 / 3.0).length())
        if counts[0] != counts[1] or math.abs(deviations[0] - deviations[1]) > 1e-9 * r:
            print(f"half spheres at {quality.angle}: {counts[0]} and {counts[1]} triangles, deviations {deviations[0]} and {deviations[1]}")
        assert(counts[0] == counts[1] and math.abs(deviations[0] - deviations[1]) <= 1e-9 * r)
