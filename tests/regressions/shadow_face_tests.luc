## Fusion's Project of a whole face and of a body, from a cast carried as
## text (sketch/shadow_faces.lucb), and its sketch Slice (CadModeling
## .sliced): a box's top face found under a point (over its bottom),
## projected as one closed loop of linked lines; the box's outline seen
## from above, the same loop once; the box sliced through its middle,
## capped, half its volume left behind the plane.
from luce_cad.sketch import CadSketch, CadProjection, CadShadows
from luce_cad.modeling import CadModeling
from luce_cad.solids import CadSolids
from luce_geocore.geocore import Vector3
from checks import manifold, volume
from luce_std import math

pub func shadow_face_tests() -> unit!:
    let box = CadModeling.tagged(CadSolids.box(4.0, 2.0, 2.0), "box")
    # The plane y = 0 seen from above: x along u, -z along v.
    let u = Vector3(1.0, 0.0, 0.0)
    let v = Vector3(0.0, 0.0, -1.0)
    let shadows = CadShadows.parse(CadShadows.text_of(CadProjection.of(box, Vector3(0.0, 0.0, 0.0), u, v)))
    assert(shadows.face_count() == 6)
    let top = shadows.face_at(0.5, 0.2, 1.0)
    let bottom = shadows.face_at(0.5, 0.2, -1.0)
    assert(top >= 0 and bottom >= 0 and top != bottom)
    let frame = CadModeling.face_frame(box, shadows.face_name(top))
    assert(frame.found and frame.u.cross(frame.v).y > 0.99)
    assert(shadows.face_at(3.0, 0.0, 1.0) < 0)
    # The face: four linked lines sharing their corners, remembered.
    let s = CadSketch.parse("")
    assert(s.project_shadow_face(shadows, top) == 4)
    assert(s.entity_count() == 8 and s.link_count() == 4 and s.projects_face(shadows.face_name(top)))
    # Again: nothing new.
    assert(s.project_shadow_face(shadows, top) == 0)
    # The outline from above: the top's four edges (the bottom's cast the
    # same shadows), one loop.
    let o = CadSketch.parse("")
    assert(o.project_shadow_outline(shadows, 1.0) == 4, f"{o.entity_count()}")
    assert(o.entity_count() == 8)
    var low = 1.0e9
    var high = -1.0e9
    for at in 0..<o.entity_count():
        if o.kind(at) == 0:
            low = math.min(low, o.x(at))
            high = math.max(high, o.x(at))
    assert(math.abs(low + 2.0) < 1e-6 and math.abs(high - 2.0) < 1e-6)
    # Sliced at y = 0.3: what is below, capped (a face named for the
    # slice), 4 x 2 x 1.3.
    let sliced = CadModeling.sliced(box, Vector3(0.0, 0.3, 0.0), Vector3(0.0, 1.0, 0.0), "slice")
    let mesh = sliced.tessellate(16)
    manifold(mesh)
    assert(math.abs(volume(mesh) - 10.4) < 1e-5, f"{volume(mesh)}")
    var capped = false
    for f in 0..<sliced.face_count():
        capped = capped or CadModeling.face_name_of(sliced, f).starts_with("slice")
    assert(capped)
    # Wholly behind: the box itself; wholly in front: refused.
    assert(CadModeling.sliced(box, Vector3(0.0, 5.0, 0.0), Vector3(0.0, 1.0, 0.0), "slice").face_count() == 6)
    var refused = false
    _ = CadModeling.sliced(box, Vector3(0.0, -5.0, 0.0), Vector3(0.0, 1.0, 0.0), "slice") catch failure:
        refused = true
        recover box
    assert(refused)
    print("PASS Project of a face and a body, and Slice: a box's top found over its bottom and projected as one linked loop, its outline once, and the box sliced and capped with half its volume behind the plane")
