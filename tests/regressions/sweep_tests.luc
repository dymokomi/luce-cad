## Cases the robustness sweep (dev/robustness) found, shrunk, kept once
## fixed: each boolean of the two bodies succeeds, every face of its result
## meshes, and the volumes add up (V(A ∪ B) + V(A ∩ B) = V(A) + V(B),
## V(A − B) = V(A) − V(A ∩ B), to a hundred-thousandth: the measure follows
## spheres to about 1e-6).
from luce_cad.modeling import CadModeling
from luce_cad.model import CadModel, MeshQuality
from luce_cad.solids import CadSolids
from luce_cad.measure import CadMeasure
from luce_cad.cad_geometry import CadGeometry
from luce_geocore.geocore import Vector3
from luce_std import math

func meshed_volume(model: CadModel) -> float!:
    let skipped = CadGeometry.skipped_faces(model.tessellated(MeshQuality.medium()))
    if skipped != "": print(skipped)
    assert(skipped == "")
    return CadMeasure.volume(model)

func volumes_add_up(name: str, a: CadModel, b: CadModel) -> unit!:
    let va = CadMeasure.volume(a)
    let vb = CadMeasure.volume(b)
    let joined = meshed_volume(CadModeling.combined(a, b, 0))
    let apart = meshed_volume(CadModeling.combined(a, b, 1))
    let common = meshed_volume(CadModeling.combined(a, b, 2))
    let within = 1e-5 * (va + vb)
    if math.abs(joined + common - va - vb) > within or math.abs(apart - (va - common)) > within:
        print(f"{name}: union {joined}, difference {apart}, intersection {common}; A {va}, B {vb}")
    assert(math.abs(joined + common - va - vb) <= within and math.abs(apart - (va - common)) <= within)

pub func sweep_tests() -> unit!:
    # A slab through a ball crossing its two half spheres: each half's
    # piece runs from its rim over its top to its rim again, a disk no
    # chart about the ball's own axis or a band takes (it was left out of
    # the mesh, and the intersection measured a quarter of its volume).
    let ball = CadSolids.sphere(2.0).transformed(Vector3(0.0, -1.0, -1.0), Vector3(-0.2792526803190927, 1.413716694115407, 2.8797932657906435), Vector3(1.0, 1.0, 1.0))
    let slab = CadSolids.box(9.0, 6.0, 2.0).transformed(Vector3(-1.0, -1.0, 0.0), Vector3(2.6878070480712677, -0.8901179185171081, 0.05235987755982989), Vector3(1.0, 1.0, 1.0))
    volumes_add_up("ball and slab", ball, slab)
    # A pipe through a box rounded G2 at a slant: the pipe's cut by a flat
    # face is a narrow ellipse, whose ends a hair off it read as far along
    # it (refused as "not on the curve"); their nearest points are.
    let one = Vector3(1.0, 1.0, 1.0)
    let pipe = CadSolids.cylinder(3.0, 6.0).transformed(Vector3(1.0, 0.0, 0.0), Vector3(-1.5533430342749532, 2.2165681500327987, -0.6981317007977318), one)
    let rounded = CadModeling.filleted(CadSolids.box(9.0, 4.0, 3.0), "", 1.0, "r", 2).transformed(Vector3(1.0, 0.0, -1.0), Vector3(-2.3387411976724017, 0.33161255787892263, -2.652900463031381), one)
    volumes_add_up("pipe through a rounded box", pipe, rounded)
    let small = CadModeling.filleted(CadSolids.box(6.6, 2.9, 3.7), "", 0.4, "r", 2).transformed(Vector3(-0.9, -0.4, 0.5), Vector3(0.5934119456780721, -0.9075712110370514, -1.1519173063162575), one)
    let wide = CadSolids.cylinder(3.0, 8.0).transformed(Vector3(-4.0, -5.0, 2.0), Vector3(1.361356816555577, -0.33161255787892263, -0.3665191429188092), one)
    volumes_add_up("rounded box and a wide pipe", small, wide)
    let q = 1.5707963267948966
    # A ball whose equator edge is tangent to a pipe the section runs on:
    # along the touch every sample found a crossing, each a vertex, and the
    # section broke into slivers with gaps (not closed); one touch is one
    # vertex now.
    volumes_add_up("ball on a pipe's flank", CadSolids.cylinder(2.0, 8.0).transformed(Vector3(), Vector3(q, 0.0, 0.0), one), CadSolids.sphere(3.0).transformed(Vector3(-1.0, 2.0, -2.0), Vector3(), one))
    # A box face through a pipe's axis: the line it cuts the pipe's cap in
    # passes the cap circle's start, middle and end, and was taken for the
    # circle itself (its crossing at the far side never cut).
    volumes_add_up("box through a pipe's axis", CadSolids.box(7.0, 9.0, 2.0).transformed(Vector3(0.0, -1.0, 1.0), Vector3(), one), CadSolids.cylinder(4.0, 9.0).transformed(Vector3(1.0, 2.0, 0.0), Vector3(), one))
    # Two balls whose meeting circle passes a half ball's seam meridian:
    # the point there was inside neither half (its winding undecided on the
    # chart's seam side), and the union dropped the second ball.
    volumes_add_up("balls across a seam", CadSolids.sphere(2.0).transformed(Vector3(-1.0, -1.0, 0.0), Vector3(0.0, q, 0.0), one), CadSolids.sphere(2.0).transformed(Vector3(-1.0, -1.0, -1.0), Vector3(), one))
    print("PASS sweep cases: tangent touches, a line through a circle's center, a point on a seam meridian; a ball cut by a slab across both its halves meshes whole, pipes cut at a slant by rounded boxes keep their ellipses, and their booleans' volumes add up")
