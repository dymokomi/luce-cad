## luce-cad's robustness harness (docs/research/KERNEL-ROBUSTNESS.md):
## determinism (repeated and concurrent runs give bit-identical models),
## invariance (operand order, face order, rigid motion and scale) with the
## booleans' volume identities, and the tolerance band around 0.01 mm.
## Determinism must hold; the invariance failures and band cells off the
## ideal are printed and must not exceed the recorded baseline, so they can
## only improve until the tolerance model lands.
from luce_geocore.geocore import invalid
from determinism import determinism
from invariance import invariance, Tally
from bands import bands, BandTally

## The baseline (docs/research/KERNEL-ROBUSTNESS.md, section 3 and 6): stage 2,
## 2026-10-14. The band cells off are all in the coaxial rows at 100 mm and
## 1 m (stage 3).
let invariance_failures_most: i64 = 5
let band_cells_off_most: i64 = 12
let band_failures_most: i64 = 12

pub func main(arguments: str[]) -> i32!:
    _ = arguments
    try determinism()
    var tally = Tally()
    try invariance(&tally)
    print(f"robustness invariance: {tally.failures} of {tally.checks} checks fail")
    var band = BandTally()
    try bands(&band)
    print(f"robustness bands: {band.rows} rows, {band.off} of {band.cells} cells off the ideal, {band.mixed} mixed, {band.failed} failed or open")
    if tally.failures > invariance_failures_most: error(invalid, "more invariance failures than the baseline")
    if band.off > band_cells_off_most: error(invalid, "more band cells off the ideal than the baseline")
    if band.failed > band_failures_most: error(invalid, "more failed band cells than the baseline")
    return 0
