## The operations the harness runs: booleans of every analytic pair the
## kernel meets in closed form or by tracing, a fillet, a shell, and a
## boolean on the fillet's B-spline strips. Each is built from scratch on
## every call, so repeated calls share nothing but code.
import interop
from luce_std import math
from luce_geocore.geocore import Vector3
from model import CadModel
from solids import CadSolids
from modeling import CadModeling

## `model` moved by `translation` and turned by `rotation`; `model` released.
func placed(model: interop.Reference[CadModel], translation: Vector3, rotation: Vector3, scale: Vector3) -> interop.Reference[CadModel]!:
    defer model.release()
    return try model.value().transformed(translation, rotation, scale)

pub let operation_count: i64 = 7

pub func operation_name(which: i64) -> str:
    if which == 0: return "box-cylinder"
    if which == 1: return "box+sphere"
    if which == 2: return "cylinder*cylinder"
    if which == 3: return "torus-box"
    if which == 4: return "filleted box"
    if which == 5: return "shelled box"
    return "filleted box-cylinder"

pub func operation(which: i64) -> interop.Reference[CadModel]!:
    if which == 0:
        let box = try CadSolids.box(20.0, 12.0, 8.0)
        defer box.release()
        let pin = try placed(try CadSolids.cylinder(2.5, 30.0), Vector3(3.0, 1.0, 0.0), Vector3(0.3, 0.0, 0.2), Vector3(1.0, 1.0, 1.0))
        defer pin.release()
        return try CadModeling.combined(box, pin, 1)
    if which == 1:
        let box = try CadSolids.box(10.0, 10.0, 10.0)
        defer box.release()
        let ball = try placed(try CadSolids.sphere(4.0), Vector3(5.0, 2.0, 1.0), Vector3(), Vector3(1.0, 1.0, 1.0))
        defer ball.release()
        return try CadModeling.combined(box, ball, 0)
    if which == 2:
        let a = try CadSolids.cylinder(3.0, 20.0)
        defer a.release()
        let b = try placed(try CadSolids.cylinder(2.0, 20.0), Vector3(0.5, 0.0, 0.0), Vector3(1.2, 0.0, 0.0), Vector3(1.0, 1.0, 1.0))
        defer b.release()
        return try CadModeling.combined(a, b, 2)
    if which == 3:
        let ring = try CadSolids.torus(6.0, 1.5)
        defer ring.release()
        let box = try placed(try CadSolids.box(8.0, 8.0, 8.0), Vector3(6.0, 0.0, 2.0), Vector3(0.0, 0.4, 0.0), Vector3(1.0, 1.0, 1.0))
        defer box.release()
        return try CadModeling.combined(ring, box, 1)
    if which == 4:
        let box = try CadSolids.box(10.0, 8.0, 6.0)
        defer box.release()
        return try CadModeling.filleted(box, "", 1.5, "f")
    if which == 5:
        let box = try CadSolids.box(10.0, 8.0, 6.0)
        defer box.release()
        return try CadModeling.shelled(box, "", 1.0, "s")
    let box = try CadSolids.box(10.0, 8.0, 6.0)
    defer box.release()
    let rounded = try CadModeling.filleted(box, "", 1.5, "f")
    defer rounded.release()
    let pin = try placed(try CadSolids.cylinder(2.0, 20.0), Vector3(4.2, 3.1, 0.0), Vector3(0.0, 0.0, 0.0), Vector3(1.0, 1.0, 1.0))
    defer pin.release()
    return try CadModeling.combined(rounded, pin, 1)
